<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Loomscreen Pro</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Loomscreen Pro Configuration</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.loomscreen.pro.config</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!-- Sparkle compares CFBundleVersion, not the marketing string. Keep them
	     identical so each X.Y.Z release is newer than the last. -->
	<key>CFBundleVersion</key>
	<string>$(MARKETING_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAccentColorName</key>
	<string>AccentColor</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Play, pause, skip and seek buttons on the Now Playing wallpaper layer use this to control the music player you are listening to.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Audio response analyzes the audio currently playing on your Mac, on-device, to make wallpapers move with the music. No audio is recorded, saved, or sent anywhere.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Access to Desktop is needed to play wallpaper files stored there.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Access to Documents is needed to play wallpaper files stored there.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Access to Downloads is needed to play wallpaper files stored there.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Location is used to fetch local weather for weather-reactive effects.</string>
	<!--
	    Sparkle auto-update. `SUEnableInstallerLauncherService` must track the
	    App Sandbox: a sandboxed app cannot install over itself, so Sparkle
	    routes the install through its Installer XPC service, which runs outside
	    the sandbox. Turning the sandbox on without this key (or vice versa)
	    leaves updates unable to install.

	    `SUPublicEDKey` is the ed25519 public half of the signing key; the
	    private half lives in the release machine's login keychain and never
	    ships. Sparkle refuses any update whose EdDSA signature does not verify
	    against this value, which is what makes update delivery trustworthy
	    without a Developer ID certificate.
	-->
	<!--
	    Answers Sparkle's first-launch "check automatically?" prompt in advance.
	    Without it Sparkle raises that dialog on the launch after its first
	    successful start — over a full-screen wallpaper, unprompted. The value
	    matches the default of the UpdateChecker this replaced (checks on), and
	    the General settings toggle writes Sparkle's own preference afterwards.
	-->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/Paradox07127/macos-wallpaperengine/main/appcast-pro.xml</string>
	<key>SUPublicEDKey</key>
	<string>V1TAiPupv91eQ9YlbHDBxPdztUhLrvG1TTJMYyArArs=</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Loomscreen Pro Configuration</string>
			<key>UTTypeIdentifier</key>
			<string>com.loomscreen.pro.config</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>lwconfig</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-loomscreen-pro-config+json</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
