# SwiftFormat — starter config (P0). Conservative first adoption.
# The god-files slated for structural refactor are EXCLUDED so cosmetic
# reformatting does not collide with the upcoming splits.
# AF-10: every Swift path in --exclude is owned and time-bounded by
# scripts/quality-baselines/exclusions.json. scripts/check_quality_exclusions.py
# enforces exact SwiftLint/SwiftFormat/manifest parity and component LoC caps.

--swiftversion 6.0

--exclude build,archived,cache,trace,tools,**/DerivedSources,**/DerivedData,Packages/**/.build,LiveWallpaper/Runtime/Metal/WPEMetalRenderExecutor.swift,LiveWallpaper/Runtime/Metal/WPEMetalRenderExecutorTypes.swift,LiveWallpaper/Runtime/Metal/WPEMetalRenderExecutor+Text.swift,LiveWallpaper/Runtime/Metal/WPEMetalRenderExecutor+Particles.swift,LiveWallpaper/Runtime/Metal/WPEMetalRenderExecutor+Present.swift,LiveWallpaper/Runtime/Metal/WPEMetalRenderExecutor+Targets.swift,LiveWallpaper/Runtime/Metal/WPEMetalRenderExecutor+Puppet.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+LivePoster.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+Load.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+Debug.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+Frame.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+Text.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+Particles.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+Scripts.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+ScriptTicks.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+ScriptFailClose.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+ScriptContainment.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+Lifecycle.swift,LiveWallpaper/Runtime/Metal/WPEMetalSceneRenderer+Textures.swift,LiveWallpaper/Runtime/Metal/WPEMetalShaderDispatcher.swift,LiveWallpaper/App/ScreenManager.swift,LiveWallpaper/App/ScreenManagerTypes.swift,LiveWallpaper/App/ScreenManager+Observers.swift,LiveWallpaper/App/ScreenManager+Screens.swift,LiveWallpaper/App/ScreenManager+Wallpaper.swift,LiveWallpaper/App/ScreenManager+Monitor.swift,LiveWallpaper/App/ScreenManager+Automation.swift,LiveWallpaper/VideoPlayback/HTMLWallpaperView.swift,LiveWallpaper/Runtime/Metal/WPEShaderTranspiler.swift,LiveWallpaper/Runtime/Metal/WPEShaderTranspiler+Preprocessor.swift,LiveWallpaper/Runtime/Metal/WPEShaderTranspiler+Main.swift,LiveWallpaper/Runtime/Metal/WPEShaderTranspiler+Substitutions.swift,LiveWallpaper/Runtime/Metal/WPEShaderTranspiler+Helpers.swift,LiveWallpaper/Runtime/Metal/WPEShaderTranspiler+Render.swift,LiveWallpaper/Runtime/Metal/WPEShaderTranspilerTypes.swift,LiveWallpaper/Runtime/Scene/WPESceneScriptBaseclasses.swift

# `WPESceneScriptBaseclasses.swift` is one Swift enum wrapping a 900-line raw
# JavaScript string. SwiftFormat re-indents the JS inside it as if it were Swift
# (measured 2026-08-31: it pushed the bodies of two JS functions out by 8 spaces),
# so the file is excluded rather than formatted.

# This codebase writes `#if !LITE_BUILD` bodies flush left: 273 of the 304 files
# that open with one do (measured 2026-08-31). SwiftFormat's default wants them
# indented, which made every line of any such file it touched look like a violation.
--ifdef no-indent

# Reduce line-reflow churn on first pass; keep safe redundancy/whitespace rules.
--disable wrapMultilineStatementBraces
