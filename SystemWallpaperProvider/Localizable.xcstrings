          "stringUnit" : {
            "state" : "translated",
            "value" : "Um recurso de cena temporário não pôde ser preparado: %@"
          }
        }
      }
    },
    "Couldn't get exclusive access to the System Wallpaper library." : {
      "comment" : "Error shown when the cross-process manifest lock cannot be taken.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't get exclusive access to the System Wallpaper library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo obtener acceso exclusivo a la biblioteca de fondos del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム壁紙ライブラリへの排他アクセスを取得できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法获得系统壁纸库的独占访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法取得系統桌布庫的獨佔存取權限。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konnte keinen exklusiven Zugriff auf die Systemhintergrundbild-Bibliothek erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’obtenir l’accès exclusif à la bibliothèque des fonds d’écran système."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 배경화면 라이브러리에 대한 독점적인 액세스를 얻을 수 없었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não consegui obter acesso exclusivo à biblioteca de Papel de Parede do Sistema."
          }
        }
      }
    },
