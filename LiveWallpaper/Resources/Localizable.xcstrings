        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅場景桌布；關閉可排查問題，變更後重新載入桌布。"
          }
        }
      }
    },
    "Scene wallpapers only. HDR scenes can render brighter than white on HDR displays. Changes reload wallpapers." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scene wallpapers only. HDR scenes can render brighter than white on HDR displays. Changes reload wallpapers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo fondos de escena. Las escenas HDR pueden verse más brillantes que el blanco en pantallas HDR. Los cambios recargan los fondos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン壁紙のみ。HDR ディスプレイでは HDR シーンが白より明るく表示されます。変更すると壁紙が再読み込みされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅场景壁纸。在 HDR 显示器上，HDR 场景可以显示得比白色更亮。更改后会重新加载壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅場景桌布。在 HDR 顯示器上，HDR 場景可以顯示得比白色更亮。變更後會重新載入桌布。"
          }
        }
      }
    },
    "Scene wallpapers only. Lets HDR scenes glow brighter than white on HDR displays; changes reload wallpapers." : {
