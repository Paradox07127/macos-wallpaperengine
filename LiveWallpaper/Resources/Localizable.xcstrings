    "Use your own Steam account. Valve determines whether it can create a Web API key. The key is optional for SteamCMD downloads." : {
      "comment" : "Reminder shown above the API-key entry field. Explains Valve's eligibility gate.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie Ihr eigenes Steam-Konto. Valve bestimmt, ob es einen Web-API-Schlüssel erstellen darf. Für SteamCMD-Downloads ist der Schlüssel optional."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your own Steam account. Valve determines whether it can create a Web API key. The key is optional for SteamCMD downloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu propia cuenta de Steam. Valve determina si puede crear una clave de API web. La clave es opcional para descargar con SteamCMD."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez votre propre compte Steam. Valve détermine s’il peut créer une clé API Web. Cette clé est facultative pour les téléchargements SteamCMD."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご自身の Steam アカウントを使用してください。Web API キーを作成できるかどうかは Valve が決定します。SteamCMD でのダウンロードにこのキーは必須ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본인의 Steam 계정을 사용하세요. 웹 API 키를 만들 수 있는지는 Valve에서 결정합니다. SteamCMD 다운로드에 이 키는 필수가 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use sua própria conta Steam. A Valve determina se ela pode criar uma chave de API Web. A chave é opcional para downloads pelo SteamCMD."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用自己的 Steam 账号。能否创建 Web API 密钥由 Valve 决定。SteamCMD 下载不强制要求此密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用自己的 Steam 帳號。能否建立 Web API 金鑰由 Valve 決定。SteamCMD 下載並非必須使用此金鑰。"
          }
        }
      }
    },
