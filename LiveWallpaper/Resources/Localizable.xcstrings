    "Control was denied. Turn it back on in System Settings → Privacy & Security → Automation." : {
      "comment" : "Music page caption when the player has refused Automation permission.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Control was denied. Turn it back on in System Settings → Privacy & Security → Automation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el control. Vuelve a activarlo en Ajustes del Sistema → Privacidad y seguridad → Automatización."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作が拒否されています。「システム設定」→「プライバシーとセキュリティ」→「オートメーション」で再度許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制已被拒绝。请在系统设置 → 隐私与安全性 → 自动化中重新开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制已被拒絕。請在「系統設定」→「隱私權與安全性」→「自動化」中重新開啟。"
          }
        }
      }
    },
    "Controls fade in when the pointer is over the layer. They need Mouse Interaction on for this display, plus a one-time permission the first time you use them." : {
      "comment" : "Music page caption explaining what the playback switches require.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controls fade in when the pointer is over the layer. They need Mouse Interaction on for this display, plus a one-time permission the first time you use them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los controles aparecen cuando el puntero está sobre la capa. Necesitan que Interacción del ratón esté activada en esta pantalla, además de un permiso único la primera vez que los uses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールはポインタをレイヤーに重ねると表示されます。この画面で「マウス操作」をオンにし、初回に一度だけ許可が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指针移到图层上时控制按钮会淡入显示。需要为此显示器打开“鼠标交互”,并在首次使用时授权一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指標移到圖層上時控制按鈕會淡入顯示。需要為此顯示器開啟「滑鼠互動」,並在首次使用時授權一次。"
          }
        }
      }
    },
    "Controls fade in when the pointer is over the layer. They only take clicks inside the layer itself — the rest of the desktop keeps working — and need a one-time permission the first time you use them." : {
      "comment" : "Music page caption explaining how the playback controls take clicks.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controls fade in when the pointer is over the layer. They only take clicks inside the layer itself — the rest of the desktop keeps working — and need a one-time permission the first time you use them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los controles aparecen cuando el puntero está sobre la capa. Solo reciben clics dentro de la propia capa — el resto del escritorio sigue funcionando — y necesitan un permiso único la primera vez que los uses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールはポインタをレイヤーに重ねると表示されます。クリックを受け取るのはレイヤーの内側だけで、デスクトップの他の部分はこれまでどおり使えます。初回のみ一度だけ許可が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指针移到图层上时控制按钮会淡入显示。只有图层自身的区域会接收点击，桌面其余部分照常使用；首次使用时需要授权一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指標移到圖層上時控制按鈕會淡入顯示。只有圖層本身的區域會接收點擊，桌面其餘部分照常使用；首次使用時需要授權一次。"
          }
        }
      }
    },
