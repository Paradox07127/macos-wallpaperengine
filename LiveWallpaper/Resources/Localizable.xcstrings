    "Used by Agent Session and Agent Activity to display session metadata. Prompt text, replies and tool arguments are excluded." : {
      "comment" : "Folder access help; names both consumers and excludes message content from displayed metadata.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used by Agent Session and Agent Activity to display session metadata. Prompt text, replies and tool arguments are excluded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesión del agente y Actividad de agentes muestran metadatos de las sesiones. Se excluyen el texto de las instrucciones, las respuestas y los argumentos de herramientas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントセッションとエージェントのアクティビティでメタデータを表示します。プロンプト本文、返信、ツール引数は含みません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供 Agent 会话和 Agent 活动台显示会话元数据，不包含提示词正文、回复或工具参数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
