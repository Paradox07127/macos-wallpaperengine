      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, hides the app from the Dock and ⌘Tab. Open it from the menu bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desactivarlo, la app se oculta del Dock y de ⌘Tab. Se abre desde la barra de menús."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
