    "Continuing opens a prefilled issue in your browser. Review it first; published issues are public." : {
      "comment" : "Bug report sheet subtitle in an edition that names no issue host.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuing opens a prefilled issue in your browser. Review it first; published issues are public."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, se abrirá en el navegador una incidencia ya rellenada. Revísala antes; las incidencias publicadas son públicas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行するとブラウザで入力済みの Issue が開きます。内容を確認してください。公開した Issue は誰でも閲覧できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续操作会在浏览器中打开预填好的议题。请先检查内容；发布后的议题公开可见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼續操作會在瀏覽器中開啟預填好的議題。請先檢查內容；發布後的議題為公開資訊。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiterführen öffnet ein vorformuliertes Problem in Ihrem Browser. Überprüfen Sie es zuerst; veröffentlichte Probleme sind öffentlich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer ouvre un problème prérempli dans votre navigateur. Veuillez le examiner d'abord ; les problèmes publiés sont publics."
