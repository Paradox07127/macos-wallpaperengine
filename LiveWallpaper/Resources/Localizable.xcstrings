        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Workshop-Ordner in Ihrer Steam-Bibliothek konnte nicht gelesen werden. Ermächtigen Sie erneut Ihren Steam-Bibliothekordner und überprüfen Sie dann Ihre Abonnements."
          }
