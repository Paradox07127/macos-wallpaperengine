          }
        }
      }
    },
    "The wallpaper, playlist, schedule, effect layer, and all other settings on %lld other displays are replaced with this display's. Their widget, music, and clock overlays are not changed." : {
      "comment" : "Destructive confirm message. Placeholder is the number of other displays.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wallpaper, playlist, schedule, effect layer, and all other settings on %lld other displays are replaced with this display's. Their widget, music, and clock overlays are not changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fondo de pantalla, la playlist, la programación, la capa de efectos y el resto de ajustes de otras %lld pantallas se sustituyen por los de esta. Sus superposiciones de widgets, música y reloj no cambian."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他の %lld 台のディスプレイの壁紙、プレイリスト、スケジュール、エフェクトレイヤー、その他すべての設定が、このディスプレイと同じ内容に置き換わります。それらのウィジェット・ミュージック・時計のオーバーレイは変わりません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另外 %lld 台显示器上的壁纸、播放列表、计划、效果层和其他所有设置，都将替换为与这台显示器相同的内容。它们的小组件、音乐和时钟叠加层保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另外 %lld 台顯示器上的桌布、播放列表、排程、效果層和其他所有設定，都將取代為與這台顯示器相同的內容。它們的小工具、音樂和時鐘疊加層維持不變。"
          }
        }
      }
    },
