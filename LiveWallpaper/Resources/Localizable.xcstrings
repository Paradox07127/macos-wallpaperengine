    "%@ changed in the meantime, so the download wasn’t applied." : {
      "comment" : "Workshop deferred apply dropped because the user applied something else there. Placeholder is a display name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cambió mientras tanto, así que la descarga no se aplicó."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その間に %@ が変更されたため、ダウンロードしたものは適用されませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 期间已更换壁纸，下载完成的壁纸未被应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 期間已更換桌布，下載完成的桌布未被套用。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat sich in der Zwischenzeit geändert, daher wurde die Download-Anwendung nicht angewendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a changé en attendant, donc le téléchargement n'a pas été appliqué."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이 그 사이에 변경되었기 때문에 다운로드가 적용되지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mudou enquanto isso, então o download não foi aplicado."
          }
        }
      }
    },
