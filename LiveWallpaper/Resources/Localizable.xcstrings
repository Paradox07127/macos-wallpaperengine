    "Downloads missing subscribed wallpapers without deleting files or changing Steam subscriptions." : {
      "comment" : "Subscription check info; additive download only.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt fehlende abonnierte Hintergründe herunter, ohne Dateien zu löschen oder Steam-Abonnements zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads missing subscribed wallpapers without deleting files or changing Steam subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga los fondos suscritos que faltan sin borrar archivos ni cambiar las suscripciones de Steam."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge les fonds suivis manquants sans supprimer de fichiers ni modifier les abonnements Steam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクライブ済みでまだダウンロードされていない壁紙を取得します。ファイルの削除や Steam のサブスクリプションの変更は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 삭제하거나 Steam 구독을 변경하지 않고 누락된 구독 배경화면을 다운로드합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa os papéis de parede inscritos que faltam, sem apagar arquivos nem alterar inscrições no Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载本机缺少的已订阅壁纸，不删除文件或更改 Steam 订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載本機缺少的已訂閱桌布，不刪除檔案或更改 Steam 訂閱。"
          }
        }
      }
    },
    "Downloads subscribed Wallpaper Engine items missing from this Mac. No files are deleted or subscriptions removed." : {
      "comment" : "Workshop subscription sync scope: downloads missing subscribed items without deleting local files or unsubscribing.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt abonnierte Wallpaper-Engine-Elemente herunter, die auf diesem Mac fehlen. Es werden weder Dateien gelöscht noch Abonnements entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads subscribed Wallpaper Engine items missing from this Mac. No files are deleted or subscriptions removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga los artículos de Wallpaper Engine a los que estás suscrito y que faltan en este Mac. No elimina archivos ni cancela suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge les éléments Wallpaper Engine auxquels vous êtes abonné et qui manquent sur ce Mac. Aucun fichier ni abonnement n’est supprimé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクライブ済みの Wallpaper Engine アイテムのうち、この Mac にないものをダウンロードします。ファイルの削除やサブスクリプションの解除は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 없는 구독 중인 Wallpaper Engine 항목을 다운로드합니다. 파일을 삭제하거나 구독을 취소하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa itens inscritos do Wallpaper Engine que faltam neste Mac. Nenhum arquivo é apagado e nenhuma inscrição é removida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载本机缺少的已订阅 Wallpaper Engine 项目，不删除文件或取消订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載這台 Mac 缺少的已訂閱 Wallpaper Engine 項目，不刪除檔案或取消訂閱。"
          }
        }
      }
    },
    "Downloads use your Steam account. Loomscreen does not store the password." : {
      "comment" : "Steam account setup help; password statement retains existing privacy boundary.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads verwenden Ihr Steam-Konto. Loomscreen speichert das Passwort nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads use your Steam account. Loomscreen does not store the password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
