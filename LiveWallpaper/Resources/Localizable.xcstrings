    "The Mac is too hot. Wallpapers pause until it cools down." : {
      "comment" : "Status capsule sentence beside the Critical Heat headline (macOS thermal pressure: critical). Loomscreen suspends every wallpaper at this level.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mac ist zu heiß. Hintergrundbilder pausieren, bis er abkühlt."
          }
        },
        "en" : {
