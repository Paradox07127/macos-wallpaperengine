    "Scripted content may not display when disabled." : {
      "comment" : "JavaScript toggle tooltip. Disabling scripts can affect scripted content; do not claim that every web wallpaper becomes blank.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripted content may not display when disabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desactivarlo, el contenido basado en scripts puede no mostrarse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、スクリプトを使うコンテンツが表示されない場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，脚本内容可能无法显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後，指令碼內容可能無法顯示。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorgegebene Inhalte werden möglicherweise nicht angezeigt, wenn sie deaktiviert sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu scripté peut ne pas s'afficher lorsqu'il est désactivé."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크립트된 콘텐츠는 비활성화되면 표시되지 않을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo scriptado pode não ser exibido quando desativado."
          }
        }
      }
    },
    "Scripts disabled. Only HTTPS, loopback, and local-network origins can run JavaScript." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts disabled. Only HTTPS, loopback, and local-network origins can run JavaScript."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts desactivados. Solo los orígenes HTTPS, loopback y de red local pueden ejecutar JavaScript."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトは無効です。JavaScript を実行できるのは HTTPS、ループバック、ローカルネットワークのオリジンのみです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚本已禁用。只有 HTTPS、回环地址和局域网地址的来源可以运行 JavaScript。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳本已停用。只有 HTTPS、回環位址和區域網路位址的來源可以執行 JavaScript。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripte deaktiviert. Nur HTTPS, Loopback und lokale Netzwerkquellen können JavaScript ausführen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts désactivés. Seuls les origines HTTPS, locales et de réseau local peuvent exécuter JavaScript."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크립트가 비활성화되었습니다. HTTPS, 루프백 및 로컬 네트워크 출처에서만 JavaScript을 실행할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts desativados. Apenas HTTPS, origem de loopback e de rede local podem rodar JavaScript."
          }
        }
      }
    },
    "Scripts disabled. This is a plain HTTP address on your local network — anyone else on the same network could alter what it sends. Trust it only if you control this machine." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts disabled. This is a plain HTTP address on your local network — anyone else on the same network could alter what it sends. Trust it only if you control this machine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts desactivados. Esta es una dirección HTTP sin cifrar de tu red local — cualquiera en la misma red podría alterar lo que envía. Confía en ella solo si controlas esta máquina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトは無効です。これはローカルネットワーク上の平文 HTTP アドレスであり、同じネットワーク上の他者が内容を改ざんできます。この機器を自分で管理している場合にのみ信頼してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚本已禁用。这是局域网上的明文 HTTP 地址，同一网络中的其他人可以篡改它发送的内容。只有在这台机器由你自己掌控时才信任它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳本已停用。這是區域網路上的明文 HTTP 位址，同一網路中的其他人可以竄改它傳送的內容。只有在這台機器由你自己掌控時才信任它。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripte deaktiviert. Dies ist eine einfache HTTP-Adresse in Ihrem lokalen Netzwerk – jeder andere im selben Netzwerk könnte ändern, was sie sendet. Vertrauen Sie ihr nur, wenn Sie diese Maschine kontrollieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts désactivés. Il s'agit d'une adresse HTTP simple sur votre réseau local — toute autre personne sur le même réseau pourrait modifier ce qu'elle envoie. Faites-lui confiance uniquement si vous contrôlez cette machine."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크립트가 비활성화되었습니다. 이는 로컬 네트워크상의 일반 HTTP 주소입니다 — 동일한 네트워크에 있는 다른 사람들은 그것이 전송하는 내용을 변경할 수 있습니다. 이 기계를 직접 제어할 수 있는 경우에만 신뢰하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts desativados. Este é um endereço HTTP simples na sua rede local — qualquer outra pessoa na mesma rede poderia alterar o que ele envia. Confie apenas se você controlar esta máquina."
          }
        }
      }
    },
    "Scripts disabled. Trust this origin to allow JavaScript execution." : {
      "comment" : "Info tooltip on the Origin Access row when the origin is HTTPS and untrusted.",
      "extractionState" : "manual",
      "localizations" : {
