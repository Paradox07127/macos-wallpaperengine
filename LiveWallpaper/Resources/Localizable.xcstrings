    "Used by Agent Session and Agent Activity to display session metadata. Prompt text, replies and tool arguments are excluded." : {
      "comment" : "Folder access help; names both consumers and excludes message content from displayed metadata.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird von Agent Session und Agent Activity verwendet, um Sitzungsmetadaten anzuzeigen. Prompt-Texte, Antworten und Werkzeugargumente werden ausgeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used by Agent Session and Agent Activity to display session metadata. Prompt text, replies and tool arguments are excluded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesión del agente y Actividad de agentes muestran metadatos de las sesiones. Se excluyen el texto de las instrucciones, las respuestas y los argumentos de herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé par Agent Session et Agent Activity pour afficher les métadonnées de la session. Le texte de la demande, les réponses et les arguments de l'outil sont exclus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントセッションとエージェントのアクティビティでメタデータを表示します。プロンプト本文、返信、ツール引数は含みません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트 세션 및 에이전트 활동에서 세션 메타데이터를 표시하는 데 사용됩니다. 프롬프트 텍스트, 응답 및 도구 인수는 제외됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado pela Sessão do Agente e pela Atividade do Agente para exibir metadados da sessão. Texto de prompt, respostas e argumentos da ferramenta são excluídos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供 Agent 会话和 Agent 活动台显示会话元数据，不包含提示词正文、回复或工具参数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供 Agent 工作階段與 Agent 活動台顯示工作階段中繼資料，不包含提示詞正文、回覆或工具參數。"
          }
        }
      }
    },
    "Used when web wallpapers and scenes are recorded as video copies." : {
