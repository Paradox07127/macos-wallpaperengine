            "value" : "Choose an item in Add Widget below. Click to add it, or drag it onto the canvas; select it to edit its appearance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un elemento en Añadir widget abajo. Haz clic o arrástralo al lienzo; selecciónalo para editar su apariencia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下部のウィジェット追加から選び、クリックまたはキャンバスへドラッグします。選択すると外観を編集できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从下方“添加小组件”选择项目，点击添加或拖入画布；选中后可编辑外观。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
