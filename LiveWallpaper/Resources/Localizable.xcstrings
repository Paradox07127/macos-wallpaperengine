      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The SteamCMD archive couldn't be unpacked."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD のアーカイブを展開できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法解开 SteamCMD 压缩包。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法解開 SteamCMD 壓縮檔。"
          }
        }
      }
    },
    "The System Wallpaper library index is damaged, so it wasn't changed." : {
      "comment" : "Error shown when the system wallpaper manifest cannot be decoded and the operation is refused.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The System Wallpaper library index is damaged, so it wasn't changed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム壁紙ライブラリの索引が壊れているため、変更されませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统壁纸库的索引已损坏，因此未做更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統桌布資料庫的索引已損毀，因此未做變更。"
          }
        }
      }
    },
    "The unpacked files didn't contain the SteamCMD program." : {
      "comment" : "Managed SteamCMD install failure: no executable in the payload.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The unpacked files didn't contain the SteamCMD program."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展開したファイルに SteamCMD の実行ファイルが含まれていませんでした。"
