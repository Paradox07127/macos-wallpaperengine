          }
        }
      }
    },
    "Translates wallpaper titles, settings, and descriptions into the app language. Requires the matching translation languages, downloaded in System Settings." : {
      "comment" : "Info for the Translate wallpaper text switch in General settings.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translates wallpaper titles, settings, and descriptions into the app language. Requires the matching translation languages, downloaded in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduce los títulos, los ajustes y las descripciones de los fondos al idioma de la app. Requiere descargar los idiomas de traducción correspondientes en Ajustes del Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙のタイトル、設定項目、説明などのテキストをアプリの言語に翻訳します。対応する翻訳言語をシステム設定でダウンロードしておく必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将壁纸标题、设置项和介绍等文字翻译为 App 语言。需要先在系统设置中下载对应的翻译语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將桌布標題、設定項目和介紹等文字翻譯為 App 語言。需要先在系統設定中下載對應的翻譯語言。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersetzt Hintergrundbildtitel, Einstellungen und Beschreibungen in die App-Sprache. Erfordert die passenden Übersetzungsdienste, die in Systemeinstellungen heruntergeladen wurden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduit les titres d'écran, les paramètres et les descriptions de l'écran d'accueil dans la langue de l'application. Nécessite les langues de traduction correspondantes, téléchargées dans Réglages Système."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월페어 제목, 설정 및 설명을 앱 언어로 번역합니다. 시스템 설정에서 다운로드된 일치하는 번역 언어가 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduz títulos de papel de parede, configurações e descrições para o idioma do aplicativo. Requer os idiomas de tradução correspondentes, baixados em Ajustes do Sistema."
          }
        }
      }
    },
