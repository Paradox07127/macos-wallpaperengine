    },
    "A video copy cannot keep web clocks, calendars or live data accurate. Disable those elements before recording." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A video copy cannot keep web clocks, calendars or live data accurate. Disable those elements before recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia de vídeo no puede mantener actualizados los relojes, calendarios o datos web en directo. Desactívalos antes de grabar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画コピーではWebの時計、カレンダー、ライブデータを正確に更新できません。録画前にそれらを無効にしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频副本无法保持网页时钟、日历或实时数据准确。请在录制前禁用这些元素。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片副本無法保持網頁時鐘、行事曆或即時資料準確。請在錄製前停用這些元素。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Videokopie kann Webuhren, Kalender oder Live-Daten nicht genau halten. Deaktivieren Sie diese Elemente vor der Aufnahme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une copie vidéo ne peut pas maintenir l'exactitude des horloges web, des calendriers ou des données en direct. Désactivez ces éléments avant l'enregistrement."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오 복사본은 웹 시계, 달력 또는 실시간 데이터를 정확하게 유지할 수 없습니다. 녹화하기 전에 이러한 요소를 비활성화하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma cópia de vídeo não pode manter os relógios da web, calendários ou dados em tempo real precisos. Desative esses elementos antes de gravar."
          }
        }
      }
    },
    "A Wallpaper Engine update is available on Steam. Your linked assets remain in use." : {
      "comment" : "Engine-assets settings status when an update is available.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
