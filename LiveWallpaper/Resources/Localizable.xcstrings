    "Our wallpaper extension checked this build of macOS and found a layout it can't drive, so it stopped handing videos to the system." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our wallpaper extension checked this build of macOS and found a layout it can't drive, so it stopped handing videos to the system."
