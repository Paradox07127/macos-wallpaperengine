    "A scheme recalls one display's wallpaper, playback settings and overlays. Choose a display on a scheme's card to apply it there. Bookmarked wallpapers are in Wallpaper Library under the Bookmarks filter." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A scheme recalls one display's wallpaper, playback settings and overlays. Choose a display on a scheme's card to apply it there. Bookmarked wallpapers are in Wallpaper Library under the Bookmarks filter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un esquema recupera el fondo, la reproducción y las superposiciones de una pantalla. Elige una pantalla en la tarjeta del esquema para aplicarlo allí. Los fondos marcados están en Biblioteca de fondos, con el filtro Marcadores."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "構成は一台のディスプレイの壁紙・再生設定・オーバーレイを呼び出します。構成のカードでディスプレイを選ぶと、そのディスプレイに適用します。ブックマークした壁紙は、壁紙ライブラリの「ブックマーク」フィルタにあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方案可恢复单台显示器的壁纸、播放设置和叠加层。在方案卡片上选择一台显示器，即可将方案应用到该显示器。已添加书签的壁纸位于壁纸库的“书签”筛选中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方案可還原單台顯示器的桌布、播放設定和疊加層。在方案卡片上選擇一台顯示器，即可將方案套用到該顯示器。已加入書籤的桌布位於桌布庫的「書籤」篩選中。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Profil stellt den Hintergrund, die Wiedergabeeinstellungen und die Überlagerungen eines Monitors wieder her. Wählen Sie auf seiner Karte einen Monitor aus, um es dort anzuwenden. Markierte Hintergründe finden Sie in der Hintergrundmediathek unter dem Filter „Lesezeichen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une configuration restaure le fond d’écran, les réglages de lecture et les calques d’un moniteur. Choisissez un moniteur sur sa carte pour l’y appliquer. Les fonds marqués se trouvent dans la bibliothèque, sous le filtre Signets."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구성은 디스플레이의 배경화면, 재생 설정 및 오버레이를 함께 복원합니다. 구성 카드에서 적용할 디스플레이를 선택하세요. 북마크한 배경화면은 배경화면 라이브러리의 북마크 필터에서 찾을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma configuração restaura o papel de parede, os ajustes de reprodução e as camadas de um monitor. Escolha um monitor no cartão para aplicá-la. Os papéis de parede marcados ficam na biblioteca, no filtro Favoritos."
          }
        }
      }
    },
    "A SteamCMD path must be absolute." : {
      "comment" : "Workshop setup error when the chosen SteamCMD path is relative.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A SteamCMD path must be absolute."
