    "Steam answered, but the Wallpaper Engine build number couldn't be read from its reply." : {
      "comment" : "Engine-assets update check failure cause when SteamCMD ran but its reply had no readable build number.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
