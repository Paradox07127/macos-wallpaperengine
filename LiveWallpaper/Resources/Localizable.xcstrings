        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網頁渲染處理程序反覆當機。"
          }
        }
      }
    },
    "The web wallpaper at %@ failed to load (error %lld): %@" : {
