          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht verknüpft. Szenen werden gerendert, aber Schichten, die die geteilten Assets von Wallpaper Engine benötigen, werden übersprungen."
