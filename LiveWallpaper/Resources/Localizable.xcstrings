          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 경로는 절대적이어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um caminho SteamCMD deve ser absoluto."
          }
        }
      }
    },
    "A temporary scene resource could not be prepared: %@" : {
      "extractionState" : "manual",
      "localizations" : {
