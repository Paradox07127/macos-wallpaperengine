    "Original wallpaper files must be available. Selected files and folders need access granted again on this Mac." : {
      "comment" : "Settings explanation; preserve scope and consequences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Originaldateien der Hintergründe müssen verfügbar sein. Erlauben Sie auf diesem Mac erneut den Zugriff auf die ausgewählten Dateien und Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original wallpaper files must be available. Selected files and folders need access granted again on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos originales deben estar disponibles. Es necesario volver a autorizar el acceso a los archivos y carpetas en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers d'arrière-plan d'origine doivent être disponibles. Les fichiers et dossiers sélectionnés doivent recevoir à nouveau l'autorisation d'accès sur ce Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の壁紙ファイルが必要です。選択したファイルとフォルダへのアクセスをこの Mac で再度許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 배경화면 파일이 제공되어야 합니다. 선택된 파일과 폴더는 이 Mac에서 다시 접근 권한을 부여받아야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos de papel de parede originais devem estar disponíveis. Os arquivos e pastas selecionados precisam de acesso concedido novamente neste Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原壁纸文件须可用；所选文件和文件夹需在本机重新授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始桌布檔案必須可用；所選檔案和資料夾需在這台 Mac 上重新授權。"
          }
        }
      }
    },
