    "Reduces scene resolution; may use more power on light scenes. Changes reload wallpapers." : {
      "comment" : "Settings explanation; preserve scope and consequences.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduces scene resolution; may use more power on light scenes. Changes reload wallpapers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce la resolución de las escenas; puede usar más energía en escenas ligeras. Los cambios recargan los fondos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンの描画解像度を下げます。軽いシーンでは消費電力が増える場合があります。変更すると壁紙を再読み込みします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低场景渲染分辨率；轻量场景可能更耗电，更改后重新加载壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低場景渲染解析度；輕量場景可能更耗電，變更後重新載入桌布。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduziert die Auflösung der Szene; kann bei hellen Szenen mehr Leistung verbrauchen. Ändert das Laden von Hintergründen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduit la résolution de la scène ; peut consommer plus d'énergie sur les scènes lumineuses. Modifie la rechargement des fonds d'écran."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면 해상도를 감소시킵니다; 밝은 장면에서는 더 많은 전력을 사용할 수 있습니다. 배경화면을 다시 로드하는 방식이 변경됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduz a resolução da cena; pode usar mais energia em cenas com pouca luz. Altera a recarga dos papéis de parede."
          }
        }
      }
    },
