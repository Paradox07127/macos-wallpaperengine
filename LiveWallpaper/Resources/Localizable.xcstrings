    "The board floats over whatever wallpaper this display is playing" : {
      "comment" : "Description for the per-display Monitor overlay toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このディスプレイで再生中の壁紙の上にボードが浮かびます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
