          }
        }
      }
    },
    "This lets you click elements inside the scene, but while it's on you can't click desktop icons or right-click the desktop on this display. Turn it off here to restore desktop clicks." : {
      "comment" : "A message that appears when the user enables",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン内の要素をクリックできるようになりますが、オンの間はこのディスプレイでデスクトップアイコンをクリックしたり、デスクトップを右クリックしたりできません。デスクトップクリックを戻すにはここでオフにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这允许你点击场景内元素，但开启时无法点击此显示器上的桌面图标，也无法右键点击桌面。在这里关闭即可恢复桌面点击。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這允許你點按場景內元素，但開啟時無法點按此顯示器上的桌面圖示，也無法右鍵點按桌面。在這裡關閉即可恢復桌面點按。"
          }
        }
      }
    },
    "This replaces the wallpaper on %@ other displays with the same content and settings as this one." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This replaces the wallpaper on %@ other displays with the same content and settings as this one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他の %@ 台のディスプレイの壁紙を、このディスプレイと同じ内容と設定に置き換えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将用与此显示器相同的内容与设置，替换另外 %@ 台显示器上的壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將用與此顯示器相同的內容與設定，取代另外 %@ 台顯示器上的桌布。"
          }
        }
      }
    },
    "This replaces the wallpaper on %lld other displays with the same content and settings as this one." : {
