      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachés de páginas y recursos de WebKit. Se conservan las cookies y los datos locales de los sitios."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit のページとリソースのキャッシュ。Cookie とサイトのローカルデータは保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit 网页与资源缓存；清理时保留 Cookie 和网站本地数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit 網頁與資源快取；清理時保留 Cookie 和網站本機資料。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit Seiten- und Ressourcencache. Das Löschen behält Cookies und lokale Daten der Website bei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit pages et caches de ressources. Le nettoyage conserve les cookies et les données locales du site web."
