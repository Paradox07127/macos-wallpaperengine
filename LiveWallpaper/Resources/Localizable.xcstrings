        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina %@ de archivos de vídeo extraídos de las escenas. Las escenas volverán a extraer las texturas de vídeo la próxima vez que se rendericen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
