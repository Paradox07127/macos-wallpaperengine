    "Automatically picks a random wallpaper from your entire library. New imports join automatically; unavailable wallpapers are skipped. The same wallpaper never plays twice in a row." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically picks a random wallpaper from your entire library. New imports join automatically; unavailable wallpapers are skipped. The same wallpaper never plays twice in a row."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un fondo al azar de toda la biblioteca a intervalos regulares. Los nuevos fondos se incluyen automáticamente y se omiten los no disponibles. El mismo fondo nunca se reproduce dos veces seguidas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定した間隔でライブラリ全体から壁紙をランダムに選びます。新しく読み込んだ壁紙は自動的に対象となり、利用できない壁紙はスキップされます。同じ壁紙は連続して再生されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按设定间隔从整个壁纸库随机选择壁纸。新导入的壁纸会自动加入，无法使用的壁纸会跳过，不会连续播放同一张壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按設定間隔從整個桌布庫隨機選擇桌布。新匯入的桌布會自動加入，無法使用的桌布會跳過，不會連續播放同一張桌布。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt automatisch einen zufälligen Hintergrundbild aus Ihrer gesamten Bibliothek aus. Neue Importe werden automatisch hinzugefügt; nicht verfügbare Hintergrundbilder werden übersprungen. Das gleiche Hintergrundbild wird nie zweimal hintereinander abgespielt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sélectionne automatiquement un fond d'écran aléatoire dans toute votre bibliothèque. Les nouveaux importations sont ajoutées automatiquement ; les fonds d'écran indisponibles sont ignorés. Le même fond d'écran ne se joue jamais deux fois de suite."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 라이브러리에서 무작위 배경화면을 자동으로 선택합니다. 새로운 가져오기 이미지가 자동으로 추가되며, 사용할 수 없는 배경화면은 건너뜁니다. 동일한 배경화면은 한 번에 두 번 재생되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe automaticamente um papel de parede aleatória de toda a sua biblioteca. Novas importações são adicionadas automaticamente; os papéis de parede indisponíveis são ignoradas. A mesma papel de parede nunca é reproduzida duas vezes seguidas."
          }
        }
      }
    },
    "Automatically recover stalled connections" : {
