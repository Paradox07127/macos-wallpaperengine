        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些副本由 macOS 自己播放，所以每个视频都需要一份独立文件。要释放空间，在「库 › 系统壁纸」里移除对应视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些副本由 macOS 自行播放，因此每部影片都需要獨立檔案。要釋放空間，請在「資料庫 › 系統桌布」中移除對應影片。"
          }
        }
      }
