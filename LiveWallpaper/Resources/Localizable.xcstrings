    "Restarting briefly redraws all system wallpapers for your account. Repair removes the reviewed registrations, keeps this app, and preserves app files and videos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restarting briefly redraws all system wallpapers for your account. Repair removes the reviewed registrations, keeps this app, and preserves app files and videos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al reiniciar se redibujan brevemente todos los fondos de tu cuenta. La reparación elimina los registros revisados, conserva esta app y mantiene los archivos y vídeos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再起動時、このアカウントのすべてのシステム壁紙が一時的に再描画されます。修復では確認した登録を解除し、このアプリを保持します。アプリとビデオのファイルは削除しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重启会使当前账户的所有系统壁纸短暂重绘。修复会移除已确认的注册记录并保留当前应用，应用文件和视频不会删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新啟動會使目前帳號的所有系統桌布短暫重繪。修復會移除已確認的註冊記錄並保留目前應用程式，不會刪除應用程式檔案和影片。"
          }
        }
      }
    },
