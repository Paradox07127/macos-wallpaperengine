            "value" : "依次播放，循环重复"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依序播放，循環重複"
          }
        }
      }
    },
    "Plays in order, then stops" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt der Reihe nach, dann Stopp"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
