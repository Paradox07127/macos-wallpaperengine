    "Cookies, local storage and databases for persistent web wallpapers. Kept when clearing caches." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies, almacenamiento local y bases de datos de fondos web persistentes. Se conservan al limpiar cachés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永続ウェブ壁紙の Cookie、ローカルストレージ、データベース。キャッシュ消去時も保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持久网页壁纸的 Cookie、本地储存与数据存储；清理缓存时保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持續性網頁桌布的 Cookie、本機儲存與資料儲存；清理快取時保留。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies, lokaler Speicher und Datenbanken für dauerhafte Webhintergründe. Aufbewahrt, wenn der Cache geleert wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies, stockage local et bases de données pour des fonds d'écran web persistants. Conservés lors du nettoyage des caches."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지속적인 웹 배경화면을 위한 쿠키, 로컬 저장소 및 데이터베이스. 캐시를 지울 때 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies, armazenamento local e bancos de dados para wallpapers da web persistentes. Mantidos quando a limpeza de caches é feita."
          }
        }
      }
    },
    "Cookies, website data and cache are not saved between sessions." : {
