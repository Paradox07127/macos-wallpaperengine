    "Use the bookmark button on a display to save its wallpaper. Applying one swaps the wallpaper and leaves that display's settings alone." : {
      "comment" : "Bookmarks empty state: names the source control and states that a bookmark carries content only, unlike a scheme.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the bookmark button on a display to save its wallpaper. Applying one swaps the wallpaper and leaves that display's settings alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el botón de marcadores de una pantalla para guardar su fondo. Al aplicarlo solo cambia el fondo; los ajustes de esa pantalla no se tocan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイのブックマークボタンで壁紙を保存します。適用すると壁紙だけが入れ替わり、そのディスプレイの設定はそのままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用显示器上的书签按钮保存其壁纸。套用书签只更换壁纸，不改动该显示器的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用顯示器上的書籤按鈕儲存其桌布。套用書籤只更換桌布，不會改動該顯示器的設定。"
          }
        }
      }
    },
