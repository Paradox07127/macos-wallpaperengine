    "This allows the wallpaper to run scripts, use local storage, and access WebGPU. Only trust origins you recognize." : {
      "comment" : "Body text of the Trust confirmation dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This allows the wallpaper to run scripts, use local storage, and access WebGPU. Only trust origins you recognize."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙がスクリプトの実行、ローカルストレージの使用、WebGPU へのアクセスを行えるようになります。信頼できるオリジンのみを許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将允许壁纸运行脚本、使用本地存储和访问 WebGPU。仅信任你信赖的来源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將允許桌布執行腳本、使用本機儲存空間並存取 WebGPU。只信任你信賴的來源。"
          }
        }
      }
    },
    "This configuration is for a different app (%@). Expected %@." : {
      "comment" : "Import failure: bundle identifier doesn't match.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This configuration is for a different app (%1$@). Expected %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この構成は別のアプリ（%1$@）用です。想定：%2$@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配置适用于其他应用（%1$@）。预期为 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此設定適用於其他 App（%1$@）。預期為 %2$@。"
          }
        }
      }
    },
    "This configuration was made with a different version (schema %lld). This build supports schema 1 through %lld." : {
      "comment" : "Import failure: schema is outside the supported range.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This configuration was made with a different version (schema %1$lld). This build supports schema 1 through %2$lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この構成は別のバージョン（スキーマ %1$lld）で作成されています。このビルドはスキーマ 1 から %2$lld まで対応しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配置由其他版本创建（架构 %1$lld）。此版本支持架构 1 到 %2$lld。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此設定是以不同版本建立的（結構描述 %1$lld）。此版本支援結構描述 1 到 %2$lld。"
          }
        }
      }
    },
    "This creator hasn't published any wallpapers here." : {
      "comment" : "Empty creator-scoped Workshop browse, name unknown.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この作成者はここで壁紙をまだ公開していません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此创作者尚未在这里发布任何壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此創作者尚未在這裡發布任何桌布。"
          }
        }
      }
    },
    "This deletes the downloaded assets from this Mac. You can download them again anytime." : {
      "comment" : "Remove-engine-assets confirmation message.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac からダウンロード済みのアセットを削除します。いつでも再ダウンロードできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从该 Mac 删除已下载的资源。你随时可以重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會從此 Mac 刪除已下載的資源。你隨時可以重新下載。"
          }
        }
      }
    },
    "This file is too large to import (%lld bytes). Configuration backups are usually well under 10 MB." : {
      "comment" : "Import failure: the file exceeds the size cap and is likely not a real config bundle.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file is too large to import (%lld bytes). Configuration backups are usually well under 10 MB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは大きすぎてインポートできません（%lld バイト）。構成バックアップは通常 10 MB を大きく下回ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件太大，无法导入（%lld 字节）。配置备份通常远小于 10 MB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案太大，無法匯入（%lld 位元組）。設定備份通常遠小於 10 MB。"
          }
        }
      }
    },
    "This format requires Metal-backed GPU decoding that this Mac doesn't support. Try rendering on a newer GPU." : {
      "comment" : "Wallpaper Engine fallback warning body.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This format requires Metal-backed GPU decoding that this Mac doesn't support. Try rendering on a newer GPU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この形式には Metal ベースの GPU デコードが必要ですが、この Mac では対応していません。より新しい GPU でレンダリングしてみてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此格式需要此 Mac 不支持的 Metal GPU 解码。请尝试在较新的 GPU 上渲染。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此格式需要 Metal 支援的 GPU 解碼，但這台 Mac 不支援。請嘗試在較新的 GPU 上渲染。"
          }
        }
      }
    },
    "This is a Windows-only wallpaper and can't run on macOS." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは Windows 専用の壁紙で、macOS では実行できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是仅限 Windows 的壁纸，无法在 macOS 上运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是僅限 Windows 的桌布，無法在 macOS 上執行。"
          }
        }
      }
    },
    "This is not an unlock-restore option. When the screen locks, enabled video displays capture their current frame and set it as the macOS desktop picture. The desktop picture remains changed after unlock." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not an unlock-restore option. When the screen locks, enabled video displays capture their current frame and set it as the macOS desktop picture. The desktop picture remains changed after unlock."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはロック解除後の復元機能ではありません。画面をロックすると、有効にしたビデオディスプレイの現在のフレームをキャプチャし、macOS のデスクトップピクチャに設定します。ロック解除後もデスクトップピクチャは変更されたままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这不是解锁后恢复功能。屏幕锁定时，已启用的视频显示器会捕获当前画面并设为 macOS 桌面图片；解锁后桌面图片仍会保持此更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這不是解鎖後復原功能。螢幕鎖定時，已啟用的影片顯示器會擷取目前影格並設為 macOS 桌面圖片；解鎖後桌面圖片仍會保留此變更。"
          }
        }
      }
    },
    "This is the only wallpaper in the playlist. Removing it will clear the wallpaper on %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the only wallpaper in the playlist. Removing it will clear the wallpaper on %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリスト内の唯一の壁紙です。削除すると %@ の壁紙がクリアされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是播放列表中唯一的壁纸。移除后将清除 %@ 上的壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是播放列表中唯一的桌布。移除後將清除 %@ 上的桌布。"
