    "The Workshop folder in your Steam library could not be read. Authorize your Steam library folder again, then check your subscriptions." : {
      "comment" : "Subscription sync error when the Workshop content folder exists but cannot be read.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer la carpeta de Workshop de tu biblioteca de Steam. Vuelve a autorizar la carpeta de tu biblioteca de Steam y comprueba de nuevo tus suscripciones."
          }
        },
        "ja" : {
          "stringUnit" : {
