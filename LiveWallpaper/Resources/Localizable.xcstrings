    "Renders scenes at a lower resolution; may blur text or increase power use. Changes reload wallpapers." : {
      "comment" : "MetalFX info: lower render resolution tradeoff and reload on change.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
