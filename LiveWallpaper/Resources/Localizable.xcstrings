    "Steam didn't confirm the sign-in in time. If Steam Guard asked on your phone, approve it and try again." : {
      "comment" : "In-app Steam sign-in failure.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam didn't confirm the sign-in in time. If Steam Guard asked on your phone, approve it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam no ha confirmado el inicio de sesión a tiempo. Si Steam Guard lo ha pedido en el teléfono, apruébalo e inténtalo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam が時間内にサインインを確認しませんでした。携帯電話に Steam Guard の確認が来ていたら、承認してからもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 未在限时内确认登录。如手机上有 Steam Guard 确认请求，请先通过再重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 未在限時內確認登入。如手機上有 Steam Guard 確認請求，請先核准再重試。"
          }
        }
      }
    },
    "Steam doesn't expose remaining quota; this counts only the requests this Mac has issued today." : {
      "comment" : "A tooltip for the seal that indicates the Steam Workshop API key status.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam no publica la cuota restante; aquí solo se cuentan las solicitudes que ha enviado este Mac hoy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam は残りクォータを公開していません。ここではこの Mac が今日発行したリクエストのみを数えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
