    "Use the account name, not your profile nickname, for the account that owns Wallpaper Engine. This sign-in is separate from the Steam app. Complete Steam Guard when prompted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie den Kontonamen des Kontos, das Wallpaper Engine besitzt, und nicht dessen Profilnamen. Diese Anmeldung ist von der Steam-App getrennt. Bestätigen Sie Steam Guard, wenn Sie dazu aufgefordert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the account name, not your profile nickname, for the account that owns Wallpaper Engine. This sign-in is separate from the Steam app. Complete Steam Guard when prompted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el nombre de la cuenta que posee Wallpaper Engine, no el apodo del perfil. Este inicio de sesión es independiente de la app de Steam. Completa Steam Guard cuando se solicite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le nom du compte, et non votre surnom de profil, pour le compte qui possède Wallpaper Engine. Cette connexion est distincte de l'application Steam. Complétez Steam Guard lorsqu'on vous le demande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine を所有するアカウントのアカウント名を使ってください。プロフィールのニックネームではありません。このログインは Steam アプリとは別です。求められたら Steam Guard を完了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine을 소유한 계정의 프로필 별명이 아닌 계정 이름을 사용하세요. 이 로그인은 Steam 앱과 별개입니다. 메시지가 표시되면 Steam Guard 인증을 완료하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o nome da conta, não o apelido do seu perfil, para a conta que possui Wallpaper Engine. Este login é separado do aplicativo Steam. Conclua Steam Guard quando solicitado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入拥有 Wallpaper Engine 的账号名称，而非个人资料昵称。这里的登录独立于 Steam 应用；出现提示时请完成 Steam Guard 验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入擁有 Wallpaper Engine 的帳號名稱，而非個人檔案暱稱。此處登入獨立於 Steam 應用程式；出現提示時請完成 Steam Guard 驗證。"
          }
        }
      }
    },
