    "Steam answered, but the Wallpaper Engine build number couldn't be read from its reply." : {
      "comment" : "Engine-assets update check failure cause when SteamCMD ran but its reply had no readable build number.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam antwortete, aber die Wallpaper Engine Build-Nummer konnte aus seiner Antwort nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam respondió, pero no se pudo leer el número de compilación de Wallpaper Engine en su respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam a répondu, mais le numéro de construction Wallpaper Engine ne pouvait pas être lu dans sa réponse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam は応答しましたが、その返答から Wallpaper Engine のビルド番号を読み取れませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam이 응답했지만 응답에서 Wallpaper Engine 빌드 번호를 읽지 못했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam respondeu, mas o número de compilação Wallpaper Engine não pôde ser lido em sua resposta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已响应，但无法从回复中读取 Wallpaper Engine 的构建编号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已回應，但無法從回覆中讀取 Wallpaper Engine 的組建編號。"
          }
        }
      }
    },
