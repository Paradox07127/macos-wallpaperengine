    "Not linked. Scenes render, but layers that need Wallpaper Engine's shared assets are skipped." : {
      "comment" : "Scene resources diagnostic when no Wallpaper Engine install is linked.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No vinculado. Las escenas se renderizan, pero se omiten las capas que necesitan los recursos compartidos de Wallpaper Engine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未リンクです。シーンは描画されますが、Wallpaper Engine の共有アセットを使うレイヤーはスキップされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未关联。场景照常渲染，但用到 Wallpaper Engine 共享资源的图层会被跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
