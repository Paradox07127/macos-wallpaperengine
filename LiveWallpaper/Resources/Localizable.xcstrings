    "Continuing opens a prefilled issue in your browser. Review it first; published issues are public." : {
      "comment" : "Bug report sheet subtitle in an edition that names no issue host.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortfahren öffnet eine vorausgefüllte Fehlermeldung im Browser. Prüfen Sie sie zuerst; veröffentlichte GitHub-Issues sind öffentlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuing opens a prefilled issue in your browser. Review it first; published issues are public."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, se abrirá en el navegador una incidencia ya rellenada. Revísala antes; las incidencias publicadas son públicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer ouvre une issue préremplie dans votre navigateur. Relisez-la d’abord ; les issues publiées sont publiques."
