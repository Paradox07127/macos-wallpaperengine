          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional"
          }
        },
        "zh-Hans" : {
