    "Your downloaded Workshop wallpapers, measured where Steam actually keeps them. Deleting a wallpaper from the Installed tab frees exactly this space." : {
      "comment" : "Storage tile info popover for the wallpapers total.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your downloaded Workshop wallpapers, measured where Steam actually keeps them. Deleting a wallpaper from the Installed tab frees exactly this space."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みの Workshop 壁紙を、Steam が実際に保管している場所で計測しています。「インストール済み」タブから壁紙を削除すると、ちょうどこの容量が解放されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你下载的创意工坊壁纸，按 Steam 实际保存它们的位置计量。从「已安装」标签页删除壁纸释放的正是这部分空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你下載的創意工坊桌布，按 Steam 實際保存它們的位置計量。從「已安裝」標籤頁刪除桌布釋放的正是這部分空間。"
          }
        }
      }
    },
    "Your own free key — required to browse the Workshop online" : {
      "localizations" : {
        "ja" : {
