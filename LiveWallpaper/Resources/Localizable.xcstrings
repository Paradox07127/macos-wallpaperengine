    "Uses about half the scene frame rate when windows cover half the display or the Mac is on battery." : {
      "comment" : "Adaptive frame rate info; applies only to scene wallpapers.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halbiert etwa die Bildrate von Szenen, wenn Fenster die Hälfte des Monitors verdecken oder der Mac im Batteriebetrieb läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses about half the scene frame rate when windows cover half the display or the Mac is on battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce aproximadamente a la mitad la tasa de fotogramas de las escenas cuando las ventanas cubren media pantalla o el Mac usa la batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduit environ de moitié la fréquence d’images des scènes lorsque des fenêtres couvrent la moitié du moniteur ou que le Mac fonctionne sur batterie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウがディスプレイの半分を覆う場合やバッテリー使用時に、シーンのフレームレートを約半分にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창이 디스플레이의 절반을 덮거나 Mac이 배터리 상태일 때 장면 프레임 속도의 약 절반을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa cerca de metade da taxa de quadros da cena quando as janelas cobrem metade da tela ou o Mac está com bateria."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口覆盖显示器一半或 Mac 使用电池时，场景帧率降至约一半。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視窗覆蓋顯示器一半或 Mac 使用電池時，場景影格率降至約一半。"
          }
        }
      }
    },
