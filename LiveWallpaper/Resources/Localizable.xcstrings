    "Your password goes only to Valve's SteamCMD on this Mac and is never stored." : {
      "comment" : "Sign-in privacy note.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your password goes only to Valve's SteamCMD on this Mac and is never stored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña va solo al SteamCMD de Valve en este Mac y nunca se almacena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードはこの Mac 上の Valve 製 SteamCMD にのみ渡され、保存されることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码只会交给本机上 Valve 的 SteamCMD，绝不存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼只會交給這台 Mac 上 Valve 的 SteamCMD，絕不儲存。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Passwort gilt nur für Valves SteamCMD auf diesem Mac und wird niemals gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe est uniquement destiné à SteamCMD de Valve sur ce Mac et n'est jamais stocké."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 비밀번호는 이 Mac에서 Valve의 SteamCMD으로만 전송되며 절대 저장되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha vai apenas para o SteamCMD da Valve neste Mac e nunca é armazenada."
          }
        }
      }
    },
