    "Advanced provides diagnostics and reset. Review each confirmation before resetting settings or deleting content." : {
      "comment" : "Welcome Tour settings walkthrough or completion.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced provides diagnostics and reset. Review each confirmation before resetting settings or deleting content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanzado ofrece diagnósticos y restablecimiento. Revisa cada confirmación antes de restablecer ajustes o eliminar contenido."
          }
        },
        "ja" : {
          "stringUnit" : {
