    "The Workshop folder in your Steam library could not be read. Authorize your Steam library folder again, then check your subscriptions." : {
      "comment" : "Subscription sync error when the Workshop content folder exists but cannot be read.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Workshop-Ordner in Ihrer Steam-Bibliothek konnte nicht gelesen werden. Erlauben Sie den Zugriff auf den Bibliotheksordner erneut und prüfen Sie dann Ihre Abonnements."
          }
        },
        "es" : {
          "stringUnit" : {
