    "Download the translation languages for Chinese and %@ to show Chinese wallpaper names, settings, and descriptions in %@." : {
      "comment" : "Translate wallpaper text row. Both placeholders are the app language name, such as English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden Sie die Übersetzungssprachen für Chinesisch und %1$@ herunter, um chinesische Hintergrundbildnamen, Einstellungen und Beschreibungen in %2$@ anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de descargar los idiomas de traducción chino y %@, los nombres, los ajustes y las descripciones en chino de los fondos se mostrarán en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez les langues de traduction pour le chinois et %1$@ afin d'afficher les noms, réglages et descriptions des fonds d'écran chinois dans %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中国語と%@の翻訳言語をダウンロードすると、中国語の壁紙名、設定項目、説明が%@で表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중국어와 %1$@용 번역 언어를 다운로드하여 %2$@에서 중국어 배경화면 이름, 설정 및 설명을 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe os idiomas de tradução para chinês e %1$@ para mostrar nomes de papel de parede chinês, ajustes e descrições em %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载中文和%@的翻译语言后，中文的壁纸名称、设置项和描述将显示为%@。"
          }
        },
        "zh-Hant" : {
