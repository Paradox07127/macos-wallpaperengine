          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS würde Ihren gespeicherten API-Schlüssel nicht freischalten – erlauben Sie den Zugriff, wenn er gefragt wird, oder legen Sie den Schlüssel erneut in den Einstellungen fest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
