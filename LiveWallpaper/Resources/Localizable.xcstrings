    "Workshop requests go straight to Valve over HTTPS. Nothing is sent to Loomscreen, and Loomscreen runs no server of its own." : {
      "comment" : "Workshop privacy statement about where requests go.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las solicitudes de Workshop van directas a Valve por HTTPS. No se envía nada a Loomscreen, y Loomscreen no ejecuta ningún servidor propio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workshop へのリクエストは HTTPS で Valve に直接送られます。Loomscreen には何も送信されず、Loomscreen 自身のサーバーは存在しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workshop 请求通过 HTTPS 直接发给 Valve。没有任何内容发往 Loomscreen，Loomscreen 也不运行自己的服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workshop 請求透過 HTTPS 直接發給 Valve。沒有任何內容發往 Loomscreen，Loomscreen 也不執行自己的伺服器。"
          }
        }
      }
    },
