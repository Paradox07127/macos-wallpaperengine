    "Scene wallpapers only: reduces frame rate when covered or on battery." : {
      "comment" : "Settings explanation; preserve scope and consequences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Szenenhintergründe: reduziert die Bildrate bei verdecktem Schreibtisch oder im Batteriebetrieb."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scene wallpapers only: reduces frame rate when covered or on battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo fondos de escena: reduce los fotogramas al quedar cubiertos o al usar la batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonds de scène uniquement : réduit la fréquence d’images quand le bureau est masqué ou sur batterie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン壁紙のみ：ウィンドウに覆われたときやバッテリー使用時にフレームレートを下げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면 배경화면 전용: 데스크탑이 가려지거나 배터리 사용 시 프레임 속도를 낮춥니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas wallpapers de cena: reduz a taxa de quadros quando coberto ou com bateria."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅场景壁纸：窗口遮挡或使用电池时降低帧率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅場景桌布：視窗遮擋或使用電池時降低影格率。"
          }
        }
      }
    },
    "Scene wallpapers only. Disable for troubleshooting; changes reload wallpapers." : {
      "comment" : "Settings explanation; preserve scope and consequences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Hintergrundbilder für Szenen. Deaktivieren Sie dies zur Fehlerbehebung; Änderungen laden Hintergrundbilder neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scene wallpapers only. Disable for troubleshooting; changes reload wallpapers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo fondos de escena. Desactívalo para diagnosticar problemas; los cambios recargan los fondos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement les fonds d'écran de scène. Désactivez-le pour le dépannage ; les modifications rechargent les fonds d'écran"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン壁紙のみ。問題の調査時に無効にします。変更すると壁紙を再読み込みします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면 배경화면만 사용합니다. 문제 해결을 위해 비활성화하세요; 변경하면 배경화면이 다시 로드됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas papéis de parede de cena. Desative para solucionar problemas; as alterações recarregam os papéis de parede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅场景壁纸；关闭用于排查问题，更改后重新加载壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅場景桌布；關閉可排查問題，變更後重新載入桌布。"
          }
        }
      }
    },
    "Scene wallpapers only. HDR scenes can render brighter than white on HDR displays. Changes reload wallpapers." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Szenenhintergründe. HDR Szenen können auf HDR Bildschirmen heller als weiß aussehen. Änderungen laden Hintergründe neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scene wallpapers only. HDR scenes can render brighter than white on HDR displays. Changes reload wallpapers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo fondos de escena. Las escenas HDR pueden verse más brillantes que el blanco en pantallas HDR. Los cambios recargan los fondos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonds de scène uniquement. Sur un écran HDR, les scènes HDR peuvent dépasser la luminosité du blanc. Les modifications rechargent les fonds."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン壁紙のみ。HDR ディスプレイでは HDR シーンが白より明るく表示されます。変更すると壁紙が再読み込みされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면 배경화면 전용입니다. HDR 디스플레이에서 HDR 장면은 흰색보다 더 밝게 렌더링될 수 있습니다. 변경하면 배경화면을 다시 불러옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente para papéis de parede de cena. Cenas HDR podem ultrapassar o brilho do branco em monitores HDR. As alterações recarregam os papéis de parede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅场景壁纸。在 HDR 显示器上，HDR 场景可以显示得比白色更亮。更改后会重新加载壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅場景桌布。在 HDR 顯示器上，HDR 場景可以顯示得比白色更亮。變更後會重新載入桌布。"
          }
        }
      }
    },
    "Scene wallpapers only. Lets HDR scenes glow brighter than white on HDR displays; changes reload wallpapers." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Hintergrundbilder für Szenen. Lassen Sie HDR Szenen auf HDR Bildschirmen heller leuchten als weiß; Änderungen laden die Hintergrundbilder neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scene wallpapers only. Lets HDR scenes glow brighter than white on HDR displays; changes reload wallpapers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo fondos de escena. Permite que las escenas HDR brillen más que el blanco en pantallas HDR; los cambios recargan los fondos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement des fonds d'écran de scène. Faites briller les scènes HDR plus lumineux que le blanc sur les écrans HDR ; les modifications rechargent les fonds d'écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン壁紙のみ。HDR ディスプレイで HDR シーンが白より明るく輝くようになります。変更すると壁紙が再読み込みされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면 배경화면만 사용합니다. HDR 장면을 HDR 디스플레이에서 흰색보다 더 밝게 빛나게 합니다; 배경화면을 다시 로드합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas papéis de parede de cenas. Deixe as cenas HDR brilharem mais do que o branco nas telas HDR; as alterações recarregam os papéis de parede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅场景壁纸。让 HDR 场景在 HDR 显示器上发出比白色更亮的光；更改后会重新加载壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅場景桌布。讓 HDR 場景在 HDR 顯示器上發出比白色更亮的光；變更後會重新載入桌布。"
          }
        }
      }
    },
