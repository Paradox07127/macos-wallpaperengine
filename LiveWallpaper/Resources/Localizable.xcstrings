    "macOS wouldn't unlock your saved API key — allow access when it asks, or set the key again in Settings." : {
      "comment" : "Workshop browse error when the keychain refused to hand over the stored API key.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS konnte den gespeicherten API-Schlüssel nicht freigeben. Erlauben Sie den Zugriff, wenn Sie gefragt werden, oder geben Sie den Schlüssel in den Einstellungen erneut ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS wouldn't unlock your saved API key — allow access when it asks, or set the key again in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no desbloqueó tu clave de API guardada — permite el acceso cuando lo pida, o vuelve a configurar la clave en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas pu déverrouiller la clé API enregistrée. Autorisez l’accès à la demande ou saisissez à nouveau la clé dans Réglages."
          }
