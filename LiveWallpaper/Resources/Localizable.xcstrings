          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen se está cerrando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen se ferme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
