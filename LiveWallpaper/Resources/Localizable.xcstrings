    "Render HDR content as SDR via Rec.709. Disables frame-rate limit." : {
      "comment" : "Description for the Force SDR video color space option, explaining the mutual exclusion with the frame-rate cap.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Render HDR content as SDR via Rec.709. Disables frame-rate limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderiza el contenido HDR como SDR mediante Rec.709. Desactiva el límite de fotogramas por segundo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rec.709 経由で HDR を SDR としてレンダリング。フレームレート制限は無効になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Rec.709 将 HDR 内容渲染为 SDR。会禁用帧率限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 Rec.709 將 HDR 內容渲染為 SDR。會停用畫格速率限制。"
          }
