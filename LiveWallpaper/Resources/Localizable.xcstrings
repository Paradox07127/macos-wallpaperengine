        }
      }
    },
    "Click Wallpaper Library at the bottom, or scroll upward, to reveal the shelf. Continue upward for the full library. You can also use the top navigation." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie unten auf die Wallpaper-Bibliothek oder scrollen Sie nach oben, um die Regale anzuzeigen. Scrollen Sie weiter nach oben, um die gesamte Bibliothek anzuzeigen. Sie können auch die Navigationsleiste oben verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Wallpaper Library at the bottom, or scroll upward, to reveal the shelf. Continue upward for the full library. You can also use the top navigation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Biblioteca abajo o desplázate hacia arriba para abrir la estantería. Continúa para ver toda la biblioteca, o usa la navegación superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur la Bibliothèque de fonds d'écran en bas, ou faites défiler vers le haut pour révéler l'étagère. Continuez vers le haut pour accéder à la bibliothèque complète. Vous pouvez également utiliser la navigation en haut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下部の壁紙ライブラリをクリックするか上にスクロールしてシェルフを開きます。さらに上へ進むと全ライブラリを表示します。上部のナビゲーションも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래쪽의 배경화면 라이브러리를 클릭하거나 위로 스크롤하여 선반을 표시합니다. 전체 라이브러리를 보려면 위로 계속 스크롤하세요. 상단 내비게이션도 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique na Biblioteca de Papel de Parede na parte inferior ou role para cima para revelar a prateleira. Continue para cima para acessar a biblioteca completa. Você também pode usar a navegação superior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击底部“壁纸库”或向上滚动可展开壁纸架，继续向上可进入完整壁纸库，也可使用顶部导航。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按底部「桌布庫」或向上捲動可展開桌布架，繼續向上可進入完整桌布庫，也可使用頂部導覽。"
          }
        }
      }
    },
