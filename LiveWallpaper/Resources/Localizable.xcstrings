    "Automatic recovery runs while Loomscreen is open, waits for persistent failure, and restarts at most once every five minutes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic recovery runs while Loomscreen is open, waits for persistent failure, and restarts at most once every five minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación funciona con Loomscreen abierto, espera un fallo persistente y reinicia como máximo una vez cada cinco minutos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen の起動中に継続的な障害を確認して復旧します。再起動は5分に1回までです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动恢复在 Loomscreen 运行时生效，仅处理持续故障，每五分钟最多重启一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動恢復在 Loomscreen 執行時生效，僅處理持續故障，每五分鐘最多重新啟動一次。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Wiederherstellung läuft, während Loomscreen geöffnet ist, wartet auf einen anhaltenden Ausfall und startet höchstens einmal alle fünf Minuten neu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération automatique s'exécute pendant que Loomscreen est ouvert, attend une défaillance persistante et redémarre au maximum une fois toutes les cinq minutes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 복구는 Loomscreen이 열려 있는 동안 실행되며, 지속적인 실패를 기다리고, 최대 5분마다 한 번만 재시작합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recuperação automática é executada enquanto Loomscreen está aberto, espera por falha persistente e reinicia no máximo uma vez a cada cinco minutos."
          }
        }
      }
    },
