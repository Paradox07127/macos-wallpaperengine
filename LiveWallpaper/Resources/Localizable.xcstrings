    "Authorize access to downloaded aerials. Original files remain unchanged." : {
      "comment" : "Aerials unauthorized state; read-only access to downloaded local assets.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff auf heruntergeladene Luftaufnahmen autorisieren. Originaldateien bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorize access to downloaded aerials. Original files remain unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriza el acceso a las vistas aéreas descargadas. Los archivos originales no se modifican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès aux vues aériennes téléchargées. Les fichiers d’origine restent inchangés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みの空撮へのアクセスを許可します。元のファイルは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드된 항공 영상을 액세스할 수 있도록 승인합니다. 원본 파일은 변경되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorize o acesso às vistas aéreas baixadas. Os arquivos originais permanecem inalterados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授权读取已下载的航拍资源，不修改原文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授權讀取已下載的空照圖資源，不修改原始檔案。"
          }
        }
      }
    },
