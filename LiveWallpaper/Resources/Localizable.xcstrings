    "Runs the same version check as the button, once per launch. It only reads Steam's build number — nothing is downloaded until you choose to update." : {
      "comment" : "Info popover for the launch-time asset update check.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs the same version check as the button, once per launch. It only reads Steam's build number — nothing is downloaded until you choose to update."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボタンと同じバージョン確認を、起動ごとに 1 回実行します。Steam のビルド番号を読み取るだけで、更新を選ぶまで何もダウンロードされません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每次启动时执行与按钮相同的版本检查。它只读取 Steam 的构建号——在你选择更新之前不会下载任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每次啟動時執行與按鈕相同的版本檢查。它只讀取 Steam 的組建號——在你選擇更新之前不會下載任何內容。"
          }
        }
      }
    },
