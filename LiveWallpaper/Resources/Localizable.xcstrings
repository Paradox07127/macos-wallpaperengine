    "Bindings are kept while off. Shortcuts require a modifier key and must not conflict with other shortcuts." : {
      "comment" : "Global shortcuts info; bindings preserved and combination requirements.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastenbelegungen bleiben auch bei deaktivierten Kurzbefehlen gespeichert. Jeder Kurzbefehl benötigt eine Sondertaste und darf nicht mit anderen Kurzbefehlen kollidieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bindings are kept while off. Shortcuts require a modifier key and must not conflict with other shortcuts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las asignaciones se conservan al desactivarlos. Cada atajo requiere una tecla modificadora y no debe entrar en conflicto con otros atajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liaisons sont maintenues lorsqu'elles sont désactivées. Les raccourcis nécessitent une touche de modification et ne doivent pas entrer en conflit avec d'autres raccourcis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにしても割り当ては保持されます。ショートカットには修飾キーが必要で、ほかのショートカットと重複できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바인딩은 꺼져 있는 동안 유지됩니다. 단축키는 수정자 키가 필요하며 다른 단축키와 충돌해서는 안 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As ligações são mantidas enquanto desligadas. Atalhos exigem uma tecla modificadora e não devem conflitar com outros atalhos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后保留快捷键绑定。组合需包含修饰键，且不得与其他快捷键冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後保留快速鍵綁定。組合需包含修飾鍵，且不得與其他快速鍵衝突。"
          }
        }
      }
    },
