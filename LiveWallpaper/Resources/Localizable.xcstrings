    "Loomscreen can use existing Homebrew installations. On Apple Silicon, Homebrew's initial SteamCMD download requires Rosetta: manually run steamcmd +quit in Terminal to let SteamCMD update itself, then choose Locate automatically." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen can use existing Homebrew installations. On Apple Silicon, Homebrew's initial SteamCMD download requires Rosetta: manually run steamcmd +quit in Terminal to let SteamCMD update itself, then choose Locate automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen puede usar instalaciones existentes de Homebrew. En Apple Silicon, la descarga inicial de SteamCMD de Homebrew requiere Rosetta: ejecuta manualmente steamcmd +quit en Terminal para que SteamCMD se actualice y después elige Localizar automáticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen は Homebrew でインストール済みの SteamCMD も利用できます。Apple Silicon では Homebrew の初期ダウンロード版に Rosetta が必要です。ターミナルで steamcmd +quit を手動実行して SteamCMD の自己更新を完了させてから、自動検出を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 也支持识别已有的 Homebrew 安装。在 Apple Silicon 上，Homebrew 初次下载的 SteamCMD 需要 Rosetta 转译：请在终端手动运行 steamcmd +quit，让 SteamCMD 完成自更新，再选择“自动查找”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 也支援辨識已有的 Homebrew 安裝。在 Apple Silicon 上，Homebrew 初次下載的 SteamCMD 需要 Rosetta 轉譯：請在終端機手動執行 steamcmd +quit，讓 SteamCMD 完成自我更新，再選擇「自動尋找」。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen kann bestehende Homebrew-Installationen verwenden. Auf Apple Silicon erfordert der anfängliche SteamCMD-Download von Homebrew Rosetta: Führen Sie im Terminal manuell steamcmd +quit aus, damit SteamCMD sich aktualisieren kann, und wählen Sie anschließend „Automatisch lokalisieren“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen peut utiliser les installations Homebrew existantes. Sur Apple Silicon, le téléchargement initial de SteamCMD de Homebrew nécessite Rosetta : exécutez manuellement steamcmd +quit dans le terminal pour laisser SteamCMD se mettre à jour, puis choisissez Localiser automatiquement."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen은 기존 Homebrew 설치를 사용할 수 있습니다. Apple Silicon에서는 Homebrew의 초기 SteamCMD 다운로드가 Rosetta가 필요합니다: Terminal에서 steamcmd +quit을 수동으로 실행하여 SteamCMD이 자체적으로 업데이트되도록 한 다음, 자동으로 위치 지정을 선택합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen pode usar instalações existentes do Homebrew. No Apple Silicon, o download inicial do SteamCMD do Homebrew requer Rosetta: execute manualmente steamcmd +quit no Terminal para permitir que SteamCMD se atualize, então escolha Localizar automaticamente."
          }
        }
      }
    },
    "Loomscreen couldn't use that file as SteamCMD." : {
      "comment" : "Workshop setup error when a manually chosen SteamCMD is refused.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen couldn't use that file as SteamCMD."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen no pudo usar ese archivo como SteamCMD."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのファイルは SteamCMD として使用できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 无法将该文件用作 SteamCMD。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 無法將該檔案用作 SteamCMD。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen konnte diese Datei nicht als SteamCMD verwenden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen n'a pas pu utiliser ce fichier comme SteamCMD."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen은 그 파일을 SteamCMD로 사용할 수 없었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen não pôde usar esse arquivo como SteamCMD."
          }
        }
      }
    },
    "Loomscreen downloads SteamCMD directly from Valve, with native support for Apple Silicon. No Rosetta is needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen downloads SteamCMD directly from Valve, with native support for Apple Silicon. No Rosetta is needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen descarga SteamCMD directamente de Valve, con soporte nativo para Apple Silicon. No se necesita Rosetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen は Apple Silicon にネイティブ対応した SteamCMD を Valve から直接ダウンロードします。Rosetta は不要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 直接从 Valve 下载原生支持 Apple Silicon 的 SteamCMD，无需 Rosetta 转译。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 直接從 Valve 下載原生支援 Apple Silicon 的 SteamCMD，無需 Rosetta 轉譯。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen Downloads SteamCMD direkt von Valve, mit integriertem Support für Apple Silicon. Kein Rosetta ist erforderlich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen téléchargements SteamCMD directement depuis Valve, avec un support natif pour le silicium Apple. Aucun Rosetta n'est nécessaire."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 다운로드는 Valve에서 직접 SteamCMD을 다운로드할 수 있으며, Apple Silicon에 대한 기본 지원이 제공됩니다. Rosetta는 필요하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen downloads SteamCMD diretamente da Valve, com suporte nativo para Apple Silicon. Não é necessário Rosetta."
          }
        }
      }
    },
    "Loomscreen downloads through SteamCMD, never through a third-party server. You need to own Wallpaper Engine." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen descarga a través de SteamCMD, nunca mediante un servidor de terceros. Necesitas tener Wallpaper Engine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen は SteamCMD 経由でダウンロードします。第三者のサーバーは使いません。Wallpaper Engine を所有している必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 通过 SteamCMD 下载，不经第三方服务器。需要你拥有 Wallpaper Engine 的授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 透過 SteamCMD 下載，不經第三方伺服器。需要你擁有 Wallpaper Engine 的授權。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen Downloads über SteamCMD, niemals über einen Drittanbieter-Server. Sie müssen Wallpaper Engine besitzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen téléchargements via SteamCMD, jamais via un serveur tiers. Vous devez posséder Wallpaper Engine."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen은 SteamCMD을 통해 다운로드되며, 제3자 서버를 통해 다운로드되지 않습니다. Wallpaper Engine를 소유해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen downloads através de SteamCMD, nunca através de um servidor de terceiros. Você precisa possuir Wallpaper Engine."
          }
        }
      }
    },
    "Loomscreen is quitting." : {
      "comment" : "Scene import refused because the app is shutting down.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen is quitting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen se está cerrando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen を終了しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 正在退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 正在結束。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen kündigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen est en train d'arrêter."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen은 그만두고 있다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen está desistindo."
          }
        }
      }
    },
    "Loomscreen never asks for Full Disk Access. Library access comes from one folder you pick, stored as a security-scoped bookmark." : {
      "comment" : "Workshop privacy point about file access.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen never asks for Full Disk Access. Library access comes from one folder you pick, stored as a security-scoped bookmark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen nunca pide «Acceso total al disco». El acceso a la biblioteca de Steam proviene de una carpeta que eliges, guardada como marcador con ámbito de seguridad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen はフルディスクアクセスを要求しません。Steam ライブラリへのアクセスは、選択した 1 つのフォルダに対するセキュリティスコープ付きブックマークに基づきます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 从不要求完全磁盘访问权限。对 Steam 库的访问仅来自你选择的那一个文件夹，以安全作用域书签的形式保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 從不要求「完全取用磁碟」權限。對 Steam 收藏庫的存取僅來自你選擇的那一個資料夾，以安全範圍書籤的形式保存。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen fragt nie nach Full-Disk-Zugriff. Der Bibliothekszugriff stammt aus einem von Ihnen ausgewählten Ordner, der als sicherheitsbezogenes Lesezeichen gespeichert wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen ne demande jamais l'accès complet au disque. L'accès à la bibliothèque provient d'un dossier que vous choisissez, stocké sous forme de favori avec un périmètre de sécurité défini."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen은 절대 전체 디스크 액세스를 요구하지 않습니다. 라이브러리 액세스는 선택한 하나의 폴더에서 제공되며, 보안 범위별 북마크로 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen nunca solicita Acesso Completo ao Disco. O acesso à biblioteca vem de uma pasta que você escolhe, armazenada como um marcador com escopo de segurança."
          }
        }
      }
    },
    "Loomscreen never reads your Steam password — only this key, stored locally on this Mac." : {
      "comment" : "Secondary reassurance under the API-key-required state and entry sheet.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen nunca lee tu contraseña de Steam — solo esta clave, almacenada localmente en este Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen が Steam パスワードを読み取ることはありません — このキーだけを、この Mac 上にローカル保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 绝不会读取你的 Steam 密码——只读取此密钥，并且只存储在本机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 絕不會讀取你的 Steam 密碼——只讀取此金鑰，並且只儲存在這台 Mac 上。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen liest niemals Ihr Steam-Passwort — nur diesen Schlüssel, der lokal auf diesem Mac gespeichert ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen ne lit jamais votre mot de passe Steam — seulement cette clé, stockée localement sur ce Mac."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen은 당신의 Steam 비밀번호를 읽지 않습니다 — 이 Mac에 로컬로 저장된 이 키만 읽습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen nunca lê sua senha Steam — apenas esta chave, armazenada localmente neste Mac."
          }
        }
      }
    },
    "Loomscreen will download and prepare SteamCMD for this Mac. Your existing installation stays in place. No Terminal commands are needed." : {
      "comment" : "SteamCMD first-run preparation and in-app recovery.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen will download and prepare SteamCMD for this Mac. Your existing installation stays in place. No Terminal commands are needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen descargará y preparará SteamCMD para este Mac. Tu instalación actual se conservará. No necesitas usar comandos de Terminal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen がこの Mac 用の SteamCMD をダウンロードして準備します。既存のインストールはそのまま残ります。ターミナルでの操作は不要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 将为本机下载并准备 SteamCMD，保留现有安装，无需执行终端命令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 將為這台 Mac 下載並準備 SteamCMD，保留現有安裝，無需執行終端機指令。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen wird SteamCMD für diesen Mac herunterladen und vorbereiten. Ihre bestehende Installation bleibt bestehen. Es werden keine Terminalbefehle benötigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen téléchargera et préparera SteamCMD pour ce Mac. Votre installation existante restera en place. Aucune commande du terminal n'est nécessaire."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen이 이 Mac을 위해 SteamCMD을 다운로드하고 준비합니다. 기존 설치는 그대로 유지됩니다. 터미널 명령이 필요하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen irá baixar e preparar SteamCMD para este Mac. Sua instalação existente permanece no lugar. Não são necessários comandos de Terminal."
          }
        }
      }
    },
    "Loomscreen will stop using these Wallpaper Engine assets. Files in your Steam library will be kept. Scene wallpapers may have missing textures or effects until assets are linked again." : {
      "comment" : "Confirmation for removing the app-managed Wallpaper Engine assets, not a user-linked external installation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen will stop using these Wallpaper Engine assets. Files in your Steam library will be kept. Scene wallpapers may have missing textures or effects until assets are linked again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen dejará de usar estos recursos de Wallpaper Engine. Los archivos de tu biblioteca de Steam se conservarán. Hasta que vuelvas a vincular los recursos, pueden faltar texturas o efectos en los fondos de escena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen はこれらの Wallpaper Engine アセットの使用を停止します。Steam ライブラリ内のファイルは保持されます。アセットを再度リンクするまで、シーン壁紙のテクスチャやエフェクトが欠ける場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 将停止使用这些 Wallpaper Engine 共享资源，Steam 库中的文件会保留。重新关联资源前，场景壁纸可能缺少贴图或特效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 將停止使用這些 Wallpaper Engine 共用資源，Steam 收藏庫中的檔案會保留。重新連結資源前，場景桌布可能缺少材質或特效。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen wird aufhören, diese Wallpaper Engine-Assets zu verwenden. Dateien in Ihrer Steam-Bibliothek werden behalten. Szenenhintergründe können fehlende Texturen oder Effekte aufweisen, bis die Assets wieder verknüpft sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen cessera d'utiliser ces Wallpaper Engine actifs. Les fichiers de votre Steam bibliothèque seront conservés. Les fonds d'écran de scène peuvent avoir des textures ou des effets manquants jusqu'à ce que les actifs soient à nouveau liés."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen은 이러한 Wallpaper Engine 자산을 사용하지 않게 됩니다. Steam 라이브러리의 파일은 유지됩니다. 장면 배경화면은 자산이 다시 연결될 때까지 누락된 텍스처나 효과가 있을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen deixará de usar esses Wallpaper Engine ativos. Os arquivos em sua biblioteca Steam serão mantidos. As wallpapers de cena podem ter texturas ou efeitos faltando até que os ativos sejam vinculados novamente."
          }
        }
      }
    },
    "Loomscreen won't run a SteamCMD from inside its own container." : {
      "comment" : "Workshop setup error when the chosen SteamCMD sits in the app's own container.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen won't run a SteamCMD from inside its own container."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen no ejecutará un SteamCMD desde su propio contenedor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen は自身のコンテナ内にある SteamCMD を実行しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 不会运行位于自身容器内的 SteamCMD。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 不會執行位於自身容器內的 SteamCMD。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen wird kein SteamCMD aus seinem eigenen Container ausführen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen ne lancera pas un SteamCMD depuis l'intérieur de son propre conteneur."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen은 자체 컨테이너 내에서 SteamCMD을 실행하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen não vai executar um SteamCMD dentro de seu próprio contêiner."
          }
        }
      }
    },
    "Loomscreen's background Steam helper didn't answer. Downloads won't run until it does — quitting and reopening Loomscreen usually starts it." : {
      "comment" : "Connector diagnostic when the XPC service is unreachable.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente de Steam en segundo plano de Loomscreen no respondió. Las descargas no se ejecutarán hasta que lo haga — salir y volver a abrir Loomscreen suele iniciarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen のバックグラウンド Steam ヘルパーが応答しませんでした。応答するまでダウンロードは実行できません。Loomscreen を終了して開き直すと起動することがほとんどです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的后台 Steam 助手没有响应。在它响应之前无法下载——退出并重新打开 Loomscreen 通常就能启动它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的背景 Steam 輔助程式沒有回應。在它回應之前無法下載——結束並重新開啟 Loomscreen 通常就能啟動它。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hintergrund-Helfer Steam von Loomscreen hat nicht geantwortet. Die Downloads werden nicht ausgeführt, bis er es tut – das Beenden und Wiedereröffnen von Loomscreen startet ihn normalerweise."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assistant arrière-plan Steam de Loomscreen n'a pas répondu. Les téléchargements ne démarreront pas tant qu'il ne le fera pas — la fermeture et la réouverture de Loomscreen le démarrent généralement."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen의 배경 Steam 도우미가 답변하지 않았습니다. 다운로드가 실행되지 않을 때까지 — 종료하고 다시 시작하면 Loomscreen가 일반적으로 이를 시작합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O assistente de fundo Steam do Loomscreen não respondeu. Os downloads não serão executados até que ele o faça — fechar e reabrir Loomscreen geralmente o inicia."
          }
        }
      }
    },
    "Loomscreen's download session is unavailable. Reconnect this account; your Steam app sign-in is separate." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen's download session is unavailable. Reconnect this account; your Steam app sign-in is separate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión de descarga de Loomscreen no está disponible. Vuelve a conectar esta cuenta; el inicio de sesión de Steam se gestiona por separado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen のダウンロード用セッションが利用できません。このアカウントを再接続してください。Steam アプリのログインは別に管理されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的下载登录会话不可用。请重新连接此账户；Steam 应用的登录状态独立管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的下載登入工作階段無法使用。請重新連接此帳號；Steam App 的登入狀態獨立管理。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Download-Sitzung von Loomscreen ist nicht verfügbar. Verbinden Sie dieses Konto erneut; die Anmeldung für Ihre Steam-App ist separat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session de téléchargement de Loomscreen n'est pas disponible. Connectez-vous à nouveau à ce compte ; la connexion à votre application Steam est séparée."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen의 다운로드 세션이 사용할 수 없습니다. 이 계정을 다시 연결하세요; Steam 앱 로그인은 별도로 진행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão de download do Loomscreen não está disponível. Reconecte esta conta; o login do seu aplicativo Steam é separado."
          }
        }
      }
    },
    "Loomscreen's Steam connector did not respond, so the signature wasn't checked." : {
      "comment" : "SteamCMD diagnostic (Doctor) probe label or result message.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen's Steam connector did not respond, so the signature wasn't checked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El conector de Steam de Loomscreen no respondió, así que no se comprobó la firma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen の Steam コネクタが応答しなかったため、署名を確認できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的 Steam 连接器没有响应，因此未检查签名。"
          }
        },
        "zh-Hant" : {
