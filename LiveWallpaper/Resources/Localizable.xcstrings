    "'%@' is already in your library from another folder. The Steam download takes its place; that folder stays on disk." : {
      "comment" : "Confirm message before a Workshop download replaces a library copy imported from a local folder. Placeholder is the wallpaper title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' is already in your library from another folder. The Steam download takes its place; that folder stays on disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' ya está en la biblioteca desde otra carpeta. La descarga de Steam ocupa su lugar; esa carpeta se queda en el disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は別のフォルダから壁紙ライブラリに追加済みです。Steam のダウンロードがこれに置き換わります。そのフォルダはディスク上に残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已从另一个文件夹加入壁纸库。Steam 下载的版本会取代它；那个文件夹仍留在磁盘上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已從另一個資料夾加入桌布庫。Steam 下載的版本會取代它；該資料夾仍保留在磁碟上。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist bereits aus einem anderen Ordner in Ihrer Mediathek. Der Steam-Download ersetzt diesen Eintrag; der Ordner bleibt auf dem Datenträger."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est déjà dans votre bibliothèque depuis un autre dossier. Le téléchargement Steam remplace cette entrée ; le dossier reste sur le disque."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 이미 다른 폴더에서 라이브러리에 추가되어 있습니다. Steam 다운로드가 이 항목을 대체하며 해당 폴더는 디스크에 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” já está na biblioteca a partir de outra pasta. O download do Steam substitui essa entrada; a pasta permanece no disco."
          }
        }
      }
    },
    "'%@' is overwritten with what %@ is showing now. The setup saved under that name cannot be recovered." : {
      "comment" : "Confirm message for overwriting a saved scheme with a display's current setup. Placeholders are the scheme name and the source display name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' is overwritten with what %2$@ is showing now. The setup saved under that name cannot be recovered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' se sobrescribe con lo que %2$@ muestra ahora. La configuración guardada con ese nombre no se puede recuperar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は %2$@ が現在表示している内容で上書きされます。その名前で保存されていた設定は元に戻せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”会被 %2$@ 当前显示的内容覆盖。以该名称保存的设置无法恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」會被 %2$@ 目前顯示的內容覆蓋。以該名稱儲存的設定無法復原。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ wird mit der aktuellen Einrichtung von %2$@ überschrieben. Die bisher unter diesem Namen gespeicherte Einrichtung kann nicht wiederhergestellt werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » sera remplacée par la configuration actuelle de %2$@. La configuration enregistrée sous ce nom ne pourra pas être récupérée."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”을(를) %2$@의 현재 설정으로 덮어씁니다. 이 이름으로 저장되어 있던 설정은 복구할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” será substituída pela configuração atual de %2$@. A configuração salva com esse nome não poderá ser recuperada."
          }
        }
      }
    },
    "'%@' replaces the wallpaper, overlay layout, and every setting on %@. Save that display's current setup as a scheme first if you want it back." : {
      "comment" : "Confirm message for applying a saved scheme. Placeholders are the scheme name and the target display name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' replaces the wallpaper, overlay layout, and every setting on %2$@. Save that display's current setup as a scheme first if you want it back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' sustituye el fondo de pantalla, la disposición de la superposición y todos los ajustes de %2$@. Guarda primero la configuración actual de esa pantalla como esquema si quieres recuperarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」が %2$@ の壁紙、オーバーレイの配置、すべての設定を置き換えます。元に戻したい場合は、先に現在の設定を構成として保存してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”会替换 %2$@ 的壁纸、叠加层布局与全部设置。想留住现在这套，先把它保存为方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」會取代 %2$@ 的桌布、疊加層配置與全部設定。想留住現在這套，先把它儲存為方案。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ersetzt den Hintergrund, die Überlagerungen und alle Einstellungen auf %2$@. Sichern Sie die aktuelle Einrichtung dieses Monitors zuerst als Profil, wenn Sie sie später wiederherstellen möchten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » remplace le fond d’écran, la disposition des calques et tous les réglages de %2$@. Enregistrez d’abord la configuration actuelle de ce moniteur si vous souhaitez la retrouver."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”은(는) %2$@의 배경화면, 오버레이 레이아웃 및 모든 설정을 교체합니다. 나중에 복원하려면 먼저 해당 디스플레이의 현재 설정을 구성으로 저장하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” substitui o papel de parede, o layout das camadas e todos os ajustes de %2$@. Salve primeiro os ajustes atuais desse monitor como uma configuração se quiser recuperá-los depois."
          }
        }
      }
    },
    "'%@' will be removed from your saved schemes. Displays it was applied to keep what is on screen." : {
      "comment" : "Destructive confirm message. Placeholder is the scheme name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' will be removed from your saved schemes. Displays it was applied to keep what is on screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' se eliminará de tus esquemas guardados. Las pantallas a las que se aplicó conservan lo que hay en pantalla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は保存済みの構成から削除されます。適用したディスプレイは現在の表示のままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从已保存的方案中移除。已应用它的显示器会保持当前画面不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將從已儲存的方案中移除。已套用過它的顯示器會維持目前畫面不變。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird aus Ihren gespeicherten Profilen entfernt. Monitore, auf die sie angewendet wurde, behalten ihre aktuelle Darstellung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera retirée des configurations enregistrées. Les moniteurs auxquels elle a été appliquée conservent leur affichage actuel."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 구성에서 “%@”을(를) 제거합니다. 이 구성이 적용된 디스플레이의 현재 화면은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” será removida das configurações salvas. Os monitores em que ela foi aplicada mantêm a exibição atual."
          }
        }
      }
    },
    "“%@” and its copy in Loomscreen's shared folder are deleted. Your original files are untouched." : {
      "comment" : "Destructive confirm message for removing a published system wallpaper. Placeholder is the wallpaper title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” and its copy in Loomscreen's shared folder are deleted. Your original files are untouched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan “%@” y su copia en la carpeta compartida de Loomscreen. Tus archivos originales permanecen intactos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」と Loomscreen の共有フォルダ内のコピーを削除します。元のファイルはそのまま残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除“%@”以及它在 Loomscreen 共享目录中的副本。你的原始文件不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將刪除「%@」以及它在 Loomscreen 共用目錄中的副本。你的原始檔案不受影響。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und die zugehörige Kopie im gemeinsamen Loomscreen-Ordner werden gelöscht. Ihre Originaldateien bleiben unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et sa copie dans le dossier partagé de Loomscreen seront supprimés. Vos fichiers d’origine restent inchangés."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 및 Loomscreen 공유 폴더에 있는 사본을 삭제합니다. 원본 파일은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e sua cópia na pasta compartilhada do Loomscreen serão apagados. Seus arquivos originais permanecem intactos."
          }
        }
      }
    },
    "“%@” is on screen right now. It stops playing and its file is deleted immediately; the desktop keeps the last frame until you pick another wallpaper in System Settings." : {
      "comment" : "Destructive confirm message for removing the system wallpaper that is currently displayed. Placeholder is the video title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is on screen right now. It stops playing and its file is deleted immediately; the desktop keeps the last frame until you pick another wallpaper in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” está en pantalla ahora mismo. Deja de reproducirse y su archivo se elimina de inmediato; el escritorio conserva el último fotograma hasta que elijas otro fondo de pantalla en Ajustes del Sistema › Fondo de pantalla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は現在画面に表示されています。再生を停止してファイルを直ちに削除しますが、「システム設定 › 壁紙」で別の壁紙を選ぶまでデスクトップには最後のフレームが残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”正显示在屏幕上。它会停止播放，文件立即删除；在你到“系统设置 › 墙纸”中更换之前，桌面会保留最后一帧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」正顯示在螢幕上。它會停止播放，檔案立即刪除；在你到「系統設定 › 背景圖片」中更換之前，桌面會保留最後一幀。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird gerade angezeigt. Die Wiedergabe endet und die Datei wird sofort gelöscht. Der Schreibtisch zeigt das letzte Bild, bis Sie in den Systemeinstellungen einen anderen Hintergrund auswählst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est actuellement à l’écran. Sa lecture s’arrête et son fichier est immédiatement supprimé. Le bureau conserve la dernière image jusqu’au choix d’un autre fond d’écran dans Réglages Système."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 화면에 표시된 “%@”의 재생을 중지하고 파일을 즉시 삭제합니다. 시스템 설정에서 다른 배경화면을 선택할 때까지 데스크탑에는 마지막 프레임이 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” está na tela agora. A reprodução para e o arquivo é apagado imediatamente. A mesa mantém o último quadro até você escolher outro papel de parede nos Ajustes do Sistema."
          }
        }
      }
    },
    "“%@” will be removed from every display using it. Your own changes on top of it are kept." : {
      "comment" : "Confirmation dialog message before deleting a scene preset; %@ is the preset name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be removed from every display using it. Your own changes on top of it are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” se quitará de todas las pantallas que lo usen. Tus propios cambios sobre él se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はこれを使用しているすべてのディスプレイから削除されます。その上で加えた変更は保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从所有正在使用它的显示器上移除。你在它之上做的改动会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將從所有正在使用它的顯示器上移除。你在它之上做的改動會保留。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird von allen Monitoren entfernt, die es verwenden. Ihre darauf angewendeten Änderungen bleiben erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera retiré de tous les moniteurs qui l’utilisent. Vos propres modifications sont conservées."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”을(를) 사용하는 모든 디스플레이에서 제거합니다. 사용자가 추가로 적용한 변경사항은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” será removido de todos os monitores que o utilizam. Suas alterações adicionais serão mantidas."
          }
        }
      }
    },
    "“%@” will be replaced with the current settings on every display using it." : {
      "comment" : "Confirmation dialog message before overwriting a saved scene preset with the current settings; %@ is the preset name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be replaced with the current settings on every display using it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” se reemplazará con los ajustes actuales en todas las pantallas que lo usen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は、これを使用しているすべてのディスプレイで現在の設定に置き換えられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将被替换为当前设置，所有正在使用它的显示器都会随之更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將被替換為目前的設定，所有正在使用它的顯示器都會隨之更新。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird auf allen Monitoren, die es verwenden, durch die aktuellen Einstellungen ersetzt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera remplacé par les réglages actuels sur tous les moniteurs qui l’utilisent."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”을(를) 사용하는 모든 디스플레이에 현재 설정을 적용하여 교체합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” será substituído pelos ajustes atuais em todos os monitores que o utilizam."
          }
        }
      }
    },
    "[Get a key](https://steamcommunity.com/dev/apikey)  ·  [Steam Web API TOU](https://steamcommunity.com/dev/apiterms)  ·  [About Limited Accounts](https://help.steampowered.com/en/faqs/view/71D3-35C2-AD96-AA3A)" : {
      "comment" : "A link to Steam's API documentation.",
      "isCommentAutoGenerated" : true,
