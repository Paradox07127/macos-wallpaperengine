          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌布錄製在完成前停止。"
          }
        }
      }
    },
    "The wallpaper, playlist, schedule, effect layer, and all other settings on %lld other displays are replaced with this display's. Their widget and clock overlays are not changed." : {
      "comment" : "Destructive confirm message in an edition without the music overlay. Placeholder is the number of other displays.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Der Hintergrund, die Wiedergabeliste, der Zeitplan, die Effektebene und alle weiteren Einstellungen auf %lld anderem Monitor werden durch die dieses Monitors ersetzt. Die Widget- und Uhrüberlagerungen bleiben unverändert."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Der Hintergrund, die Wiedergabeliste, der Zeitplan, die Effektebene und alle weiteren Einstellungen auf %lld anderen Monitoren werden durch die dieses Monitors ersetzt. Die Widget- und Uhrüberlagerungen bleiben unverändert."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The wallpaper, playlist, schedule, effect layer, and all other settings on %lld other display are replaced with this display's. Its widget and clock overlays are not changed."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The wallpaper, playlist, schedule, effect layer, and all other settings on %lld other displays are replaced with this display's. Their widget and clock overlays are not changed."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "El fondo de pantalla, la playlist, la programación, la capa de efectos y el resto de ajustes de %lld pantalla más se sustituyen por los de esta. Sus superposiciones de widgets y reloj no cambian."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "El fondo de pantalla, la playlist, la programación, la capa de efectos y el resto de ajustes de otras %lld pantallas se sustituyen por los de esta. Sus superposiciones de widgets y reloj no cambian."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Le fond d’écran, la liste de lecture, la programmation, le calque d’effets et tous les autres réglages de %lld autres moniteurs seront remplacés par ceux de ce moniteur. Les calques des widgets et d’horloge restent inchangés."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Le fond d’écran, la liste de lecture, la programmation, le calque d’effets et tous les autres réglages de %lld autre moniteur seront remplacés par ceux de ce moniteur. Les calques des widgets et d’horloge restent inchangés."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Le fond d’écran, la liste de lecture, la programmation, le calque d’effets et tous les autres réglages de %lld autres moniteurs seront remplacés par ceux de ce moniteur. Les calques des widgets et d’horloge restent inchangés."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他の %lld 台のディスプレイの壁紙、プレイリスト、スケジュール、エフェクトレイヤー、その他すべての設定が、このディスプレイと同じ内容に置き換わります。それらのウィジェット・時計のオーバーレイは変わりません。"
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "다른 디스플레이 %lld대의 배경화면, 재생목록, 일정, 효과 레이어 및 기타 모든 설정을 이 디스플레이의 설정으로 교체합니다. 위젯 및 시계 오버레이는 유지됩니다."
                }
              }
            }
          }
        },
        "pt-BR" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "O papel de parede, a lista de reprodução, a programação, a camada de efeitos e todos os outros ajustes de %lld outros monitores serão substituídos pelos deste monitor. As camadas de widgets e relógio permanecem inalteradas."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "O papel de parede, a lista de reprodução, a programação, a camada de efeitos e todos os outros ajustes de %lld outro monitor serão substituídos pelos deste monitor. As camadas de widgets e relógio permanecem inalteradas."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "O papel de parede, a lista de reprodução, a programação, a camada de efeitos e todos os outros ajustes de %lld outros monitores serão substituídos pelos deste monitor. As camadas de widgets e relógio permanecem inalteradas."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另外 %lld 台显示器上的壁纸、播放列表、计划、效果层和其他所有设置，都将替换为与这台显示器相同的内容。它们的小组件和时钟叠加层保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另外 %lld 台顯示器上的桌布、播放列表、排程、效果層和其他所有設定，都將取代為與這台顯示器相同的內容。它們的小工具和時鐘疊加層維持不變。"
          }
        }
      }
    },
