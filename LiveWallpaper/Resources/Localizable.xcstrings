    "'%@' will be removed from your library. Displays using this bookmark fall back to their saved wallpaper." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' will be removed from your library. Displays using this bookmark fall back to their saved wallpaper."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はライブラリから削除されます。このブックマークを使うディスプレイは保存済みの壁紙に戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从你的库中移除。使用该书签的显示器会回退到各自已保存的壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將從你的媒體庫移除。使用該書籤的顯示器會回到各自已儲存的桌布。"
          }
        }
      }
    },
    "“%@” will be deleted from your Steam library on this Mac and removed from Loomscreen. This frees up disk space and can't be undone — you can download it again anytime. Your Steam subscription is unaffected." : {
      "comment" : "Workshop delete confirmation; %@ is the wallpaper title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be deleted from your Steam library on this Mac and removed from Loomscreen. This frees up disk space and can't be undone — you can download it again anytime. Your Steam subscription is unaffected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はこの Mac の Steam ライブラリから削除され、Loomscreen からも取り除かれます。ディスク容量が空きますが元に戻せません（いつでも再ダウンロードできます）。Steam のサブスクリプションには影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从本机的 Steam 库中删除，并从 Loomscreen 中移除。这会释放磁盘空间且无法撤销——你随时可以重新下载。你的 Steam 订阅不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將從本機的 Steam 資料庫中刪除，並從 Loomscreen 中移除。這會釋放磁碟空間且無法復原——你隨時可以重新下載。你的 Steam 訂閱不受影響。"
          }
        }
      }
    },
    "“%@” will be removed from your library. Its original files (imported from your own folder) are left untouched." : {
      "comment" : "A confirmation dialog message for removing a wallpaper from the library. The argument is the name of the wallpaper.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はライブラリから削除されます。元のファイル（自分のフォルダから読み込んだもの）は変更されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从你的库中移除。其原始文件（从你自己的文件夹导入）保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」會從你的資料庫中移除。其原始檔案（從你自己的檔案夾匯入）會保持不變。"
          }
        }
      }
    },
    "[Get a key](https://steamcommunity.com/dev/apikey)  ·  [Steam Web API TOU](https://steamcommunity.com/dev/apiterms)  ·  [About Limited Accounts](https://help.steampowered.com/en/faqs/view/71D3-35C2-AD96-AA3A)" : {
