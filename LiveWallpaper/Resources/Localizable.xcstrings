    "Uses about half the scene frame rate when windows cover half the display or the Mac is on battery." : {
      "comment" : "Adaptive frame rate info; applies only to scene wallpapers.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses about half the scene frame rate when windows cover half the display or the Mac is on battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce aproximadamente a la mitad la tasa de fotogramas de las escenas cuando las ventanas cubren media pantalla o el Mac usa la batería."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウがディスプレイの半分を覆う場合やバッテリー使用時に、シーンのフレームレートを約半分にします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口覆盖显示器一半或 Mac 使用电池时，场景帧率降至约一半。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視窗覆蓋顯示器一半或 Mac 使用電池時，場景影格率降至約一半。"
          }
        }
      }
    },
    "Uses memory per display to reduce disk reads. When off, videos stream from disk." : {
      "comment" : "Video preload info; memory budget applies separately to each display.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses memory per display to reduce disk reads. When off, videos stream from disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa memoria por pantalla para reducir las lecturas del disco. Al desactivarlo, los vídeos se reproducen desde el disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイごとにメモリを使用し、ディスクの読み取りを減らします。オフの場合、動画をディスクからストリーミング再生します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每台显示器使用内存以减少磁盘读取。关闭时从磁盘流式播放视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每台顯示器使用記憶體以減少磁碟讀取。關閉時從磁碟串流播放影片。"
          }
        }
      }
    },
    "Uses one continuous image instead of a copy on each display." : {
      "comment" : "Info for Span All Displays: one continuous video image across displays, rather than independent copies.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses one continuous image instead of a copy on each display."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extiende una sola imagen continua en lugar de repetirla en cada pantalla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ディスプレイに同じ映像を複製せず、1 つの映像をつなげて表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将画面连续铺展到所有显示器，而非在各显示器上分别复制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將畫面連續延展至所有顯示器，而非在各顯示器上分別複製。"
          }
        }
      }
    },
    "Uses screen pixels for pages that do not adapt to high-resolution displays." : {
