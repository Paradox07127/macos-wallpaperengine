    "SteamCMD could not be launched. Open Settings › Workshop › Steam connection to install it or locate an existing copy." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD could not be launched. Open Settings › Workshop › Steam connection to install it or locate an existing copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar SteamCMD. Abre Ajustes › Workshop › Conexión de Steam para instalarlo o localizar una copia existente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD を起動できませんでした。設定 › ワークショップ › Steam 接続でインストールするか、既存の SteamCMD を探してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法启动 SteamCMD。请打开设置 › 创意工坊 › Steam 连接，安装或查找已有的 SteamCMD。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法啟動 SteamCMD。請開啟設定 › 工作坊 › Steam 連線，安裝或尋找現有的 SteamCMD。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD konnte nicht gestartet werden. Öffnen Sie Einstellungen › Workshop › Steam Verbindung, um es zu installieren oder eine vorhandene Kopie zu finden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD n'a pas pu être lancé. Ouvrez Paramètres › Atelier › Steam connexion pour l'installer ou localiser une copie existante."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD을 실행할 수 없습니다. 설정 › 워크숍 › Steam 연결을 열어 설치하거나 기존 사본을 찾으십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD não pôde ser iniciado. Abra Configurações › Oficina › Steam conexão para instalá-lo ou localizar uma cópia existente."
          }
        }
      }
    },
    "SteamCMD did not print the expected Valve identity banner. Use Export diagnostics for the raw output." : {
      "comment" : "SteamCMD diagnostic (Doctor) probe label or result message.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD did not print the expected Valve identity banner. Use Export diagnostics for the raw output."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD no ha mostrado el banner de identidad de Valve esperado. Usa Exportar diagnósticos para ver la salida sin procesar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD が想定した Valve の識別バナーを出力しませんでした。生の出力は「診断をエクスポート」で確認できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 未输出预期的 Valve 身份横幅。可用“导出诊断信息”查看原始输出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
