    },
    "How the scene maps onto the display. Fill crops to cover, Fit adds letterbox bars, Center keeps the render at original size, Stretch distorts to fill." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How the scene maps onto the display. Fill crops to cover, Fit adds letterbox bars, Center keeps the render at original size, Stretch distorts to fill."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo se proyecta la escena en la pantalla. Rellenar recorta para cubrir, Encajar añade bandas, Centrar mantiene el tamaño original, Estirar deforma para llenar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンをディスプレイにどう配置するか。フィルは切り抜いて覆い、フィットはレターボックスの帯を追加、中央は元のサイズを維持し、引き伸ばしは歪めて埋めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "场景如何映射到显示器。填充会裁切以覆盖，适应会添加黑边，居中会保持原始尺寸，拉伸会变形填满。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場景如何映射到顯示器。填滿會裁切以覆蓋，符合會加上黑邊，置中會保持原始尺寸，延展會變形填滿。"
          }
        }
      }
    },
