        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークショップ へのリクエストは HTTPS で Valve に直接送信されます。Loomscreen には何も送信されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
