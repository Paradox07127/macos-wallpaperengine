          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 路径必须是绝对路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 路徑必須是絕對路徑。"
          }
        },
        "de" : {
          "stringUnit" : {
