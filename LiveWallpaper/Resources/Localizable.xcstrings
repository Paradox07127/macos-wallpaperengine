    "Master switch for every global shortcut. Bindings are preserved while off." : {
      "comment" : "Accessibility hint for the master enable toggle at the top of Settings → Shortcuts. Explains that flipping off does not erase saved bindings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
