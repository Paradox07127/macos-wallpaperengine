    "Uses memory per display to reduce disk reads. When off, videos stream from disk." : {
      "comment" : "Video preload info; memory budget applies separately to each display.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet Speicher pro Display, um Festplattenlesevorgänge zu reduzieren. Wenn es ausgeschaltet ist, werden Videos von der Festplatte gestreamt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses memory per display to reduce disk reads. When off, videos stream from disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa memoria por pantalla para reducir las lecturas del disco. Al desactivarlo, los vídeos se reproducen desde el disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise de la mémoire pour chaque moniteur afin de réduire les lectures sur le disque. Lorsque cette option est désactivée, les vidéos sont lues directement depuis le disque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイごとにメモリを使用し、ディスクの読み取りを減らします。オフの場合、動画をディスクからストリーミング再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 읽기를 줄이기 위해 디스플레이당 메모리를 사용합니다. 꺼져 있을 때는 디스크에서 비디오를 스트리밍합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa memória por tela para reduzir as leituras de disco. Quando desligado, os vídeos são transmitidos do disco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每台显示器使用内存以减少磁盘读取。关闭时从磁盘流式播放视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每台顯示器使用記憶體以減少磁碟讀取。關閉時從磁碟串流播放影片。"
          }
        }
      }
    },
    "Uses one continuous image instead of a copy on each display." : {
      "comment" : "Info for Span All Displays: one continuous video image across displays, rather than independent copies.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet ein einziges kontinuierliches Bild anstatt einer Kopie auf jedem Display."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses one continuous image instead of a copy on each display."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extiende una sola imagen continua en lugar de repetirla en cada pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise une seule image continue au lieu d'une copie sur chaque écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ディスプレイに同じ映像を複製せず、1 つの映像をつなげて表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 디스플레이에서 복사본 대신 하나의 연속된 이미지를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa uma imagem contínua em vez de uma cópia em cada tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将画面连续铺展到所有显示器，而非在各显示器上分别复制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將畫面連續延展至所有顯示器，而非在各顯示器上分別複製。"
          }
        }
      }
    },
    "Uses screen pixels for pages that do not adapt to high-resolution displays." : {
      "comment" : "Physical-pixel layout compatibility help; does not guarantee improved sharpness for all pages.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet Bildschirmpixel für Seiten, die sich nicht an Hochauflösungsbildschirme anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
