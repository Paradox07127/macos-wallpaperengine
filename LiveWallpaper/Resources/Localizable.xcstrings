    "Scene debug reports, captures and oracle output. Excludes legacy scene resources." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informes, capturas y resultados de comparación de escenas. Excluye los recursos antiguos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンの診断レポート、キャプチャ、比較出力。旧形式のシーンリソースを除きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
