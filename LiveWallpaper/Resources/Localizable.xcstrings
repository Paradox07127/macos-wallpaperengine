    "Reloads the page at the chosen interval. Useful for dashboards or feeds; off keeps the page rendering continuously without reloads." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reloads the page at the chosen interval. Useful for dashboards or feeds; off keeps the page rendering continuously without reloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a cargar la página en el intervalo elegido. Útil para paneles o canales; desactivado, la página se renderiza de forma continua sin recargas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した間隔でページを再読み込みします。ダッシュボードやフィードに便利です。オフにすると、ページは再読み込みせず継続的にレンダリングされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按所选间隔重新加载页面。适用于仪表盘或信息流；关闭后页面持续渲染，不会重新加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依選定間隔重新載入頁面。適合儀表板或資訊流；關閉後頁面會持續渲染，不會重新載入。"
