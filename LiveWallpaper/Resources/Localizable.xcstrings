    "The Mac is low on memory; Loomscreen uses %@. Quitting apps you are not using frees memory." : {
      "comment" : "Status capsule sentence beside the Low Memory or Critical Memory headline. The placeholder is this app's own memory footprint.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Arbeitsspeicher ist knapp; Loomscreen verwendet %@. Beenden Sie ungenutzte Apps, um Arbeitsspeicher freizugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac is low on memory; Loomscreen uses %@. Quitting apps you are not using frees memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac tiene poca memoria; Loomscreen usa %@. Cerrar las apps que no estés usando libera memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mac a peu de mémoire ; Loomscreen utilise %@. Quitter les applications que vous n'utilisez pas libère de la mémoire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac のメモリが不足しています。Loomscreen は %@ を使用しています。使っていないアプリを終了するとメモリを解放できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac의 메모리가 부족합니다; Loomscreen은 %@을 사용합니다. 사용하지 않는 앱을 종료하면 메모리가 확보됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mac está com pouca memória; Loomscreen usa %@. Fechar aplicativos que você não está usando libera memória."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机内存紧张，Loomscreen 占用 %@。退出暂不使用的应用可以释放内存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台 Mac 記憶體緊張，Loomscreen 佔用 %@。結束暫不使用的應用程式可以釋放記憶體。"
          }
        }
      }
    },
    "The Mac is running hot. Quitting apps you are not using helps it cool down." : {
      "comment" : "Status capsule sentence beside the Running Hot headline (macOS thermal pressure: serious).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mac läuft heiß. Das Beenden von Apps, die Sie nicht verwenden, hilft ihm, sich abzukühlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac is running hot. Quitting apps you are not using helps it cool down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac está caliente. Cerrar las apps que no estés usando ayuda a que se enfríe."
