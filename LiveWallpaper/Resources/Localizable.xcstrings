    "The wallpaper's folder could not be read. Re-pick the source to restore permission." : {
      "comment" : "Web wallpaper failure reason shown when the sandbox refuses the project folder.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wallpaper's folder could not be read. Re-pick the source to restore permission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer la carpeta del fondo de pantalla. Vuelve a elegir el origen para restaurar el permiso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙のフォルダを読み取れませんでした。ソースを選び直して権限を回復してください。"
