    "Sends clicks and scrolls to the wallpaper; desktop icons and the Dock cannot receive clicks." : {
      "comment" : "Web Interaction tooltip. Preserve click/scroll routing and the desktop-icon/Dock click consequence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends clicks and scrolls to the wallpaper; desktop icons and the Dock cannot receive clicks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía los clics y el desplazamiento al fondo; los iconos del escritorio y el Dock no pueden recibir clics."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックとスクロールを壁紙に送ります。デスクトップアイコンと Dock はクリックできなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将点击和滚动发送至壁纸；桌面图标和 Dock 将无法接收点击。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將點按與捲動傳送至桌布；桌面圖示與 Dock 將無法接收點按。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet Klicks und Scrollen an den Hintergrundbild; Desktop-Symbole und der Startbildschirm können keine Klicks empfangen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie les clics et les défilements à l'arrière-plan ; les icônes du bureau et le Dock ne peuvent pas recevoir de clics."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭과 스크롤을 배경화면에 전송합니다; 데스크톱 아이콘과 도크는 클릭을 받을 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia cliques e rolagens para o papel de parede; os ícones da área de trabalho e o Dock não podem receber cliques."
          }
        }
      }
    },
