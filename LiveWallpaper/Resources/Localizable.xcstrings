        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléchargement à nouveau de l'image d'arrière-plan dans Steam peut aider. Si ce n'est pas le cas, cette scène n'est pas encore prise en charge."
