    "Steam rejected the saved API key. Browsing without it." : {
      "comment" : "Workshop browse banner shown after Valve rejected the stored Steam Web API key and browsing fell back to the public page.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam hat den gespeicherten API-Schlüssel abgelehnt. Die Suche wird ohne ihn fortgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
