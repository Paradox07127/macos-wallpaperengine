    "The stored API key couldn't be read. Paste it again." : {
      "comment" : "Workshop failure cause when the stored key exists but cannot be read back.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The stored API key couldn't be read. Paste it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer la clave de API guardada. Pégala de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された API キーを読み取れませんでした。もう一度貼り付けてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已保存的 API 密钥。请重新粘贴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取已儲存的 API 金鑰。請重新貼上。"
          }
        },
        "de" : {
          "stringUnit" : {
