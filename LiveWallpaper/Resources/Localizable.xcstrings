    "This replaces overlays on every other connected display. Effects are skipped on displays without a wallpaper." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This replaces overlays on every other connected display. Effects are skipped on displays without a wallpaper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto reemplaza las superposiciones de las demás pantallas conectadas; se omiten los efectos en las pantallas sin fondo de pantalla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されているほかのすべてのディスプレイのオーバーレイを置き換えます。壁紙がないディスプレイのエフェクトはスキップされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会覆盖其他所有已连接显示器的叠加层；没有壁纸的显示器将跳过效果层。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會覆寫其他所有已連接顯示器的疊加層；沒有桌布的顯示器將略過效果層。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ersetzt Überlagerungen auf jedem anderen verbundenen Bildschirm. Effekte werden auf Bildschirmen ohne Hintergrundbild übersprungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela remplace les surcouches sur chaque autre écran connecté. Les effets sont sautés sur les écrans sans fond d'écran."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 연결된 모든 다른 디스플레이의 오버레이를 대체합니다. 배경화면이 없는 디스플레이에서는 효과가 건너뛰어집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso substitui sobreposições em todas as outras telas conectadas. Os efeitos são ignorados em telas sem papel de parede."
          }
        }
      }
    },
