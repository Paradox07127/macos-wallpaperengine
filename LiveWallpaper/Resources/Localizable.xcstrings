    },
    "Choose the Steam folder here. If there isn't one yet, create a folder named “Steam” in this location, then choose it." : {
      "comment" : "Open-panel message for the content library when no Steam folder exists in the standard location.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the Steam folder here. If there isn't one yet, create a folder named “Steam” in this location, then choose it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige aquí la carpeta Steam. Si todavía no existe, crea en esta ubicación una carpeta llamada «Steam» y luego elígela."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで Steam フォルダを選択してください。まだない場合は、この場所に「Steam」という名前のフォルダを作成してから選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
