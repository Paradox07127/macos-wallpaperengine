    "Extracted scene video textures. Up to 2 GB; leased files stay until playback releases them." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texturas de vídeo extraídas. Hasta 2 GB; los archivos en uso se conservan hasta que la reproducción los libera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抽出済みのシーン動画テクスチャ。上限は 2 GB。再生中のファイルは解放されるまで保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提取的场景视频纹理，上限 2 GB；播放占用的文件在释放前会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擷取的場景影片材質，上限 2 GB；播放佔用的檔案在釋放前保留。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrahierte Szenenvideo-Texturen. Bis zu 2 GB; geleaste Dateien bleiben erhalten, bis die Wiedergabe sie freigibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textures de vidéos de scènes extraites. Jusqu'à 2 Go ; les fichiers sous location restent disponibles jusqu'à ce qu'une mise à jour de lecture les libère."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추출된 장면 비디오 텍스처. 최대 2GB; 임대된 파일은 재생이 종료될 때까지 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texturas de vídeo de cena extraídas. Até 2 GB; os arquivos alugados permanecem até que a versão de reprodução os libere."
          }
        }
      }
    },
