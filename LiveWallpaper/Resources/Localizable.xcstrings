    "Local development origin. JavaScript is allowed automatically for loopback addresses and cannot be revoked here. Pages may still make external network requests." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokaler Entwicklungsursprung. JavaScript ist für Loopback-Adressen automatisch erlaubt und kann hier nicht gesperrt werden. Seiten können dennoch externe Netzwerkanfragen senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local development origin. JavaScript is allowed automatically for loopback addresses and cannot be revoked here. Pages may still make external network requests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Origen de desarrollo local. JavaScript se permite automáticamente en las direcciones de bucle local y no se puede revocar aquí. Las páginas aún pueden realizar solicitudes de red externas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Origine de développement locale. JavaScript est automatiquement autorisé pour les adresses de bouclage et ne peut pas être révoqué ici. Les pages peuvent toujours effectuer des requêtes réseau externes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル開発用のオリジンです。ループバックアドレスでは JavaScript が自動的に許可され、ここでは取り消せません。ページが外部へのネットワークリクエストを行うことはあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 개발 출처입니다. 루프백 주소에는 JavaScript가 자동으로 허용되며 여기에서 철회할 수 없습니다. 페이지에서 외부 네트워크 요청을 보낼 수는 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Origem de desenvolvimento local. JavaScript é permitido automaticamente para endereços de loopback e não pode ser revogado aqui. As páginas ainda podem fazer solicitações de rede externas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地开发来源。回环地址会自动获准运行 JavaScript，无法在此撤销。页面仍可能发出外部网络请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本機開發來源。回環位址會自動獲准執行 JavaScript，無法在此撤銷。頁面仍可能發出外部網路要求。"
          }
        }
      }
    },
