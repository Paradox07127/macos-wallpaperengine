    "SteamCMD could not be launched. Open Settings › Workshop › Steam connection to install it or locate an existing copy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD konnte nicht gestartet werden. Öffnen Sie Einstellungen › Workshop › Steam Verbindung, um es zu installieren oder eine vorhandene Kopie zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD could not be launched. Open Settings › Workshop › Steam connection to install it or locate an existing copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar SteamCMD. Abre Ajustes › Workshop › Conexión de Steam para instalarlo o localizar una copia existente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lancer SteamCMD. Ouvrez Réglages › Workshop › Connexion Steam pour l’installer ou trouver une copie existante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD を起動できませんでした。設定 › ワークショップ › Steam 接続でインストールするか、既存の SteamCMD を探してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD를 실행할 수 없습니다. 설정 › 창작마당 › Steam 연결을 열어 설치하거나 기존 사본을 찾으십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar o SteamCMD. Abra Ajustes › Workshop › Conexão do Steam para instalá-lo ou localizar uma cópia existente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法启动 SteamCMD。请打开设置 › 创意工坊 › Steam 连接，安装或查找已有的 SteamCMD。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法啟動 SteamCMD。請開啟設定 › 工作坊 › Steam 連線，安裝或尋找現有的 SteamCMD。"
          }
        }
      }
    },
    "SteamCMD did not print the expected Valve identity banner. Use Export diagnostics for the raw output." : {
      "comment" : "SteamCMD diagnostic (Doctor) probe label or result message.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD hat das erwartete Valve-Identitätsbanner nicht ausgegeben. Verwenden Sie Export-Diagnostik für die Rohausgabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD did not print the expected Valve identity banner. Use Export diagnostics for the raw output."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD no ha mostrado el banner de identidad de Valve esperado. Usa Exportar diagnósticos para ver la salida sin procesar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD n'a pas imprimé la bannière d'identité Valve attendue. Utilisez Export diagnostics pour la sortie brute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD が想定した Valve の識別バナーを出力しませんでした。生の出力は「診断をエクスポート」で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD는 예상되는 Valve 식별 배너를 출력하지 않았습니다. 원본 출력은 진단을 위한 내보내기를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD não imprimiu o banner de identidade Valve esperado. Use Exportar diagnósticos para a saída bruta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 未输出预期的 Valve 身份横幅。可用“导出诊断信息”查看原始输出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 未輸出預期的 Valve 身分橫幅。可用「匯出診斷資訊」查看原始輸出。"
          }
        }
      }
    },
