          }
        }
      }
    },
    "Loomscreen's Steam connector didn't answer, so the quarantine attribute wasn't checked. Try again." : {
      "comment" : "SteamCMD diagnostic (Doctor) probe label or result message.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen's Steam connector didn't answer, so the quarantine attribute wasn't checked. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El conector de Steam de Loomscreen no respondió, así que no se comprobó el atributo de cuarentena. Inténtalo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen の Steam コネクタが応答しなかったため、検疫属性を確認できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的 Steam 连接器没有响应，因此未检查隔离属性。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的 Steam 連接器沒有回應，因此未檢查隔離屬性。請重試。"
          }
        }
      }
    },
    "Loomscreen's Steam connector is busy with another SteamCMD task. Try again in a moment." : {
      "comment" : "Workshop setup error when binding SteamCMD while the connector is busy with another SteamCMD operation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen's Steam connector is busy with another SteamCMD task. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El conector de Steam de Loomscreen está ocupado con otra tarea de SteamCMD. Inténtalo de nuevo en un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen の Steam コネクタは別の SteamCMD の処理を実行中です。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的 Steam 连接器正忙于另一项 SteamCMD 任务，请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的 Steam 連接器正忙於另一項 SteamCMD 工作，請稍後再試。"
          }
        }
      }
    },
    "Loomscreen's Steam connector was busy, so the signature wasn't checked. Try again." : {
      "comment" : "SteamCMD diagnostic (Doctor) probe label or result message.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen's Steam connector was busy, so the signature wasn't checked. Try again."
