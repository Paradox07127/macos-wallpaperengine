    "Deletes %@ scratch items · %@ created by test runs in the container's tmp folder. Nothing else reads them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht %1$@ temporäre Testobjekte · %2$@ im tmp-Ordner des Containers. Keine anderen Komponenten verwenden sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes %@ scratch items · %@ created by test runs in the container's tmp folder. Nothing else reads them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina %@ elementos temporales · %@ creados por las pruebas en la carpeta tmp del contenedor. Nada más los lee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les %1$@ éléments temporaires créés par les tests dans le dossier tmp du conteneur · %2$@. Aucun autre composant ne les utilise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナの tmp にあるテスト残骸 %@ 件 · %@ を削除します。他からは参照されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테스트 실행으로 컨테이너의 tmp 폴더에 생성된 임시 항목 %1$@개 · %2$@을(를) 삭제합니다. 다른 구성 요소에서는 사용하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga %1$@ itens temporários · %2$@ criados pelos testes na pasta tmp do contêiner. Nenhum outro componente os utiliza."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除容器 tmp 中测试运行留下的 %@ 个临时项 · %@。没有其他组件会读取它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除容器 tmp 中測試執行留下的 %@ 個暫存項目 · %@。沒有其他元件會讀取它們。"
          }
        }
      }
    },
