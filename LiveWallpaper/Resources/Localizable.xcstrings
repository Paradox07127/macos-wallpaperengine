    "This scene requires rendering features that Loomscreen does not support. Other wallpapers continue playing." : {
      "comment" : "Scene fallback warning body.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This scene requires rendering features that Loomscreen does not support. Other wallpapers continue playing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta escena requiere funciones de renderizado que Loomscreen no admite. Los demás fondos de pantalla siguen reproduciéndose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このシーンには、Loomscreen がサポートしていないレンダリング機能が必要です。他の壁紙の再生には影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此场景需要 Loomscreen 不支持的渲染功能。其他壁纸的播放不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此場景需要 Loomscreen 不支援的算繪功能。其他桌布的播放不受影響。"
          }
        }
      }
    },
    "This scene uses a custom shader the renderer couldn't translate to Metal. Try re-downloading the project in Steam." : {
      "comment" : "Wallpaper Engine fallback warning body.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This scene uses a custom shader the renderer couldn't translate to Metal. Try re-downloading the project in Steam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta escena usa un sombreador personalizado que el renderizador no ha podido traducir a Metal. Prueba a volver a descargar el proyecto en Steam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このシーンは、レンダラーが Metal に変換できないカスタムシェーダーを使用しています。Steam でプロジェクトを再ダウンロードしてみてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此场景使用了渲染器无法转译为 Metal 的自定义着色器。请尝试在 Steam 中重新下载该项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此場景使用了渲染器無法轉譯為 Metal 的自訂著色器。請嘗試在 Steam 中重新下載此專案。"
          }
        }
      }
    },
    "This scene's author published no adjustable properties. Playback, sound and interaction stay on the preview controls." : {
      "comment" : "Inspector empty state message when a scene exposes no adjustable properties.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This scene's author published no adjustable properties. Playback, sound and interaction stay on the preview controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El autor de esta escena no ha publicado propiedades ajustables. La reproducción, el sonido y la interacción siguen en los controles de vista previa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このシーンの作者は調整可能なプロパティを公開していません。再生・サウンド・操作はプレビューのコントロールにあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个场景的作者没有公开可调属性。播放、声音和交互仍在预览控件上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個場景的作者沒有公開可調屬性。播放、聲音與互動仍在預覽控制項上。"
          }
        }
      }
    },
    "This Steam account can't download Wallpaper Engine items — it may not own Wallpaper Engine, or downloads are region-restricted." : {
