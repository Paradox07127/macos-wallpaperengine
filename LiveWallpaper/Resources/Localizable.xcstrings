    "Clicks and scrolls go to the web page instead of desktop icons and the desktop context menu on this display. Turn off Interaction to restore desktop clicks." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicks and scrolls go to the web page instead of desktop icons and the desktop context menu on this display. Turn off Interaction to restore desktop clicks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clics y el desplazamiento se envían a la página web y no a los iconos ni al menú contextual del escritorio de esta pantalla. Desactiva Interacción para restaurar los clics en el escritorio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックとスクロールは Web ページに送られ、このディスプレイのデスクトップアイコンとコンテキストメニューを操作できなくなります。「インタラクション」をオフにすると元に戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击和滚动将由网页接收，此显示器上的桌面图标和桌面右键菜单将无法使用。关闭“交互”可恢复桌面点击。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按與捲動將由網頁接收，此顯示器上的桌面圖示與桌面快捷選單將無法使用。關閉「互動」可恢復桌面點按。"
          }
        }
      }
    },
    "Clicks go to the scene instead of desktop icons and the desktop context menu on this display. Turn off Interaction to restore desktop clicks." : {
      "comment" : "Scene Interaction enable confirmation. Preserve both desktop-icon and desktop-context-menu loss, per-display scope, and turning off Interaction to restore access.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicks go to the scene instead of desktop icons and the desktop context menu on this display. Turn off Interaction to restore desktop clicks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clics se envían a la escena y no a los iconos ni al menú contextual del escritorio de esta pantalla. Desactiva Interacción para restaurar los clics en el escritorio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックはシーンに送られ、このディスプレイのデスクトップアイコンとコンテキストメニューを操作できなくなります。「インタラクション」をオフにすると元に戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击将由场景接收，此显示器上的桌面图标和桌面右键菜单将无法使用。关闭“交互”可恢复桌面点击。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按將由場景接收，此顯示器上的桌面圖示與桌面快捷選單將無法使用。關閉「互動」可恢復桌面點按。"
          }
        }
      }
    },
