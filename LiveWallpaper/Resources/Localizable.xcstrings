    "Every download must match Valve's published checksum, and the program must carry Valve's signature, before it is ever run." : {
      "comment" : "Managed SteamCMD install consent sheet checks line.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every download must match Valve's published checksum, and the program must carry Valve's signature, before it is ever run."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada descarga debe coincidir con la suma de comprobación publicada por Valve, y el programa debe llevar la firma de Valve, antes de ejecutarse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのダウンロードは Valve の公開チェックサムと一致し、プログラムが Valve の署名を持っていることを確認してから実行されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个下载都必须与 Valve 公布的校验和一致，且程序必须带有 Valve 的签名，才会被运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個下載都必須與 Valve 公佈的檢查碼一致，且程式必須帶有 Valve 的簽章，才會被執行。"
          }
        }
      }
    },
    "Every item on this page is already in your library." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los elementos de esta página ya están en tu biblioteca."
