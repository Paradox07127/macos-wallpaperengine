    "Quit the other copy, or remove its registration in Settings › System Wallpaper › Manage Extension Registrations." : {
      "comment" : "System Wallpaper status card: how to stop another app copy from providing the system wallpaper.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beenden Sie die andere Kopie oder entfernen Sie ihre Registrierung unter Einstellungen › Systemhintergrund › Erweiterungsregistrierungen verwalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit the other copy, or remove its registration in Settings › System Wallpaper › Manage Extension Registrations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la otra copia o elimina su registro en Ajustes › Fondo del sistema › Gestionar registros de la extensión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez l'autre copie, ou supprimez son enregistrement dans Réglages › Fond d'écran du système › Gérer les enregistrements d'extensions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方を終了するか、「設定 › システム壁紙 › 拡張機能の登録を管理」でその登録を削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 사본을 닫거나 설정 › 시스템 배경화면 › 확장자 등록 관리에서 등록을 제거합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerre a outra cópia ou remova o registro dela em Ajustes › Papel de Parede do Sistema › Gerenciar Registros de Extensões."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出另一份应用，或在“设置 › 系统壁纸 › 管理扩展注册”里移除它的注册。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束另一份應用程式，或在「設定 › 系統桌布 › 管理延伸功能註冊」裡移除它的註冊。"
          }
        }
      }
    },
