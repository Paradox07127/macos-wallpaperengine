    "Steam could not be reached. Check your connection and try again." : {
      "comment" : "Subscription sync error when SteamCMD could not connect to Steam.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con Steam. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
