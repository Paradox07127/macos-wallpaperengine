    "Removes %@ of reclaimable cache files. Active wallpapers keep their source assignments and rebuild cached files when needed." : {
      "comment" : "Destructive confirm message. Placeholder is a formatted byte size.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes %@ of reclaimable cache files. Active wallpapers keep their source assignments and rebuild cached files when needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina %@ de archivos de caché recuperables. Los fondos de pantalla activos conservan sus orígenes y reconstruyen los archivos en caché cuando hace falta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回収可能なキャッシュ %@ を削除します。アクティブな壁紙のソース指定は保持され、必要時に再構築されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将清除 %@ 可回收缓存文件。活动壁纸保留源分配，需要时会重建缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將清除 %@ 可回收快取檔案。使用中的桌布保留來源指派，需要時會重建快取。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt %@ der wiederverwendbaren Cache-Dateien. Aktive Hintergründe behalten ihre Quellzuweisungen bei und erstellen bei Bedarf wieder gespeicherte Dateien neu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime %@ des fichiers de cache récupérables. Les fonds d'écran actifs conservent leurs affectations de source et reconstruisent les fichiers de cache lorsqu'ils sont nécessaires."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재사용 가능한 캐시 파일에서 %@을 제거합니다. 활성 배경화면은 소스 할당을 유지하고 필요할 때 캐시 파일을 재구축합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove %@ dos arquivos de cache recuperáveis. As wallpapers ativas mantêm suas atribuições de fonte e reconstruem os arquivos de cache quando necessário."
          }
        }
      }
    },
    "Removes everything saved for %@: the wallpaper, playlist, schedule, effect layer, and all other settings for this display. The wallpaper library, source files, and the widget and clock overlays are kept." : {
      "comment" : "Destructive confirm message in an edition without the music overlay. Placeholder is the display name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes everything saved for %@: the wallpaper, playlist, schedule, effect layer, and all other settings for this display. The wallpaper library, source files, and the widget and clock overlays are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todo lo guardado para %@: el fondo de pantalla, la playlist, la programación, la capa de efectos y el resto de ajustes de esta pantalla. Se conservan la biblioteca de fondos, los archivos de origen y las superposiciones de widgets y reloj."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に保存されている内容をすべて削除します：壁紙、プレイリスト、スケジュール、エフェクトレイヤー、およびこのディスプレイのその他すべての設定。壁紙ライブラリ、ソースファイル、ウィジェット・時計のオーバーレイは保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将移除为 %@ 保存的全部内容：壁纸、播放列表、计划、效果层，以及这台显示器的其他所有设置。壁纸库、源文件，以及小组件和时钟叠加层会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將移除為 %@ 儲存的全部內容：桌布、播放列表、排程、效果層，以及這台顯示器的其他所有設定。桌布庫、來源檔案，以及小工具和時鐘疊加層會保留。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt alles, was für %@ gespeichert wurde: den Hintergrundbild, die Playlist, den Zeitplan, die Effektebene und alle anderen Einstellungen für diese Anzeige. Die Hintergrundbildbibliothek, die Quelldateien und die Widget- und Uhr-Overlays werden beibehalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tout ce qui a été enregistré pour %@ : l'image d'arrière-plan, la playlist, le planning, la couche d'effets et tous les autres paramètres pour cet affichage. La bibliothèque d'image d'arrière-plan, les fichiers sources et les superpositions de widgets et d'horloge sont conservés."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을 위해 저장된 모든 항목을 제거합니다: 배경화면, 플레이리스트, 일정, 효과 레이어 및 이 디스플레이에 대한 모든 기타 설정. 배경화면 라이브러리, 소스 파일 및 위젯 및 시계 오버레이는 유지됩니다."
