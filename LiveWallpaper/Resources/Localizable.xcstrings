    "Missing shared assets may leave parts of a scene invisible." : {
      "comment" : "Visible consequence of missing Wallpaper Engine shared assets, even when a scene loads successfully.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Missing shared assets may leave parts of a scene invisible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si faltan recursos compartidos, algunas partes de una escena pueden no mostrarse."
