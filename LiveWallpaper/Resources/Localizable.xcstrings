    "macOS chooses the wallpaper for each display and Space. Importing a video does not apply it to every desktop." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS chooses the wallpaper for each display and Space. Importing a video does not apply it to every desktop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS gestiona el fondo de cada pantalla y espacio. Importar un vídeo no lo aplica a todos los escritorios."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ディスプレイと操作スペースの壁紙は macOS が管理します。ビデオを読み込んでも、すべてのデスクトップには適用されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 分别管理各显示器和桌面空间的壁纸。导入视频不会将其应用到所有桌面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 分別管理各顯示器和桌面空間的桌布。匯入影片不會將其套用至所有桌面。"
          }
        }
      }
    },
