    "Re-downloading the wallpaper in Steam can help. If it doesn't, this scene isn't supported yet." : {
      "comment" : "Wallpaper Engine fallback warning body.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-downloading the wallpaper in Steam can help. If it doesn't, this scene isn't supported yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a descargar el fondo en Steam puede ayudar. Si no, esta escena aún no es compatible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam で壁紙を再ダウンロードすると直る場合があります。直らない場合、このシーンはまだサポートされていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以尝试在 Steam 中重新下载该壁纸；仍无法显示时，说明此场景暂不受支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以嘗試在 Steam 中重新下載此桌布；仍無法顯示時，表示此場景暫不支援。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das erneute Herunterladen des Hintergrundbildes in Steam kann helfen. Wenn das nicht funktioniert, wird diese Szene noch nicht unterstützt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléchargement à nouveau de l'image d'arrière-plan dans Steam peut aider. Si ce n'est pas le cas, cette scène n'est pas encore prise en charge."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam에서 배경화면을 다시 다운로드하는 것이 도움이 될 수 있습니다. 그렇지 않으면 이 장면은 아직 지원되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-baixar o papel de parede em Steam pode ajudar. Se não, esta cena ainda não é suportada."
          }
        }
      }
    },
    "Re-downloading the wallpaper in Steam usually fixes this." : {
      "comment" : "Wallpaper Engine fallback warning body.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-downloading the wallpaper in Steam usually fixes this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente se soluciona volviendo a descargar el fondo en Steam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常は Steam で壁紙を再ダウンロードすると解決します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常在 Steam 中重新下载该壁纸即可解决。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常在 Steam 中重新下載此桌布即可解決。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das erneute Herunterladen des Hintergrundbildes in Steam behebt dies normalerweise."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rechargement de l'image d'arrière-plan dans Steam résout généralement ce problème."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam에서 배경화면을 다시 다운로드하면 보통 이것이 해결됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-baixar o papel de parede em Steam geralmente resolve isso."
          }
        }
      }
    },
