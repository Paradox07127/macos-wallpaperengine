    "General controls language, login startup, the Dock, and the wallpaper transition and opening animation." : {
      "comment" : "Welcome Tour settings walkthrough or completion.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allgemein enthält Sprache, Start bei Anmeldung, Dock-Anzeige sowie Hintergrundübergang und Startanimation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General controls language, login startup, the Dock, and the wallpaper transition and opening animation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General permite configurar Idioma, Abrir al iniciar sesión, Mostrar en el Dock, Transición de fondo y Animación de apertura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Général regroupe la langue, l’ouverture à la connexion, le Dock, les transitions des fonds et l’animation d’ouverture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般設定では、言語、「ログイン時に起動」、「Dock に表示」、「壁紙の切り替え効果」、「オープニングアニメーション」を設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반에서 언어, 로그인 시 실행, Dock 표시, 배경화면 전환 및 시작 애니메이션을 설정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geral reúne idioma, início de sessão, Dock, transição dos papéis de parede e animação de abertura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通用设置管理语言、登录时启动、在 Dock 中显示，以及换壁纸动画和开场动画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般設定管理語言、登入時啟動、在 Dock 中顯示，以及換桌布動畫和開場動畫。"
          }
        }
      }
    },
