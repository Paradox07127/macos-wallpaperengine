    "The wallpaper's entry page is missing from its folder." : {
      "comment" : "Web wallpaper failure reason shown when the HTML file the project names cannot be served.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wallpaper's entry page is missing from its folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta la página de entrada en la carpeta del fondo de pantalla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙のフォルダにエントリページがありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁纸文件夹里缺少入口页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌布資料夾裡缺少進入頁面。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Startseite des Hintergrundbildes fehlt in seinem Ordner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page d'entrée du fond d'écran manque de son dossier."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면의 항목 페이지가 폴더에서 누락되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
