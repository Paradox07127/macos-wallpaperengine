    "Global preferences, every display's setup, saved bookmarks, and saved schemes go back to their defaults, and connected folders are disconnected. Your wallpaper files and imported library are not deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Global preferences, every display's setup, saved bookmarks, and saved schemes go back to their defaults, and connected folders are disconnected. Your wallpaper files and imported library are not deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las preferencias globales, la configuración de cada pantalla, los marcadores y los esquemas guardados vuelven a sus valores predeterminados, y las carpetas conectadas se desconectan. Tus archivos de fondo de pantalla y la biblioteca importada no se eliminan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グローバル設定、各ディスプレイの設定、保存済みのブックマークと構成が既定に戻り、接続済みのフォルダは切断されます。壁紙ファイルとインポート済みのライブラリは削除されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全局偏好、每台显示器的配置、已保存的书签与方案将恢复为默认，已连接的文件夹会断开。壁纸文件与已导入的库不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全域偏好、每台顯示器的設定、已儲存的書籤與方案將恢復為預設，已連接的檔案夾會中斷連接。桌布檔案與已匯入的媒體庫不會被刪除。"
          }
        }
      }
    },
