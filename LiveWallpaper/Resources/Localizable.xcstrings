    "System CPU is %@ busy; Loomscreen uses %@. If the Mac slows down, quit apps you are not using." : {
      "comment" : "Status capsule sentence beside the High Load headline when CPU set it. Both placeholders are percents of the whole machine: the system's CPU in use, then this app's share.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System CPU is %@ busy; Loomscreen uses %@. If the Mac slows down, quit apps you are not using."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La CPU del sistema está al %@; Loomscreen usa el %@. Si el Mac va lento, cierra las apps que no estés usando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムの CPU 使用率は %@ で、そのうち Loomscreen が %@ を使用しています。この Mac の動作が遅くなったら、使っていないアプリを終了してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统 CPU 占用率为 %@，其中 Loomscreen 占 %@。如果本机运行变慢，请退出暂不使用的应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
