    "Playback control denied. Enable access in System Settings → Privacy & Security → Automation." : {
      "comment" : "Music inspector status when Automation access to the active music player was denied. Use the actual localized macOS settings names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback control denied. Enable access in System Settings → Privacy & Security → Automation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso al control de reproducción denegado. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Automatización."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生操作の権限が拒否されています。「システム設定 › プライバシーとセキュリティ › オートメーション」で許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
