    "Your Steam password and Steam Guard codes go to SteamCMD only — sign in from Terminal, or reuse the session Steam already cached." : {
      "comment" : "Workshop privacy point about Steam credentials.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Steam password and Steam Guard codes go to SteamCMD only — sign in from Terminal, or reuse the session Steam already cached."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña de Steam y los códigos de Steam Guard van solo a SteamCMD — inicia sesión desde Terminal, o reutiliza la sesión que Steam ya tenga en caché."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam のパスワードと Steam Guard コードは SteamCMD にのみ渡されます。ターミナルからサインインするか、Steam が既にキャッシュしたセッションを再利用してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Steam 密码和 Steam Guard 验证码只会交给 SteamCMD——在终端登录，或复用 Steam 已缓存的会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Steam 密碼和 Steam Guard 驗證碼只會交給 SteamCMD——在終端機登入，或重複使用 Steam 已快取的工作階段。"
          }
        }
      }
    },
    "Your Steam password and Steam Guard codes go to SteamCMD only. Loomscreen never stores them, and never sends them anywhere else." : {
      "comment" : "Workshop privacy statement about Steam credentials.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña de Steam y los códigos de Steam Guard van solo a SteamCMD. Loomscreen nunca los almacena ni los envía a ningún otro sitio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam のパスワードと Steam Guard コードは SteamCMD にのみ渡されます。Loomscreen が保存することも、ほかへ送信することもありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Steam 密码和 Steam 令牌验证码只会交给 SteamCMD。Loomscreen 既不保存，也不会发往别处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Steam 密碼與 Steam 令牌驗證碼只會交給 SteamCMD。Loomscreen 既不儲存，也不會傳往別處。"
          }
        }
      }
    },
    "Your Steam session expired. Sign in again in Terminal, then check again." : {
