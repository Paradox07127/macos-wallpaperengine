    "Applies to screenshots, recording, and sharing, including widgets. When off, shows the macOS desktop picture." : {
      "comment" : "Settings explanation; preserve scope and consequences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Screenshots, Aufnahmen und Bildschirmfreigaben, einschließlich Widgets. Wenn diese Option ausgeschaltet ist, erscheint der macOS-Schreibtischhintergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to screenshots, recording, and sharing, including widgets. When off, shows the macOS desktop picture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a capturas, grabaciones y pantalla compartida, incluidos los widgets. Al desactivarlo, se muestra el fondo de pantalla de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux captures d’écran, aux enregistrements et au partage d’écran, y compris aux widgets. Lorsque cette option est désactivée, le fond d’écran macOS est affiché."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショット、録画、画面共有に適用され、ウィジェットも同じ設定に従います。オフでは macOS の壁紙を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷, 녹화 및 공유(위젯 포함)에 적용됩니다. 꺼져 있을 때 macOS 데스크톱 이미지를 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se a capturas de tela, gravações e compartilhamento de tela, incluindo widgets. Quando esta opção está desativada, exibe a imagem de mesa do macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于截屏、录制和共享，小组件也遵循此设置。关闭后显示 macOS 墙纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於截圖、錄製和共享，小工具也遵循此設定。關閉後顯示 macOS 背景圖片。"
          }
        }
      }
    },
