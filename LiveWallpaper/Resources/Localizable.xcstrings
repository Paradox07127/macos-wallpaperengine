    "Automatically picks a random wallpaper from your entire library. New imports join automatically; unavailable wallpapers are skipped. The same wallpaper never plays twice in a row." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt automatisch einen zufälligen Hintergrund aus Ihrer gesamten Mediathek. Neue Importe werden einbezogen, nicht verfügbare Hintergründe übersprungen. Derselbe Hintergrund wird nie zweimal hintereinander abgespielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically picks a random wallpaper from your entire library. New imports join automatically; unavailable wallpapers are skipped. The same wallpaper never plays twice in a row."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un fondo al azar de toda la biblioteca a intervalos regulares. Los nuevos fondos se incluyen automáticamente y se omiten los no disponibles. El mismo fondo nunca se reproduce dos veces seguidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisit automatiquement un fond d’écran au hasard dans toute votre bibliothèque. Les nouveaux imports sont inclus, les fonds indisponibles sont ignorés et le même fond n’est jamais lu deux fois de suite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定した間隔でライブラリ全体から壁紙をランダムに選びます。新しく読み込んだ壁紙は自動的に対象となり、利用できない壁紙はスキップされます。同じ壁紙は連続して再生されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 라이브러리에서 배경화면을 무작위로 선택합니다. 새로 가져온 항목은 자동으로 포함되고 사용할 수 없는 항목은 건너뜁니다. 같은 배경화면이 연속으로 두 번 재생되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe um papel de parede aleatório de toda a biblioteca. Novas importações são incluídas automaticamente, itens indisponíveis são ignorados e o mesmo papel de parede nunca é reproduzido duas vezes seguidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按设定间隔从整个壁纸库随机选择壁纸。新导入的壁纸会自动加入，无法使用的壁纸会跳过，不会连续播放同一张壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按設定間隔從整個桌布庫隨機選擇桌布。新匯入的桌布會自動加入，無法使用的桌布會跳過，不會連續播放同一張桌布。"
          }
        }
      }
    },
    "Automatically recover stalled connections" : {
      "localizations" : {
