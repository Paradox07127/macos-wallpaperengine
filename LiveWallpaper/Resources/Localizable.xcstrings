    "WebKit page and resource caches. Clearing keeps cookies and website local data." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit Seiten- und Ressourcencache. Das Löschen behält Cookies und lokale Daten der Website bei."
