    "The Web API key is stored privately on this Mac and is never synced. Forgetting it here does not revoke it; do that at steamcommunity.com/dev/apikey." : {
      "comment" : "Workshop privacy point about the Steam Web API key.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Web API key is stored privately on this Mac and is never synced. Forgetting it here does not revoke it; do that at steamcommunity.com/dev/apikey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web API キーはこの Mac 内にのみ保存され、同期されません。ここで削除しても無効化はされません。無効化は steamcommunity.com/dev/apikey で行ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web API 密钥仅保存在本机，不会同步。在这里忘记它并不会吊销它——请到 steamcommunity.com/dev/apikey 吊销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web API 金鑰僅保存在本機，不會同步。在這裡忘記它並不會撤銷它——請到 steamcommunity.com/dev/apikey 撤銷。"
          }
        }
      }
    },
    "The web renderer process crashed repeatedly." : {
      "comment" : "Runtime error detail shown when an HTML wallpaper's WebKit content process keeps crashing and the retry budget is exhausted.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webレンダラープロセスが繰り返しクラッシュしました。"
