          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das System CPU ist %1$@ beschäftigt; Loomscreen verwendet %2$@. Wenn der Mac langsamer wird, beenden Sie die Anwendungen, die Sie nicht verwenden."
