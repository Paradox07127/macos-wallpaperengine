    "Playback control denied. Enable access in System Settings → Privacy & Security → Automation." : {
      "comment" : "Music inspector status when Automation access to the active music player was denied. Use the actual localized macOS settings names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback control denied. Enable access in System Settings → Privacy & Security → Automation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso al control de reproducción denegado. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Automatización."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生操作の権限が拒否されています。「システム設定 › プライバシーとセキュリティ › オートメーション」で許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放控制权限已被拒绝。可在“系统设置 › 隐私与安全性 › 自动化”中启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放控制權限遭拒。可在「系統設定 › 隱私權與安全性 › 自動化」中啟用。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabesteuerung verweigert. Den Zugriff aktivieren Sie in Systemeinstellungen › Datenschutz & Sicherheit › Automatisierung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contrôle de lecture est refusé. Activez l'accès dans Réglages Système › Confidentialité et sécurité › Automatisation."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 제어가 거부되었습니다. 시스템 설정 › 개인정보 및 보안 › 자동화에서 접근을 활성화하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controle de reprodução negado. Ative o acesso em Ajustes do Sistema › Privacidade e Segurança › Automação."
          }
        }
      }
    },
    "Playback control requires Automation permission on first use." : {
