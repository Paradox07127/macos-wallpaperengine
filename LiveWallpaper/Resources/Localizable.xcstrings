    "Renders scenes at a lower resolution; may blur text or increase power use. Changes reload wallpapers." : {
      "comment" : "MetalFX info: lower render resolution tradeoff and reload on change.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt Szenen mit einer geringeren Auflösung; kann Text verschwimmen lassen oder den Stromverbrauch erhöhen. Änderungen führen zum erneuten Laden von Hintergründen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renders scenes at a lower resolution; may blur text or increase power use. Changes reload wallpapers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderiza las escenas a menor resolución; puede difuminar el texto o aumentar el consumo. Los cambios recargan los fondos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend les scènes à plus basse résolution ; le texte peut devenir flou et la consommation peut augmenter. Les modifications rechargent les fonds d’écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンを低い解像度で描画します。文字がぼやけたり消費電力が増えたりする場合があります。変更すると壁紙を再読み込みします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면을 더 낮은 해상도로 렌더링합니다; 텍스트가 흐릿해지거나 전력 사용량이 증가할 수 있습니다. 배경화면을 다시 로드합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderiza cenas com resolução menor; pode desfocar o texto ou aumentar o consumo de energia. As alterações recarregam os papéis de parede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以较低分辨率渲染场景，可能使文字模糊或增加耗电。更改后会重新载入壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以較低解析度渲染場景，可能使文字模糊或增加耗電。更改後會重新載入桌布。"
          }
        }
      }
    },
