          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad guardan ajustes y referencias a tus archivos de fondo de pantalla, no los archivos en sí — los originales deben existir en el Mac al que restaures."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
