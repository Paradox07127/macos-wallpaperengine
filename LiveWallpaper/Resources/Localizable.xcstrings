        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestra extensión de fondos revisó esta versión de macOS y encontró una disposición que no puede manejar, así que dejó de entregar vídeos al sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
