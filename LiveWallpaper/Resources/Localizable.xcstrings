    "SteamCMD failed the launch sanity check. If macOS blocked it, clear the quarantine attribute." : {
      "comment" : "SteamCMD diagnostic (Doctor) probe label or result message.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD failed the launch sanity check. If macOS blocked it, clear the quarantine attribute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD no ha superado la comprobación de inicio. Si macOS lo ha bloqueado, elimina el atributo de cuarentena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD の起動チェックに失敗しました。macOS がブロックした場合は検疫属性を解除してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 未通过启动检查。如果是 macOS 阻止了它，请清除隔离属性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
