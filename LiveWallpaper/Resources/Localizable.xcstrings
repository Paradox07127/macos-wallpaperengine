        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar para Outros Displays"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制到其他显示器"
          }
        },
