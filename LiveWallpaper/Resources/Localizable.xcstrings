    "Playlist & Schedule" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabeliste und Zeitplan"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlist y programación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste de lecture et programmation"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリストとスケジュール"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생목록 및 일정"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista e programação"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
