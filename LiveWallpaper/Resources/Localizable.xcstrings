    "Location unavailable. Allow Location Services, or choose Manual in Settings › Integrations › Weather." : {
      "comment" : "Weather error shown when System location is selected but Core Location did not yield a coordinate and no manual city is set.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
