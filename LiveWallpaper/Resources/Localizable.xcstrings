    "Key access denied. Allow access in macOS or enter the key again." : {
      "comment" : "Settings explanation; preserve scope and consequences.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key access denied. Allow access in macOS or enter the key again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso a la clave denegado. Permite el acceso en macOS o vuelve a introducirla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーへのアクセスが拒否されました。macOS でアクセスを許可するか、キーを再入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥访问被拒绝。请在 macOS 中允许访问或重新输入密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金鑰存取遭拒。請在 macOS 中允許存取或重新輸入金鑰。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüsselzugriff verweigert. Den Zugriff in macOS erlauben oder den Schlüssel erneut eingeben."
