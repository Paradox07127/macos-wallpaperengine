    "Refracts the wallpaper through widget cards. May increase energy use." : {
      "comment" : "Liquid Glass optional help; visual effect and reversible energy tradeoff.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refracts the wallpaper through widget cards. May increase energy use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refracta el fondo a través de las tarjetas. Puede aumentar el consumo de energía."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットカード越しに壁紙が屈折します。消費電力が増える場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过小组件卡片折射壁纸，可能增加能耗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過小工具卡片折射桌布，可能增加耗電量。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflektiert das Hintergrundbild durch Widget-Karten. Kann den Energieverbrauch erhöhen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refracte le fond d’écran à travers les cartes de widgets. Peut augmenter la consommation d'énergie."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위젯 카드를 통해 배경화면을 반사합니다. 에너지 사용량을 증가시킬 수 있습니다."
          }
