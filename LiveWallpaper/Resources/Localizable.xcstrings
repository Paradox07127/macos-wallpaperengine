        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mac chauffe beaucoup. Quitter les applications que vous n'utilisez pas l'aide à le refroidir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac の温度が高くなっています。使っていないアプリを終了すると温度が下がりやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac의 온도가 높습니다. 사용하지 않는 앱을 종료하면 온도를 낮추는 데 도움이 됩니다."
          }
        },
        "pt-BR" : {
