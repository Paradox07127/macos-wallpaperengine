    "The item will be removed from the playlist. Other displays using this video keep their copy." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The item will be removed from the playlist. Other displays using this video keep their copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El elemento se eliminará de la playlist. Las demás pantallas que usen este vídeo conservan su copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目はプレイリストから削除されます。この動画を使う他のディスプレイのコピーは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该项将从播放列表移除。其他使用此视频的显示器会保留各自副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
