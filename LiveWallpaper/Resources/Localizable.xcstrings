          }
        }
      }
    },
    "The status capsule describes system load. If a wallpaper stops, check its display status and Settings › Performance for automatic pause rules. Closing this window keeps wallpapers running; the menu bar opens it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The status capsule describes system load. If a wallpaper stops, check its display status and Settings › Performance for automatic pause rules. Closing this window keeps wallpapers running; the menu bar opens it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El indicador muestra la carga del sistema. Si un fondo se detiene, revisa su estado y Ajustes › Rendimiento. Cerrar la ventana mantiene los fondos activos; vuelve desde la barra de menús."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスはシステム負荷を示します。壁紙が止まったらディスプレイの状態と「設定 › パフォーマンス」の自動停止ルールを確認してください。閉じても動作し、メニューバーから再度開けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状态胶囊显示系统负载。壁纸停止时，先检查显示器状态及“设置 › 性能”的自动暂停规则。关闭窗口后壁纸仍会运行，可从菜单栏再次打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "狀態膠囊顯示系統負載。桌布停止時，先檢查顯示器狀態及「設定 › 效能」的自動暫停規則。關閉視窗後桌布仍會執行，可從選單列再次開啟。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Statuskapsel beschreibt die Systemlast. Wenn ein Hintergrundbild stoppt, überprüfen Sie den Anzeigestatus und Einstellungen › Leistung für automatische Pause-Regeln. Das Schließen dieses Fensters lässt Hintergrundbilder weiter laufen; die Menüleiste öffnet sie erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capsule de statut décrit la charge du système. Si une image d'arrière-plan s'arrête, vérifiez son statut d'affichage et Paramètres › Performance pour les règles de pause automatique. Fermer cette fenêtre maintient les images d'arrière-plan en cours d'exécution ; la barre de menu l'ouvre à nouveau."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태 캡슐은 시스템 로드를 설명합니다. 배경화면이 중지되면 디스플레이 상태와 설정 › 성능에서 자동 중지 규칙을 확인하세요. 이 창을 닫으면 배경화면이 계속 실행됩니다; 메뉴 바가 다시 열립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cápsula de status descreve a carga do sistema. Se uma imagem de fundo parar, verifique o status de exibição dela e Configurações › Desempenho para regras de pausa automática. Fechar esta janela mantém as imagens de fundo funcionando; a barra de menu a abre novamente."
          }
        }
      }
    },
    "The Steam connector did not respond." : {
      "comment" : "Managed SteamCMD install failure: the XPC service was unreachable.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Steam connector did not respond."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El conector de Steam no ha respondido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam コネクタが応答しませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 连接器没有响应。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 連接器沒有回應。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Steam-Anschluss hat nicht geantwortet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le connecteur Steam n'a pas répondu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 커넥터가 응답하지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conector Steam não respondeu."
          }
        }
      }
    },
    "The Steam sign-in check timed out. Steam's servers may be unreachable from this network." : {
      "comment" : "Steam sign-in diagnostic when SteamCMD did not finish in time.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Steam sign-in check timed out. Steam's servers may be unreachable from this network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agotó el tiempo de espera de la comprobación de inicio de sesión de Steam. Puede que los servidores de Steam no sean accesibles desde esta red."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam のサインイン確認がタイムアウトしました。このネットワークからは Steam のサーバーに到達できない可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 登录检查超时。当前网络可能无法连接 Steam 服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 登入檢查逾時。目前網路可能無法連線至 Steam 伺服器。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Steam-Anmeldeprüfung ist abgelaufen. Die Server von Steam sind von diesem Netzwerk aus möglicherweise nicht erreichbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification de connexion Steam a expiré. Les serveurs Steam peuvent être inaccessibles depuis ce réseau."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 로그인 확인이 시간 초과되었습니다. Steam의 서버는 이 네트워크에서 접근할 수 없을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A verificação de login Steam expirou. Os servidores Steam podem não estar acessíveis a partir dessa rede."
          }
        }
      }
    },
    "The SteamCMD archive couldn't be unpacked." : {
      "comment" : "Managed SteamCMD install failure: extraction failed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
