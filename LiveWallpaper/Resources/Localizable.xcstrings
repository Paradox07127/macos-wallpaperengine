    "Steam could not be reached. Check your connection and try again." : {
      "comment" : "Subscription sync error when SteamCMD could not connect to Steam.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam konnte nicht erreicht werden. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con Steam. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam n'a pas pu être atteint. Vérifiez votre connexion et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam に接続できませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam에 도달할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam não pôde ser alcançado. Verifique sua conexão e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 Steam。请检查网络连接后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線至 Steam。請檢查網路連線後重試。"
          }
        }
      }
    },
