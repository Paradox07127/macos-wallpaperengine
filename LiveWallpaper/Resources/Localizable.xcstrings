    "Translated shader source. Up to 64 MB per schema; scenes compile it again when needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Código de shaders traducido. Hasta 64 MB por formato; las escenas lo recompilan cuando lo necesitan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変換済みシェーダーソース。形式ごとに上限 64 MB。必要なときに再コンパイルします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转译后的着色器源码，每个格式版本上限 64 MB；场景需要时重新编译。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轉譯後的著色器原始碼，每個格式版本上限 64 MB；場景需要時重新編譯。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersetzter Shader-Quellcode. Bis zu 64 MB pro Schema; Szenen kompilieren ihn erneut, wenn erforderlich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Source de shader traduite. Jusqu'à 64 Mo par schéma ; les scènes la compilent à nouveau lorsqu'elles sont nécessaires."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번역된 셰더 소스. 스키마당 최대 64 MB; 장면은 필요할 때 다시 컴파일합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
