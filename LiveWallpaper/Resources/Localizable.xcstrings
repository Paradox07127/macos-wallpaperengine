    "Backup & Restore saves settings without wallpaper files. Review the confirmation before importing a backup." : {
      "comment" : "Welcome Tour settings walkthrough or completion.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern und Wiederherstellen speichert Einstellungen ohne Hintergrunddateien. Lesen Sie die Bestätigung, bevor Sie eine Sicherung importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup & Restore saves settings without wallpaper files. Review the confirmation before importing a backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia y restauración guarda ajustes sin los archivos de los fondos. Revisa la confirmación antes de importar una copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde et restauration enregistre les réglages sans les fichiers des fonds d’écran. Lisez la confirmation avant d’importer une sauvegarde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップと復元では、壁紙ファイルを含めずに設定を保存します。バックアップの読み込み前に確認内容を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업 및 복원은 배경화면 파일 없이 설정을 저장합니다. 백업을 가져오기 전에 확인을 검토하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup e restauração salva os ajustes sem os arquivos de papel de parede. Leia a confirmação antes de importar um backup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份与恢复仅保存设置，不包含壁纸文件。导入备份前请仔细阅读确认提示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份與還原僅儲存設定，不包含桌布檔案。匯入備份前請仔細閱讀確認提示。"
          }
        }
      }
