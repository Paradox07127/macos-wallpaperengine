      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera parallax and pointer-driven effects follow your cursor. Passive — safe for desktop icon clicks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paralaje de la cámara y los efectos del puntero siguen el cursor. Pasivo — no interfiere con los clics en los iconos del escritorio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラのパララックスとポインター連動エフェクトがカーソルに追従します。受動的なのでデスクトップアイコンのクリックには影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
