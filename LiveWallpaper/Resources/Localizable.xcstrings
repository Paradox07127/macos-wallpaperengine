    "General controls language, login startup, the Dock, and the wallpaper transition and opening animation." : {
      "comment" : "Welcome Tour settings walkthrough or completion.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General controls language, login startup, the Dock, and the wallpaper transition and opening animation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General permite configurar Idioma, Abrir al iniciar sesión, Mostrar en el Dock, Transición de fondo y Animación de apertura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般設定では、言語、「ログイン時に起動」、「Dock に表示」、「壁紙の切り替え効果」、「オープニングアニメーション」を設定できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通用设置管理语言、登录时启动、在 Dock 中显示，以及换壁纸动画和开场动画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般設定管理語言、登入時啟動、在 Dock 中顯示，以及換桌布動畫和開場動畫。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allgemeine Steuerelemente wie Sprache, Login-Start, der Dock und die Übergangsvorstellung und die Öffnungsanimation des Hintergrundbildes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contrôles généraux incluent la langue, le démarrage de la connexion, le Dock, la transition d'image d'arrière-plan et l'animation d'ouverture."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반적인 컨트롤에는 언어, 로그인 시작, 도크, 배경화면 전환 및 열기 애니메이션이 포함됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os controles gerais incluem a linguagem, a inicialização de login, o Dock, a transição de papel de parede e a animação de abertura."
          }
        }
      }
    },
