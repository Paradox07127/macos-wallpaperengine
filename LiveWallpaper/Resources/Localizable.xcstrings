    "Scripted content may not display when disabled." : {
      "comment" : "JavaScript toggle tooltip. Disabling scripts can affect scripted content; do not claim that every web wallpaper becomes blank.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripted content may not display when disabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desactivarlo, el contenido basado en scripts puede no mostrarse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、スクリプトを使うコンテンツが表示されない場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
