        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion sécurisée à Steam a échoué. Un proxy ou un logiciel de sécurité peut l'intercepter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam との安全な接続に失敗しました。プロキシまたはセキュリティソフトが介在している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam으로의 보안 연결이 실패했습니다. 프록시 또는 보안 소프트웨어가 이를 가로채고 있을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão segura para Steam falhou. Um proxy ou software de segurança pode estar interceptando-a."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 Steam 的安全连接失败。可能有代理或安全软件正在拦截。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與 Steam 的安全連線失敗。可能有代理或安全軟體正在攔截。"
          }
        }
      }
    },
    "The selected display is no longer available." : {
