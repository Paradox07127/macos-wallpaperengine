          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie einen Artikel in dem untenstehenden Widget-Hinzufügungsbereich aus. Klicken Sie darauf, um ihn hinzuzufügen, oder ziehen Sie ihn auf die Leinwand; wählen Sie ihn aus, um sein Aussehen zu bearbeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un élément dans Ajouter un widget ci-dessous. Cliquez pour l'ajouter, ou faites-le glisser sur la toile ; sélectionnez-le pour modifier son apparence."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래의 위젯 추가에서 항목을 선택하세요. 추가하려면 클릭하거나 캔버스에 드래그하세요; 모양을 편집하려면 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um item em Adicionar Widget abaixo. Clique para adicioná-lo ou arraste-o para a tela; selecione-o para editar sua aparência."
          }
        }
      }
    },
