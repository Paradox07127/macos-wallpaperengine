    "Delete “%@” from this Mac’s Steam library and Loomscreen to free space. This cannot be undone; the wallpaper can be downloaded again. Steam subscriptions are unchanged." : {
      "comment" : "Destructive confirmation for a locally managed Workshop wallpaper. %@ is its title. Deletes local files, does not unsubscribe on Steam.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete “%@” from this Mac’s Steam library and Loomscreen to free space. This cannot be undone; the wallpaper can be downloaded again. Steam subscriptions are unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina «%@» de la biblioteca de Steam de este Mac y de Loomscreen para liberar espacio. No se puede deshacer, pero el fondo se puede descargar de nuevo. Las suscripciones de Steam no cambian."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac の Steam ライブラリと Loomscreen から「%@」を削除して空き容量を増やします。取り消せませんが、壁紙は再ダウンロードできます。Steam のサブスクリプションは変更されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从本机 Steam 库和 Loomscreen 删除“%@”以释放空间。此操作无法撤销，可重新下载；Steam 订阅不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從這台 Mac 的 Steam 收藏庫和 Loomscreen 刪除「%@」以釋放空間。此操作無法復原，可重新下載；Steam 訂閱不變。"
          }
        }
      }
    },
    "Deletes %@ of extracted scene video files. Scenes re-extract the video textures the next time they render." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes %@ of extracted scene video files. Scenes re-extract the video textures the next time they render."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina %@ de archivos de vídeo extraídos de las escenas. Las escenas volverán a extraer los vídeos la próxima vez que se rendericen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展開済みのシーン動画 %@ を削除します。次回描画時に動画が再展開されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除 %@ 已提取的场景视频文件。场景下次渲染时会重新提取视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將刪除 %@ 已擷取的場景影片檔案。場景下次渲染時會重新擷取影片。"
          }
        }
      }
    },
    "Deletes %@ scratch items · %@ created by test runs in the container's tmp folder. Nothing else reads them." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes %@ scratch items · %@ created by test runs in the container's tmp folder. Nothing else reads them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina %@ elementos temporales · %@ creados por las pruebas en la carpeta tmp del contenedor. Nada más los lee."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナの tmp にあるテスト残骸 %@ 件 · %@ を削除します。他からは参照されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除容器 tmp 中测试运行留下的 %@ 个临时项 · %@。没有其他组件会读取它们。"
          }
