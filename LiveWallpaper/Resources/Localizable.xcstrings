    "Applies to videos and live scenes. When the Mac is hot, in Low Power Mode or on battery, the frame rate drops or playback pauses." : {
      "comment" : "Info for the System Wallpaper playback setting.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Videos und Live-Szenen. Bei hoher Temperatur, im Stromsparmodus oder im Batteriebetrieb wird die Bildrate reduziert oder die Wiedergabe pausiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to videos and live scenes. When the Mac is hot, in Low Power Mode or on battery, the frame rate drops or playback pauses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a vídeos y escenas en directo. Si el Mac está caliente, en modo de bajo consumo o con batería, baja la frecuencia de fotogramas o se pausa la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux vidéos et aux scènes animées. Quand le Mac chauffe, utilise la batterie ou passe en mode économie d’énergie, la fréquence d’images baisse ou la lecture se met en pause."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオとライブシーンに適用されます。Mac が高温のとき、低電力モードのとき、またはバッテリー駆動中は、フレームレートが下がるか再生が一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오 및 라이브 장면에 적용됩니다. Mac이 뜨거울 때, 저전력 모드 또는 배터리 사용 시 프레임 속도가 낮아지거나 재생이 일시 중지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se a vídeos e cenas ao vivo. Quando o Mac está quente, no Modo de Baixa Energia ou com bateria, a taxa de quadros cai ou a reprodução para."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对视频和实时场景都生效。Mac 过热、处于低电量模式或使用电池时，帧率会降低或暂停播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對影片和即時場景都有效。Mac 過熱、處於低耗電模式或使用電池時，影格率會降低或暫停播放。"
          }
        }
      }
    },
    "Applies to videos. When the Mac is hot, in Low Power Mode or on battery, the frame rate drops or playback pauses." : {
      "comment" : "Info for the System Wallpaper playback setting.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Videos. Bei hoher Temperatur, im Stromsparmodus oder im Batteriebetrieb wird die Bildrate reduziert oder die Wiedergabe pausiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to videos. When the Mac is hot, in Low Power Mode or on battery, the frame rate drops or playback pauses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a vídeos. Si el Mac está caliente, en modo de bajo consumo o con batería, baja la frecuencia de fotogramas o se pausa la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux vidéos. Quand le Mac chauffe, utilise la batterie ou passe en mode économie d’énergie, la fréquence d’images baisse ou la lecture se met en pause."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオに適用されます。Mac が高温のとき、低電力モードのとき、またはバッテリー駆動中は、フレームレートが下がるか再生が一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상에 적용됩니다. Mac이 뜨겁거나 저전력 모드 또는 배터리를 사용 중이면 프레임 속도가 낮아지거나 재생이 일시 정지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se a vídeos. Quando o Mac está quente, no Modo de Baixa Energia ou usando a bateria, a taxa de quadros diminui ou a reprodução pausa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对视频生效。Mac 过热、处于低电量模式或使用电池时，帧率会降低或暂停播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
