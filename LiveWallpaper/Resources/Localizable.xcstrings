    "Clicks and scrolls go to the web page instead of desktop icons and the desktop context menu on this display. Turn off Interaction to restore desktop clicks." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicks and scrolls go to the web page instead of desktop icons and the desktop context menu on this display. Turn off Interaction to restore desktop clicks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clics y el desplazamiento se envían a la página web y no a los iconos ni al menú contextual del escritorio de esta pantalla. Desactiva Interacción para restaurar los clics en el escritorio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックとスクロールは Web ページに送られ、このディスプレイのデスクトップアイコンとコンテキストメニューを操作できなくなります。「インタラクション」をオフにすると元に戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击和滚动将由网页接收，此显示器上的桌面图标和桌面右键菜单将无法使用。关闭“交互”可恢复桌面点击。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按與捲動將由網頁接收，此顯示器上的桌面圖示與桌面快捷選單將無法使用。關閉「互動」可恢復桌面點按。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicks und Scrollen gehen zur Webseite anstatt zu Desktop-Symbolen und zum Kontextmenü auf dem Desktop auf dieser Anzeige. Deaktivieren Sie die Interaktion, um Klicks auf dem Desktop wiederherzustellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clics et les défilements se déplacent vers la page Web au lieu des icônes du bureau et du menu contextuel du bureau sur cet écran. Désactivez l'interaction pour restaurer les clics du bureau."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디스플레이에서는 클릭과 스크롤이 데스크톱 아이콘과 데스크톱 컨텍스트 메뉴 대신 웹 페이지로 이동합니다. 데스크톱 클릭을 복원하려면 상호작용을 끄세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cliques e rolagens vão para a página da web em vez dos ícones do desktop e do menu de contexto do desktop nesta tela. Desative a Interação para restaurar os cliques do desktop."
          }
        }
      }
    },
