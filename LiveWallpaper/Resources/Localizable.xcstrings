    "Generate your key only at steamcommunity.com/dev/apikey. Never paste a key from a third-party site or installer." : {
      "comment" : "Anti-phishing card body in the API key entry sheet.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera tu clave solo en steamcommunity.com/dev/apikey. Nunca pegues una clave de un sitio o instalador de terceros."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーは steamcommunity.com/dev/apikey でのみ生成してください。第三者のサイトやインストーラーから渡されたキーは絶対に貼り付けないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在 steamcommunity.com/dev/apikey 生成密钥。绝不要粘贴第三方网站或安装器给的密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
