    "Performance controls automatic pausing and memory use. Adjust these options to suit your Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter „Leistung“ stellen Sie automatisches Pausieren und Speichernutzung passend zu Ihrem Mac ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance controls automatic pausing and memory use. Adjust these options to suit your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendimiento controla la pausa automática y el uso de memoria. Ajusta estas opciones a tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performances règle la pause automatique et l’utilisation de la mémoire. Adaptez ces options à votre Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パフォーマンスでは、自動一時停止とメモリ使用量を設定できます。お使いの Mac に合わせて調整してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성능에서는 자동 일시 정지 및 메모리 사용을 제어합니다. Mac에 맞게 조절하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desempenho controla a pausa automática e o uso de memória. Ajuste essas opções conforme o seu Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "性能设置管理自动暂停和内存使用。请按你的 Mac 情况调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "效能設定管理自動暫停和記憶體使用。請依你的 Mac 狀況調整。"
          }
        }
      }
    },
    "Performance controls automatic pausing, adaptive frame rate and memory use. Adjust these options to suit your Mac." : {
      "comment" : "Welcome Tour settings walkthrough or completion.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter „Leistung“ stellen Sie automatisches Pausieren, adaptive Bildrate und Speichernutzung passend zu Ihrem Mac ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance controls automatic pausing, adaptive frame rate and memory use. Adjust these options to suit your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendimiento controla la pausa automática, la frecuencia de fotogramas adaptativa y el uso de memoria. Ajusta estas opciones a tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performances règle la pause automatique, la fréquence d’images adaptative et l’utilisation de la mémoire. Adaptez ces options à votre Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パフォーマンスでは、自動一時停止、適応フレームレート、メモリ使用量を設定できます。お使いの Mac に合わせて調整してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성능에서는 자동 일시 정지, 적응형 프레임 속도 및 메모리 사용을 제어합니다. Mac에 맞게 조절하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desempenho controla a pausa automática, a taxa de quadros adaptável e o uso de memória. Ajuste essas opções conforme o seu Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "性能设置管理自动暂停、自适应帧率和内存使用，可根据你的 Mac 调整这些选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "效能設定管理自動暫停、適應性影格率和記憶體使用量，可依照你的 Mac 調整這些選項。"
          }
        }
      }
    },
