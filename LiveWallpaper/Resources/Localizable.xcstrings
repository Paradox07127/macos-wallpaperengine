    "panel.message.apple_aerials_access" : {
      "comment" : "Message shown in the folder picker for granting access to Apple's wallpaper folder.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS erfordert eine einmalige Genehmigung, um den Apple-Hintergrundbildordner zu lesen. Klicken Sie auf „Zugriff gewähren“ – Sie müssen keine bestimmte Datei auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS requires one-time approval to read Apple's wallpaper folder. Click \"Grant Access\" — you do not need to pick any specific file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS requiere una autorización única para leer la carpeta de fondos de Apple. Haz clic en \"Conceder acceso\" — no hace falta elegir ningún archivo concreto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS demande une autorisation pour lire le dossier des fonds d’écran Apple. Cliquez sur « Autoriser l’accès » ; vous n’avez pas à choisir un fichier précis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS では Apple の壁紙フォルダを読み取るために一度だけ承認が必要です。「アクセスを許可」をクリックしてください。特定のファイルを選ぶ必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS는 Apple의 배경화면 폴더를 읽기 위해 일회성 승인이 필요합니다. \"접근 허가\"를 클릭하세요 — 특정 파일을 선택할 필요가 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS requer aprovação única para ler a pasta de papel de parede da Apple. Clique em \"Conceder Acesso\" — você não precisa selecionar nenhum arquivo específico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 需要一次性授权才能读取 Apple 的壁纸文件夹。点击“授予访问权限”即可，无需选择任何特定文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 需要一次性授權才能讀取 Apple 的桌布資料夾。按一下「授予存取權」即可，不需要選取特定檔案。"
          }
        }
      }
    },
