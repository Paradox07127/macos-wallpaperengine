    "Pauses only displays with a visible app window, even a small one. Other displays keep playing. Resumes when the last window is minimized, closed, or moved away." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert nur Monitore mit einem sichtbaren App-Fenster, auch einem kleinen. Andere Monitore spielen weiter. Die Wiedergabe wird fortgesetzt, wenn das letzte Fenster minimiert, geschlossen oder auf einen anderen Monitor verschoben wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauses only displays with a visible app window, even a small one. Other displays keep playing. Resumes when the last window is minimized, closed, or moved away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa solo las pantallas con una ventana de una app visible, aunque sea pequeña. Las demás siguen reproduciendo. Se reanuda al minimizar, cerrar o mover fuera la última ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met en pause uniquement les moniteurs où une fenêtre d’app est visible, même petite. Les autres continuent la lecture. La lecture reprend quand la dernière fenêtre est réduite, fermée ou déplacée ailleurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さなウインドウでも、アプリのウインドウが表示されているディスプレイだけを一時停止します。他のディスプレイでは再生を続けます。最後のウインドウを最小化、閉じる、または移動すると再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 창이라도 앱 창이 표시된 디스플레이만 일시 정지합니다. 다른 디스플레이는 계속 재생합니다. 마지막 창이 최소화되거나 닫히거나 다른 디스플레이로 이동하면 재생을 재개합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa somente os monitores com uma janela de app visível, mesmo pequena. Os outros continuam reproduzindo. A reprodução retoma quando a última janela é minimizada, fechada ou movida para outro monitor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅暂停有可见应用窗口的显示器，即使窗口很小。其他显示器继续播放。最后一个窗口最小化、关闭或移走后恢复播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只暫停有可見 App 視窗的顯示器，即使視窗很小。其他顯示器繼續播放。最後一個視窗最小化、關閉或移走後恢復播放。"
          }
        }
      }
    },
    "Pauses when windows cover about %@ of the display; resumes when the desktop is revealed." : {
      "comment" : "Pause threshold. %@ is a locale-formatted percentage, currently 85 percent.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert, wenn sich die Fenster etwa %@ des Bildschirms bedecken; wird fortgesetzt, wenn der Desktop angezeigt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauses when windows cover about %@ of the display; resumes when the desktop is revealed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa cuando las ventanas cubren aproximadamente el %@ de la pantalla y se reanuda al mostrar el escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'arrête lorsque les fenêtres couvrent environ %@ de l'écran ; reprend lorsqu'un bureau est révélé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウがディスプレイの約 %@ を覆うと一時停止し、デスクトップが見えると再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창이 디스플레이의 약 %@을 덮을 때 일시 중지됩니다; 데스크톱이 드러나면 다시 시작됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa quando as janelas cobrem cerca de %@ da tela; recomeça quando a área de trabalho é revelada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口遮挡显示器约 %@ 时暂停，露出桌面后恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示器被遮擋約 %@ 時暫停，露出桌面後恢復。"
          }
        }
      }
    },
