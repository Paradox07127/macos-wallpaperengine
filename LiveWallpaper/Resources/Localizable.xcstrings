    },
    "This allows the wallpaper to run scripts, use local storage, and access WebGPU. Only trust origins you recognize." : {
      "comment" : "Body text of the Trust confirmation dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This allows the wallpaper to run scripts, use local storage, and access WebGPU. Only trust origins you recognize."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto permite que el fondo de pantalla ejecute scripts, use almacenamiento local y acceda a WebGPU. Confía solo en orígenes que reconozcas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙がスクリプトの実行、ローカルストレージの使用、WebGPU へのアクセスを行えるようになります。信頼できるオリジンのみを許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将允许壁纸运行脚本、使用本地存储和访问 WebGPU。仅信任你认识的来源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將允許桌布執行腳本、使用本機儲存空間並存取 WebGPU。只信任你認得的來源。"
          }
        }
      }
    },
    "This allows the wallpaper to run scripts, use local storage, and access WebGPU. This address is plain HTTP on your local network, so anyone else on that network could change what it sends." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This allows the wallpaper to run scripts, use local storage, and access WebGPU. This address is plain HTTP on your local network, so anyone else on that network could change what it sends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto permite que el fondo de pantalla ejecute scripts, use almacenamiento local y acceda a WebGPU. Esta dirección es HTTP sin cifrar en tu red local, así que cualquiera en esa red podría cambiar lo que envía."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙がスクリプトの実行、ローカルストレージの使用、WebGPU へのアクセスを行えるようになります。このアドレスはローカルネットワーク上の平文 HTTP のため、同じネットワーク上の他者が内容を変更できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将允许壁纸运行脚本、使用本地存储并访问 WebGPU。该地址是局域网上的明文 HTTP，同一网络中的其他人可以更改它发送的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將允許桌布執行腳本、使用本機儲存空間並存取 WebGPU。該位址是區域網路上的明文 HTTP，同一網路中的其他人可以更改它傳送的內容。"
          }
        }
      }
    },
    "This configuration is for a different app (%@). Expected %@." : {
      "comment" : "Import failure: bundle identifier doesn't match.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This configuration is for a different app (%1$@). Expected %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta configuración es para otra app (%1$@). Se esperaba %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この構成は別のアプリ（%1$@）用です。想定：%2$@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配置适用于其他应用（%1$@）。预期为 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此設定適用於其他 App（%1$@）。預期為 %2$@。"
          }
        }
      }
    },
    "This configuration was made with a different version (schema %lld). This build supports schema 1 through %lld." : {
      "comment" : "Import failure: schema is outside the supported range.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This configuration was made with a different version (schema %1$lld). This build supports schema 1 through %2$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta configuración se creó con una versión distinta (schema %1$lld). Esta compilación admite schema 1 a %2$lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この構成は別のバージョン（スキーマ %1$lld）で作成されています。このビルドはスキーマ 1 から %2$lld まで対応しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配置由其他版本创建（架构 %1$lld）。此版本支持架构 1 到 %2$lld。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此設定是以不同版本建立的（結構描述 %1$lld）。此版本支援結構描述 1 到 %2$lld。"
          }
        }
      }
    },
    "This copy of Loomscreen plays video and web wallpapers. Drop one of those instead." : {
      "comment" : "Drop failure message when a scene is dropped on a build with no scene renderer.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This copy of Loomscreen plays video and web wallpapers. Drop one of those instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de Loomscreen reproduce fondos de pantalla de vídeo y web. Suelta uno de esos en su lugar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Loomscreen は動画壁紙と Web 壁紙を再生できます。いずれかをドロップしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个 Loomscreen 可播放视频壁纸和网页壁纸。请改拖入其中一种。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個 Loomscreen 可播放影片桌布和網頁桌布。請改拖入其中一種。"
          }
        }
      }
    },
    "This creator hasn't published any wallpapers here." : {
      "comment" : "Empty creator-scoped Workshop browse, name unknown.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este creador no ha publicado ningún fondo de pantalla aquí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この作成者はここで壁紙をまだ公開していません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此创作者尚未在这里发布任何壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此創作者尚未在這裡發布任何桌布。"
          }
        }
      }
    },
    "This deletes the downloaded assets from this Mac. You can download them again anytime." : {
      "comment" : "Remove-engine-assets confirmation message.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina los recursos descargados de este Mac. Puedes volver a descargarlos cuando quieras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac からダウンロード済みのアセットを削除します。いつでも再ダウンロードできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从该 Mac 删除已下载的资源。你随时可以重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會從此 Mac 刪除已下載的資源。你隨時可以重新下載。"
          }
        }
      }
    },
    "This file is too large to import (%lld bytes). Configuration backups are usually well under 10 MB." : {
      "comment" : "Import failure: the file exceeds the size cap and is likely not a real config bundle.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file is too large to import (%lld bytes). Configuration backups are usually well under 10 MB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo es demasiado grande para importarlo (%lld bytes). Las copias de seguridad de configuración suelen estar muy por debajo de 10 MB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは大きすぎてインポートできません（%lld バイト）。構成バックアップは通常 10 MB を大きく下回ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件太大，无法导入（%lld 字节）。配置备份通常远小于 10 MB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案太大，無法匯入（%lld 位元組）。設定備份通常遠小於 10 MB。"
          }
        }
      }
    },
    "This format requires Metal-backed GPU decoding that this Mac doesn't support. Try rendering on a newer GPU." : {
      "comment" : "Wallpaper Engine fallback warning body.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This format requires Metal-backed GPU decoding that this Mac doesn't support. Try rendering on a newer GPU."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este formato requiere decodificación GPU con Metal, que este Mac no admite. Prueba a renderizar en una GPU más reciente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この形式には Metal ベースの GPU デコードが必要ですが、この Mac では対応していません。より新しい GPU でレンダリングしてみてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此格式需要此 Mac 不支持的 Metal GPU 解码。请尝试在较新的 GPU 上渲染。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此格式需要 Metal 支援的 GPU 解碼，但這台 Mac 不支援。請嘗試在較新的 GPU 上渲染。"
          }
        }
      }
    },
    "This installs SteamCMD only. It does not sign you in to Steam, and you can remove it again from Settings." : {
      "comment" : "Managed SteamCMD install consent footnote.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto instala solo SteamCMD. No inicia sesión en Steam, y puedes volver a eliminarlo desde Ajustes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールされるのは SteamCMD だけです。Steam へのサインインは行われず、設定からいつでも削除できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会安装 SteamCMD。不会登录 Steam，之后可以在设置里删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會安裝 SteamCMD。不會登入 Steam，之後可以在設定裡移除。"
          }
        }
      }
    },
    "This is a Windows-only wallpaper and can't run on macOS." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este fondo de pantalla es solo para Windows y no puede ejecutarse en macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは Windows 専用の壁紙で、macOS では実行できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是仅限 Windows 的壁纸，无法在 macOS 上运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是僅限 Windows 的桌布，無法在 macOS 上執行。"
          }
        }
      }
    },
    "This is not an unlock-restore option. When the screen locks, enabled video displays capture their current frame and set it as the macOS desktop picture. The desktop picture remains changed after unlock." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not an unlock-restore option. When the screen locks, enabled video displays capture their current frame and set it as the macOS desktop picture. The desktop picture remains changed after unlock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta no es una opción de restauración al desbloquear. Al bloquearse la pantalla, las pantallas de vídeo activadas capturan el fotograma actual y lo establecen como la imagen de escritorio de macOS. La imagen de escritorio permanece cambiada después de desbloquear."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはロック解除後の復元機能ではありません。画面をロックすると、有効にしたビデオディスプレイの現在のフレームをキャプチャし、macOS のデスクトップピクチャに設定します。ロック解除後もデスクトップピクチャは変更されたままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这不是解锁后恢复功能。屏幕锁定时，已启用的视频显示器会捕获当前画面并设为 macOS 桌面图片；解锁后桌面图片仍会保持此更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這不是解鎖後復原功能。螢幕鎖定時，已啟用的影片顯示器會擷取目前影格並設為 macOS 桌面圖片；解鎖後桌面圖片仍會保留此變更。"
          }
        }
      }
    },
    "This is the only wallpaper in the playlist. Removing it will clear the wallpaper on %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the only wallpaper in the playlist. Removing it will clear the wallpaper on %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este es el único fondo de pantalla de la lista de reproducción. Al eliminarlo, se quitará el fondo de pantalla de %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリスト内の唯一の壁紙です。削除すると %@ の壁紙がクリアされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是播放列表中唯一的壁纸。移除后将清除 %@ 上的壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是播放清單中唯一的桌布。移除後將清除 %@ 上的桌布。"
          }
        }
      }
    },
    "This item is no longer available on Steam." : {
      "comment" : "Workshop download failed: item removed from Steam.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este elemento ya no está disponible en Steam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアイテムは Steam で利用できなくなりました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项目已不再可在 Steam 上获取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此項目已不再可在 Steam 上取得。"
          }
        }
      }
    },
    "This item is private or friends-only and can't be previewed here." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This item is private or friends-only and can't be previewed here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este elemento es privado o solo para amigos y no se puede previsualizar aquí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアイテムは非公開またはフレンド限定のため、ここではプレビューできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项目为私密或仅好友可见，无法在此预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此項目為私人或僅好友可見，無法在此預覽。"
          }
        }
      }
    },
    "This lets you click elements inside the scene, but while it's on you can't click desktop icons or right-click the desktop on this display. Turn it off here to restore desktop clicks." : {
      "comment" : "A message that appears when the user enables",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto te permite hacer clic en elementos de la escena, pero mientras está activado no puedes hacer clic en los iconos del escritorio ni hacer clic derecho en el escritorio de esta pantalla. Desactívalo aquí para restaurar los clics del escritorio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン内の要素をクリックできるようになりますが、オンの間はこのディスプレイでデスクトップアイコンをクリックしたり、デスクトップを右クリックしたりできません。デスクトップクリックを戻すにはここでオフにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这允许你点击场景内元素，但开启时无法点击此显示器上的桌面图标，也无法右键点击桌面。在这里关闭即可恢复桌面点击。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這允許你點按場景內元素，但開啟時無法點按此顯示器上的桌面圖示，也無法右鍵點按桌面。在這裡關閉即可恢復桌面點按。"
          }
        }
      }
    },
    "This replaces the %1$@ overlay on %2$lld other displays. Their wallpapers are left alone." : {
      "comment" : "Confirmation message. Placeholders are the overlay's name and the number of other displays.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This replaces the %1$@ overlay on %2$lld other displays. Their wallpapers are left alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto reemplaza la superposición %1$@ en %2$lld pantallas más. Sus fondos de pantalla no se tocan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他の %2$lld 台のディスプレイの %1$@ オーバーレイを置き換えます。壁紙はそのままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会替换另外 %2$lld 台显示器上的%1$@叠加层，它们的壁纸不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會取代另外 %2$lld 台顯示器上的%1$@疊加層，它們的桌布不受影響。"
          }
        }
      }
    },
    "This replaces the wallpaper on %@ other displays with the same content and settings as this one." : {
