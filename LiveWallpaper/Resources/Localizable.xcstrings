    "Steam didn't confirm the sign-in in time. If Steam Guard asked on your phone, approve it and try again." : {
      "comment" : "In-app Steam sign-in failure.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam didn't confirm the sign-in in time. If Steam Guard asked on your phone, approve it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam no ha confirmado el inicio de sesión a tiempo. Si Steam Guard lo ha pedido en el teléfono, apruébalo e inténtalo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam が時間内にサインインを確認しませんでした。携帯電話に Steam Guard の確認が来ていたら、承認してからもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 未在限时内确认登录。如手机上有 Steam Guard 确认请求，请先通过再重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 未在限時內確認登入。如手機上有 Steam Guard 確認請求，請先核准再重試。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam hat das Anmelden nicht rechtzeitig bestätigt. Wenn Steam Guard auf Ihrem Telefon gefragt hat, genehmigen Sie es und versuchen Sie es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam n'a pas confirmé la connexion à temps. Si Steam Guard vous a demandé sur votre téléphone, approuvez-le et réessayez."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam이 로그인 시간을 놓쳤습니다. Steam Guard이 휴대폰으로 물어보면 승인하고 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam não confirmou o login a tempo. Se Steam Guard perguntou no seu telefone, aprove e tente novamente."
          }
        }
      }
    },
