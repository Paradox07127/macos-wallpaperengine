        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” se quitará de todas las pantallas que lo usen. Tus propios cambios sobre él se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はこれを使用しているすべてのディスプレイから削除されます。その上で加えた変更は保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从所有正在使用它的显示器上移除。你在它之上做的改动会保留。"
