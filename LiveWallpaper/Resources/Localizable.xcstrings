    "Workshop requests go straight to Valve over HTTPS. Nothing is sent to Loomscreen." : {
      "comment" : "Workshop privacy point about where network requests go.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workshop requests go straight to Valve over HTTPS. Nothing is sent to Loomscreen."
