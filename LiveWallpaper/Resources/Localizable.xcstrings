    "Reset restores the default widgets. Import replaces all widgets and widget options." : {
      "comment" : "Visible consequence beside the layout Reset and Import buttons. Reset restores the default widgets; Import also replaces the Widget Options settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset stellt die Standard-Widgets wieder her. Import ersetzt alle Widgets und Widget-Optionen."
          }
        },
        "en" : {
