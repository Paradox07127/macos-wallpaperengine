    "SteamCMD failed the launch sanity check. If macOS blocked it, clear the quarantine attribute." : {
      "comment" : "SteamCMD diagnostic (Doctor) probe label or result message.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD hat die Startprüfung nicht bestanden. Falls macOS den Start blockiert, entfernen Sie das Quarantäneattribut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD failed the launch sanity check. If macOS blocked it, clear the quarantine attribute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD no ha superado la comprobación de inicio. Si macOS lo ha bloqueado, elimina el atributo de cuarentena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD a échoué au contrôle de la cohérence du lancement. Si macOS l'a bloqué, supprimez l'attribut de quarantaine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD の起動チェックに失敗しました。macOS がブロックした場合は検疫属性を解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD가 런칭 사후 검사를 통과하지 못했습니다. macOS가 차단했다면 격리 속성 설정을 제거하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD falhou no check de sanidade de lançamento. Se macOS o bloqueou, limpe o atributo de quarentena."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 未通过启动检查。如果是 macOS 阻止了它，请清除隔离属性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 未通過啟動檢查。如果是 macOS 封鎖了它，請清除隔離屬性。"
          }
        }
      }
    },
