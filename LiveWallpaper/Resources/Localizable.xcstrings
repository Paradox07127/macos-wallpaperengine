    "Your Steam password and Steam Guard codes go to SteamCMD only. Loomscreen never stores them, and never sends them anywhere else." : {
      "comment" : "Workshop privacy statement about Steam credentials.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Steam-Passwort und Ihre Steam-Guard-Codes werden nur an SteamCMD übergeben. Loomscreen speichert sie niemals und sendet sie nirgendwo anders hin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña de Steam y los códigos de Steam Guard van solo a SteamCMD. Loomscreen nunca los almacena ni los envía a ningún otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
