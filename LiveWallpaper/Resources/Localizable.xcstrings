    "When frontmost" : {
      "comment" : "A label for a picker that lets the user choose whether to pause the wallpaper while the app is in the foreground or while it's running.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最前面にあるとき"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
