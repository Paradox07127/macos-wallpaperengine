    "Other wallpaper features are unaffected. Try again after updating macOS or Loomscreen." : {
      "comment" : "Compatibility recovery suggestion; does not promise that an update fixes the issue.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Hintergrundbildfunktionen werden nicht beeinträchtigt. Versuchen Sie es erneut, nachdem Sie macOS oder Loomscreen aktualisiert haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other wallpaper features are unaffected. Try again after updating macOS or Loomscreen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las demás funciones de fondos no se ven afectadas. Vuelve a intentarlo tras actualizar macOS o Loomscreen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres fonctionnalités de l'arrière-plan ne sont pas affectées. Réessayez après avoir mis à jour macOS ou Loomscreen."
          }
        },
        "ja" : {
          "stringUnit" : {
