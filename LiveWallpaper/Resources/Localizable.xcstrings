    "Use Restart Wallpaper Service below to rebuild the system connection." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Restart Wallpaper Service below to rebuild the system connection."
          }
        },
