    "Video copies freeze live information. Web recording opens a preview and may ask for screen recording access." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video copies freeze live information. Web recording opens a preview and may ask for screen recording access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de vídeo congelan la información en directo. La grabación web abre una vista previa y puede solicitar permiso para grabar la pantalla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画コピーではライブ情報が固定されます。Web録画ではプレビューが開き、画面収録の許可が必要な場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频副本会固定实时信息。网页录制会打开预览，并可能请求录屏权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片副本會固定即時資訊。網頁錄製會開啟預覽，並可能要求螢幕錄製權限。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videokopien frieren Live-Informationen ein. Die Webaufzeichnung öffnet eine Vorschau und kann nach Zugriff auf die Bildschirmaufnahme fragen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies vidéo figent les informations en direct. L'enregistrement Web ouvre une vue d'ensemble et peut demander l'accès à l'enregistrement d'écran."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오 복사본은 실시간 정보를 얼리게 합니다. 웹 녹화는 미리보기를 열고 화면 녹화 액세스를 요청할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cópias de vídeo congelam as informações em tempo real. A gravação na web abre uma prévia e pode solicitar acesso à gravação de tela."
          }
        }
      }
    },
    "Video copies used by macOS. Remove videos from System Wallpaper to free space." : {
      "comment" : "System wallpaper storage info; only copies, not originals.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video copies used by macOS. Remove videos from System Wallpaper to free space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copias de vídeo que usa macOS. Elimina vídeos de Fondo del sistema para liberar espacio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS が使用する動画のコピーです。「システム壁紙」から動画を削除すると容量を解放できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 使用的视频副本。从“系统壁纸”中移除视频可释放空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 使用的影片副本。從「系統桌布」中移除影片可釋出空間。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von macOS verwendete Videokopien. Videos vom Systemhintergrundbild entfernen, um freien Speicherplatz zu sparen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies vidéo utilisées par macOS. Supprimez les vidéos de l'arrière-plan du système pour libérer de l'espace."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacOS에서 사용되는 비디오 사본. 시스템 배경화면에서 비디오를 제거하여 무료 공간을 확보하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cópias de vídeo usadas por macOS. Remova os vídeos do papel de parede do Sistema para liberar espaço."
          }
        }
      }
    },
