          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa «Reiniciar servicio de fondos» para restablecer la conexión."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下の「壁紙サービスを再起動」でシステム接続を再確立してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
