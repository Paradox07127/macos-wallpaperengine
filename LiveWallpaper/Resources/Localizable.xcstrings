        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解开的文件里没有 SteamCMD 程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解開的檔案裡沒有 SteamCMD 程式。"
          }
        }
      }
    },
    "The unpacked program isn't signed by Valve, so it was not installed." : {
      "comment" : "Managed SteamCMD install failure: code signature check failed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The unpacked program isn't signed by Valve, so it was not installed."
