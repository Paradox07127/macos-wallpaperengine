    "Reduces scene resolution; may use more power in lightweight scenes. Changes reload wallpapers." : {
      "comment" : "Settings explanation; preserve scope and consequences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verringert die Szenenauflösung; kann bei einfachen Szenen mehr Energie verbrauchen. Änderungen laden die Hintergründe neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduces scene resolution; may use more power in lightweight scenes. Changes reload wallpapers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce la resolución de la escena; puede consumir más energía en escenas sencillas. Los cambios recargan los fondos de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduit la résolution des scènes ; peut consommer plus d’énergie pour les scènes peu complexes. Les modifications rechargent les fonds d’écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンの解像度を下げます。処理の軽いシーンでは消費電力が増える場合があります。変更すると壁紙を再読み込みします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면 해상도를 낮춥니다. 단순한 장면에서는 전력 사용량이 늘어날 수 있습니다. 변경하면 배경화면을 다시 로드합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduz a resolução da cena; pode consumir mais energia em cenas simples. As alterações recarregam os papéis de parede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低场景分辨率；在低复杂度场景中可能更耗电。更改后会重新加载壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
