    "How much wallpaper shows through the widget cards. Bottoms out well above zero — a fully transparent card leaves text floating unreadably over the wallpaper." : {
      "comment" : "Widget opacity tooltip.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much wallpaper shows through the widget cards. Bottoms out well above zero — a fully transparent card leaves text floating unreadably over the wallpaper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto se transparenta el fondo de pantalla a través de las tarjetas widget. El mínimo queda claramente por encima de cero — una tarjeta totalmente transparente deja el texto flotando e ilegible sobre el fondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットカード越しに壁紙がどれだけ透けるか。完全な透明にはできません — 文字が壁紙の上に浮いて読めなくなるためです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁纸透过组件卡片的程度。下限明显高于零——完全透明会让文字浮在壁纸上无法阅读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌布透過元件卡片的程度。下限明顯高於零——完全透明會讓文字浮在桌布上無法閱讀。"
          }
        }
      }
    },
    "How often the instruments sample" : {
      "comment" : "Monitor inspector: refresh-rate row subtitle.",
