    "Your Steam password and Steam Guard codes go to SteamCMD only. Loomscreen never stores them, and never sends them anywhere else." : {
      "comment" : "Workshop privacy statement about Steam credentials.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña de Steam y los códigos de Steam Guard van solo a SteamCMD. Loomscreen nunca los almacena ni los envía a ningún otro sitio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam のパスワードと Steam Guard コードは SteamCMD にのみ渡されます。Loomscreen が保存することも、ほかへ送信することもありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Steam 密码和 Steam 令牌验证码只会交给 SteamCMD。Loomscreen 既不保存，也不会发往别处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Steam 密碼與 Steam 令牌驗證碼只會交給 SteamCMD。Loomscreen 既不儲存，也不會傳往別處。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Passwort Steam und die Steam Guard-Codes gehen nur an SteamCMD. Loomscreen speichert sie niemals und sendet sie niemals an andere Stellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe Steam et vos codes Steam Guard ne sont utilisés que par SteamCMD. Loomscreen ne les stocke jamais et ne les envoie nulle part ailleurs."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하의 Steam 비밀번호와 Steam Guard 코드는 SteamCMD에만 저장됩니다. Loomscreen은 절대 그것들을 저장하지 않으며, 다른 곳으로 절대 보내지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha Steam e os códigos Steam Guard vão para SteamCMD apenas. Loomscreen nunca os armazena e nunca os envia para nenhum outro lugar."
          }
        }
      }
    }
  },
  "version" : "1.1"
