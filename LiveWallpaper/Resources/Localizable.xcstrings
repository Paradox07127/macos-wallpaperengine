    "Selected files and folders will need to be re-granted on this Mac because security bookmarks are device-specific." : {
      "comment" : "Import confirmation footer warning about cross-device bookmark portability.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selected files and folders will need to be re-granted on this Mac because security bookmarks are device-specific."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュリティブックマークはデバイス固有のため、選択したファイルとフォルダはこの Mac で再許可が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于安全书签与设备相关，所选文件和文件夹需要在这台 Mac 上重新授权。"
          }
        },
        "zh-Hant" : {
