    "Longer sampling intervals use less energy." : {
      "comment" : "Monitor refresh interval help; longer intervals reduce energy use.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longer sampling intervals use less energy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los intervalos de muestreo más largos reducen el consumo de energía."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンプリング間隔を長くすると消費電力を抑えられます。"
