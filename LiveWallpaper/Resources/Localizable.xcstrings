    "SteamCMD is still preparing or could not reach Steam. Check your connection and choose Locate automatically to retry." : {
      "comment" : "First-run SteamCMD timeout recovery inside the app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD is still preparing or could not reach Steam. Check your connection and choose Locate automatically to retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD sigue preparándose o no pudo conectar con Steam. Comprueba la conexión y elige Localizar automáticamente para reintentarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD は準備中か、Steam に接続できませんでした。接続を確認し、「自動検出」を選んで再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 仍在准备中，或暂时无法连接 Steam。请检查网络连接，然后点按“自动查找”重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 仍在準備中，或暫時無法連線至 Steam。請檢查網路連線，然後按一下「自動尋找」重試。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD bereitet sich noch vor oder konnte Steam nicht erreichen. Überprüfen Sie Ihre Verbindung und wählen Sie Automatisch lokalisieren, um es erneut zu versuchen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD est encore en cours de préparation ou n'a pas pu atteindre Steam. Vérifiez votre connexion et choisissez Localiser automatiquement pour réessayer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD이 아직 준비 중이거나 Steam에 도달할 수 없었습니다. 연결을 확인하고 자동으로 위치를 찾기를 선택하여 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD ainda está se preparando ou não conseguiu alcançar Steam. Verifique sua conexão e escolha Localizar automaticamente para tentar novamente."
          }
        }
      }
    },
    "SteamCMD is still updating itself and hasn't printed the Valve identity banner yet. Wait for the update to finish, then run this probe again." : {
      "comment" : "SteamCMD diagnostic (Doctor) probe label or result message.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD is still updating itself and hasn't printed the Valve identity banner yet. Wait for the update to finish, then run this probe again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD sigue actualizándose y aún no ha mostrado el banner de identidad de Valve. Espera a que termine la actualización y vuelve a ejecutar esta comprobación."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD は自己更新中で、まだ Valve の識別バナーを出力していません。更新の完了後にもう一度このチェックを実行してください。"
          }
        },
        "zh-Hans" : {
