    "Texture format %lld is unsupported. The renderer skips this layer and continues rendering the rest of the scene." : {
      "comment" : "Texture fallback warning body. The placeholder is a texture format code.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texture format %lld is unsupported. The renderer skips this layer and continues rendering the rest of the scene."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El formato de textura %lld no es compatible. El renderizador omite esta capa y continúa renderizando el resto de la escena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テクスチャ形式 %lld はサポートされていません。レンダラーはこのレイヤーをスキップし、シーンの残りを引き続きレンダリングします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持纹理格式 %lld。渲染器会跳过该图层，并继续渲染场景的其余部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援紋理格式 %lld。算繪器會略過此圖層，並繼續算繪場景的其餘部分。"
          }
        }
      }
    },
