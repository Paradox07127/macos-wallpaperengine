    "Removes %@ of reclaimable cache files. Active wallpapers keep their source assignments and rebuild cached files when needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes %@ of reclaimable cache files. Active wallpapers keep their source assignments and rebuild cached files when needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina %@ de archivos de caché recuperables. Los fondos de pantalla activos conservan sus orígenes y reconstruyen los archivos en caché cuando hace falta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回収可能なキャッシュ %@ を削除します。アクティブな壁紙のソース指定は保持され、必要時に再構築されます。"
          }
        },
