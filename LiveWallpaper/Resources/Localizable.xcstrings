    "System CPU is %@ busy; Loomscreen uses %@. If the Mac slows down, quit apps you are not using." : {
      "comment" : "Status capsule sentence beside the High Load headline when CPU set it. Both placeholders are percents of the whole machine: the system's CPU in use, then this app's share.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemweite CPU-Auslastung: %1$@; Loomscreen: %2$@. Wird der Mac langsam, beenden Sie ungenutzte Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System CPU is %@ busy; Loomscreen uses %@. If the Mac slows down, quit apps you are not using."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La CPU del sistema está al %@; Loomscreen usa el %@. Si el Mac va lento, cierra las apps que no estés usando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisation CPU totale : %1$@ ; Loomscreen : %2$@. Si le Mac ralentit, quittez les apps inutilisées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムの CPU 使用率は %@ で、そのうち Loomscreen が %@ を使用しています。この Mac の動作が遅くなったら、使っていないアプリを終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 CPU 사용률은 %1$@이며 Loomscreen은 %2$@을(를) 사용합니다. Mac이 느려지면 사용하지 않는 앱을 종료하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso total da CPU: %1$@; Loomscreen: %2$@. Se o Mac ficar lento, encerre apps que não usa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统 CPU 占用率为 %@，其中 Loomscreen 占 %@。如果本机运行变慢，请退出暂不使用的应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統 CPU 使用率為 %@，其中 Loomscreen 佔 %@。如果這台 Mac 變慢，請結束暫不使用的應用程式。"
          }
        }
      }
    },
