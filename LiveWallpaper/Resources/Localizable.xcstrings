          }
        }
      }
    },
    "In-use package mappings, conversions, exports and test scratch files. Owners remove these after use or at the next launch." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos temporales de paquetes, conversiones, exportaciones y pruebas. Sus componentes los eliminan tras usarlos o al iniciar de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パッケージのマッピング、変換、書き出し、テスト用の一時ファイル。各機能が使用後または次回起動時に削除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包映射、转码、导出与测试临时文件，由各模块在使用后或下次启动时移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套件映射、轉碼、匯出與測試暫存檔，由各模組在使用後或下次啟動時移除。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Gebrauch befindliche Paketzuordnungen, Konvertierungen, Exporte und Test-Scratch-Dateien. Eigentümer entfernen diese nach der Verwendung oder beim nächsten Start."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartes de mappage, conversions, exports et fichiers de test utilisés. Les propriétaires suppriment ces fichiers après utilisation ou lors du prochain lancement."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 중인 패키지 매핑, 변환, 내보내기 및 테스트 스크래치 파일. 소유자는 사용 후 또는 다음 출시 시 이러한 파일을 제거합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapas de pacotes em uso, conversões, exportações e arquivos de teste de scratch. Os proprietários removem esses arquivos após o uso ou no próximo lançamento."
          }
        }
      }
    },
