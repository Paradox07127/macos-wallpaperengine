        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não conseguiu desbloquear a chave de API salva. Permita o acesso quando solicitado ou insira a chave novamente nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 未能取出已保存的 API 密钥——弹出询问时请允许访问，或在设置里重新设置一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 無法讀取已儲存的 API 金鑰。出現詢問時請允許存取，或在設定中重新設定金鑰。"
          }
        }
      }
    },
    "macOS, networking and updater caches. Managed by their owners; excludes separately measured caches." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, Netzwerk- und Updater-Caches. Von ihren Eigentümern verwaltet; schließt separat gemessene Caches aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachés de macOS, red y actualizaciones. Las gestionan sus componentes; excluye las cachés medidas por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, caches de réseautage et de mise à jour. Géré par leurs propriétaires ; exclut les caches mesurés séparément."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS、ネットワーク、更新機能のキャッシュ。各機能が管理し、個別に計測するキャッシュは除きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, 네트워킹 및 업데이트 캐시. 소유자가 관리합니다; 별도로 측정된 캐시는 제외됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, caches de rede e atualizadores. Gerenciado por seus proprietários; exclui caches medidos separadamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS、网络与更新器缓存，由各模块管理，不含单独统计的缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS、網路與更新程式快取，由各模組管理，不含另行統計的快取。"
          }
        }
      }
    },
