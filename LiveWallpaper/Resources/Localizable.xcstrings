    "Hand a video to the system and macOS plays it itself, so it keeps running with Loomscreen closed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hand a video to the system and macOS plays it itself, so it keeps running with Loomscreen closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrega un vídeo al sistema y macOS lo reproduce por su cuenta, así sigue con Loomscreen cerrado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオをシステムに渡すと macOS 自身が再生するため、Loomscreen を終了しても再生が続きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
