    "'%@' will be removed from your library. Displays using this bookmark fall back to their saved wallpaper." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' will be removed from your library. Displays using this bookmark fall back to their saved wallpaper."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はライブラリから削除されます。このブックマークを使うディスプレイは保存済みの壁紙に戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从你的库中移除。使用该书签的显示器会回退到各自已保存的壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將從你的媒體庫移除。使用該書籤的顯示器會回到各自已儲存的桌布。"
          }
        }
      }
    },
    "“%@” and its copy in Loomscreen's shared folder are deleted. Your original video is untouched." : {
      "comment" : "Destructive confirm message for removing a published system wallpaper. Placeholder is the video title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” and its copy in Loomscreen's shared folder are deleted. Your original video is untouched."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」と Loomscreen の共有フォルダ内のコピーを削除します。元の動画はそのままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除《%@》以及它在 Loomscreen 共享目录中的副本。你的原始视频不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將刪除《%@》以及它在 Loomscreen 共用目錄中的副本。你的原始影片不受影響。"
          }
        }
      }
    },
    "“%@” is a preset, not a wallpaper. It was added to your presets — choose a wallpaper to continue." : {
      "comment" : "Onboarding error when the chosen folder turned out to be a Workshop preset. Placeholder is the preset name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is a preset, not a wallpaper. It was added to your presets — choose a wallpaper to continue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は壁紙ではなくプリセットです。プリセットに追加しました。続けるには壁紙を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是预设，不是壁纸。已加入你的预设——请选择一张壁纸以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」是預設，不是桌布。已加入你的預設——請選擇一張桌布以繼續。"
          }
        }
      }
    },
    "“%@” is on screen right now. It stops playing and its file is deleted immediately; the desktop keeps the last frame until you pick another wallpaper in System Settings." : {
      "comment" : "Destructive confirm message for removing the system wallpaper that is currently displayed. Placeholder is the video title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is on screen right now. It stops playing and its file is deleted immediately; the desktop keeps the last frame until you pick another wallpaper in System Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は現在画面に表示されています。再生を停止してファイルを直ちに削除しますが、システム設定で別の壁紙を選ぶまでデスクトップには最後のフレームが残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”正显示在屏幕上。它会停止播放，文件立即删除；在你于系统设置里选择另一张壁纸之前，桌面会保留最后一帧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」正顯示在螢幕上。它會停止播放，檔案立即刪除；在你於系統設定裡選擇另一張桌布之前，桌面會保留最後一幀。"
          }
        }
      }
    },
    "“%@” is on screen right now. Its file is deleted immediately, but macOS keeps showing it until you pick another wallpaper in System Settings." : {
      "comment" : "Destructive confirm message for removing the system wallpaper that is currently displayed. Placeholder is the video title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is on screen right now. Its file is deleted immediately, but macOS keeps showing it until you pick another wallpaper in System Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は現在表示中です。ファイルはすぐに削除されますが、システム設定で別の壁紙を選ぶまで macOS は表示を続けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "《%@》正在屏幕上显示。文件会立即删除，但在你到系统设置里换成别的壁纸之前，macOS 仍会继续显示它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "《%@》正在螢幕上顯示。檔案會立即刪除，但在你到系統設定改用其他桌布之前，macOS 仍會繼續顯示它。"
          }
        }
      }
    },
    "“%@” will be deleted from your Steam library on this Mac and removed from Loomscreen. This frees up disk space and can't be undone — you can download it again anytime. Your Steam subscription is unaffected." : {
      "comment" : "Workshop delete confirmation; %@ is the wallpaper title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be deleted from your Steam library on this Mac and removed from Loomscreen. This frees up disk space and can't be undone — you can download it again anytime. Your Steam subscription is unaffected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はこの Mac の Steam ライブラリから削除され、Loomscreen からも取り除かれます。ディスク容量が空きますが元に戻せません（いつでも再ダウンロードできます）。Steam のサブスクリプションには影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从本机的 Steam 库中删除，并从 Loomscreen 中移除。这会释放磁盘空间且无法撤销——你随时可以重新下载。你的 Steam 订阅不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將從本機的 Steam 收藏庫中刪除，並從 Loomscreen 中移除。這會釋放磁碟空間且無法復原——你隨時可以重新下載。你的 Steam 訂閱不受影響。"
          }
        }
      }
    },
    "“%@” will be removed from every display using it. Your own changes on top of it are kept." : {
      "comment" : "Confirmation dialog message before deleting a scene preset; %@ is the preset name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be removed from every display using it. Your own changes on top of it are kept."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はこれを使用しているすべてのディスプレイから削除されます。その上で加えた変更は保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从所有正在使用它的显示器上移除。你在它之上做的改动会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將從所有正在使用它的顯示器上移除。你在它之上做的改動會保留。"
          }
        }
      }
    },
    "“%@” will be removed from your library. Its original files (imported from your own folder) are left untouched." : {
      "comment" : "A confirmation dialog message for removing a wallpaper from the library. The argument is the name of the wallpaper.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はライブラリから削除されます。元のファイル（自分のフォルダから読み込んだもの）は変更されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从你的库中移除。其原始文件（从你自己的文件夹导入）保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」會從你的資料庫中移除。其原始檔案（從你自己的資料夾匯入）會保持不變。"
          }
        }
      }
    },
    "[Get a key](https://steamcommunity.com/dev/apikey)  ·  [Steam Web API TOU](https://steamcommunity.com/dev/apiterms)  ·  [About Limited Accounts](https://help.steampowered.com/en/faqs/view/71D3-35C2-AD96-AA3A)" : {
