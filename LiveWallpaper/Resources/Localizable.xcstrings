    "Removes everything saved for %@: the wallpaper, playlist, schedule, effect layer, and all other settings for this display. The wallpaper library, source files, and the widget, music, and clock overlays are kept." : {
      "comment" : "Destructive confirm message. Placeholder is the display name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes everything saved for %@: the wallpaper, playlist, schedule, effect layer, and all other settings for this display. The wallpaper library, source files, and the widget, music, and clock overlays are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todo lo guardado para %@: el fondo de pantalla, la playlist, la programación, la capa de efectos y el resto de ajustes de esta pantalla. Se conservan la biblioteca de fondos, los archivos de origen y las superposiciones de widgets, música y reloj."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に保存されている内容をすべて削除します：壁紙、プレイリスト、スケジュール、エフェクトレイヤー、およびこのディスプレイのその他すべての設定。壁紙ライブラリ、ソースファイル、ウィジェット・ミュージック・時計のオーバーレイは保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将移除为 %@ 保存的全部内容：壁纸、播放列表、计划、效果层，以及这台显示器的其他所有设置。壁纸库、源文件，以及小组件、音乐和时钟叠加层会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將移除為 %@ 儲存的全部內容：桌布、播放列表、排程、效果層，以及這台顯示器的其他所有設定。桌布庫、來源檔案，以及小工具、音樂和時鐘疊加層會保留。"
          }
        }
      }
    },
    "Removes the stored key from this Mac. Your key remains active under your Steam account at steamcommunity.com/dev/apikey until you revoke it there." : {
      "comment" : "Tooltip on the Forget button in WorkshopSettingsView.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la clave almacenada de este Mac. La clave sigue activa en tu cuenta de Steam en steamcommunity.com/dev/apikey hasta que la revoques allí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたキーをこの Mac から削除します。steamcommunity.com/dev/apikey で取り消すまで、キーは Steam アカウント上で有効なままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从本机移除已存储的密钥。在你前往 steamcommunity.com/dev/apikey 撤销之前，该密钥仍会在你的 Steam 账户下保持有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從這台 Mac 移除已儲存的金鑰。在你前往 steamcommunity.com/dev/apikey 撤銷之前，該金鑰仍會在你的 Steam 帳戶下保持有效。"
          }
        }
      }
    },
    "Removes this account's Loomscreen download session. Reconnect before downloading again. Steam app sign-in is unaffected." : {
      "comment" : "Confirmation for removing the selected Steam account download session used by Loomscreen. The Steam app session remains signed in.",
