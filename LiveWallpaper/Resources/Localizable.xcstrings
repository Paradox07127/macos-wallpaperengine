    "The wallpaper on screen isn't the scheduled one. The schedule resumes when the next time slot starts." : {
      "comment" : "Explains the paused daily schedule notice on the display detail page.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wallpaper on screen isn't the scheduled one. The schedule resumes when the next time slot starts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fondo de pantalla actual no es el programado. La programación se reanudará cuando empiece la siguiente franja."
          }
        },
        "ja" : {
          "stringUnit" : {
