    "Resets playback, effects, web options, and scheduling. Keeps the wallpaper, playlist, and bookmarks." : {
      "comment" : "Reset Current Display tooltip. Resets playback/effects/web/scheduling, preserves wallpaper content, playlist entries, and bookmarks. Does not reset overlay layout.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resets playback, effects, web options, and scheduling. Keeps the wallpaper, playlist, and bookmarks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablece la reproducción, los efectos, las opciones web y la programación. Conserva el fondo, la playlist y los marcadores."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生、エフェクト、Web オプション、スケジュールをリセットします。壁紙、プレイリスト、ブックマークは保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置播放、效果、网页选项和计划设置；保留壁纸、播放列表和书签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置播放、效果、網頁選項和排程設定；保留桌布、播放列表和書籤。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt Wiedergabe, Effekte, Weboptionen und Zeitplanung zurück. Behält den Hintergrundbild, die Wiedergabeliste und die Lesezeichen bei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinitialise le lecture, les effets, les options web et le calendrier. Conserve l'image d'arrière-plan, la playlist et les favoris."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 재생, 효과, 웹 옵션 및 일정을 재설정합니다. 배경화면, 플레이리스트 및 북마크를 유지합니다."
