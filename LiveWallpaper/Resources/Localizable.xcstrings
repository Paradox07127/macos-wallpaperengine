    "They use %@ and only play when no display has a selection." : {
      "comment" : "System Wallpaper banner detail. Placeholder is a formatted size on disk.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie verwenden %@ und spielen nur, wenn kein Display eine Auswahl hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They use %@ and only play when no display has a selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocupan %@ y solo se reproducen cuando ninguna pantalla tiene una selección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils utilisent %@ et ne jouent que lorsqu'aucun affichage n'a de sélection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を使用しており、どのディスプレイにも選択がないときだけ再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그들은 %@을 사용하며 디스플레이에 선택 사항이 없을 때만 플레이합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
