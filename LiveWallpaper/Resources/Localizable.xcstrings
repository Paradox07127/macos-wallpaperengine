    "Restore global preferences, per-display setup, bookmarks, and schemes to their defaults." : {
      "comment" : "Advanced settings row subtitle for the reset-all-settings action.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt globale Einstellungen, Monitor-Einrichtungen, Lesezeichen und Profile auf die Vorgaben zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore global preferences, per-display setup, bookmarks, and schemes to their defaults."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura las preferencias globales, la configuración de cada pantalla, los marcadores y los esquemas a sus valores predeterminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
