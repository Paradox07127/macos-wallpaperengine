    },
    "The item will be removed from the playlist. Other displays using this video keep their copy." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The item will be removed from the playlist. Other displays using this video keep their copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El elemento se eliminará de la lista de reproducción. Las demás pantallas que usen este vídeo conservan su copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目はプレイリストから削除されます。この動画を使う他のディスプレイのコピーは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该项将从播放列表移除。其他使用此视频的显示器会保留各自副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該項目將從播放清單移除。其他使用此影片的顯示器會保留各自副本。"
          }
        }
      }
    },
    "The key belongs to your own Steam account, not Loomscreen. Calls go directly to Valve over HTTPS, and the key is stored only on this Mac (no iCloud sync). Browsing works without it; adding one brings ratings, authors and faster search." : {
      "comment" : "Onboarding Steam Web API key step explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave pertenece a tu propia cuenta de Steam, no a Loomscreen. Las llamadas van directas a Valve por HTTPS, y la clave se guarda solo en este Mac (sin sincronización con iCloud). Explorar funciona sin ella; añadir una aporta valoraciones, autores y una búsqueda más rápida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーは Loomscreen ではなくご自身の Steam アカウントに属します。通信は HTTPS で Valve へ直接行われ、キーはこの Mac にのみ保存されます（iCloud 同期なし）。キーがなくてもブラウズでき、設定すると評価・作者・より速い検索が加わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥属于你自己的 Steam 账户，不属于 Loomscreen。请求通过 HTTPS 直接发给 Valve，密钥只存在这台 Mac 上（不同步到 iCloud）。没有它也能浏览；设置后会增加评分、作者，搜索也更快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金鑰屬於你自己的 Steam 帳戶，不屬於 Loomscreen。請求透過 HTTPS 直接發給 Valve，金鑰只存在這台 Mac 上（不同步到 iCloud）。沒有它也能瀏覽；設定後會增加評分、作者，搜尋也更快。"
          }
        }
      }
    },
    "The key belongs to your own Steam account, not Loomscreen. Calls go directly to Valve over HTTPS, and the key is stored only on this Mac (no iCloud sync). Get one free at steamcommunity.com/dev/apikey." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave pertenece a tu propia cuenta de Steam, no a Loomscreen. Las llamadas van directas a Valve por HTTPS, y la clave se guarda solo en este Mac (sin sincronización con iCloud). Consigue una gratis en steamcommunity.com/dev/apikey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このキーは Loomscreen ではなく、自分の Steam アカウントに属します。呼び出しは HTTPS 経由で Valve に直接送信され、キーはこの Mac にのみ保存されます（iCloud 同期なし）。steamcommunity.com/dev/apikey で無料取得できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此密钥属于你自己的 Steam 账户，而不是 Loomscreen。调用会通过 HTTPS 直接发送到 Valve，密钥只存储在此 Mac 上（不通过 iCloud 同步）。可在 steamcommunity.com/dev/apikey 免费获取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此金鑰屬於你自己的 Steam 帳戶，而不是 Loomscreen。呼叫會透過 HTTPS 直接傳送到 Valve，金鑰只儲存在此 Mac 上（不透過 iCloud 同步）。可在 steamcommunity.com/dev/apikey 免費取得。"
          }
        }
      }
    },
    "The key is stored in this Mac's keychain and never synced." : {
      "comment" : "Steam Web API key field hint before anything is typed.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave se guarda en el llavero de este Mac y nunca se sincroniza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーはこの Mac のキーチェーンに保存され、同期されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥保存在这台 Mac 的钥匙串里，不会同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金鑰儲存在這台 Mac 的鑰匙圈裡，不會同步。"
          }
        }
      }
    },
