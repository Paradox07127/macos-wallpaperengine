    "Set up shared assets before using scene wallpapers to avoid missing textures and effects. Video wallpapers do not need them. Linked files are read-only." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up shared assets before using scene wallpapers to avoid missing textures and effects. Video wallpapers do not need them. Linked files are read-only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura los recursos compartidos antes de usar escenas para evitar que falten texturas y efectos. Los fondos de vídeo no los necesitan. Los archivos enlazados son de solo lectura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン壁紙を使う前に共有アセットを設定し、テクスチャやエフェクトの欠落を防いでください。動画壁紙には不要です。リンクしたファイルは読み取り専用です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用场景壁纸前请配置共享资源，以免缺少贴图和特效。视频壁纸无需这些资源。已链接文件为只读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用場景桌布前請設定共用資源，以免缺少材質和特效。影片桌布不需要這些資源。已連結檔案為唯讀。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richten Sie gemeinsame Assets ein, bevor Sie Szenenhintergründe verwenden, um das Fehlen von Texturen und Effekten zu vermeiden. Videohintergründe benötigen diese nicht. Verknüpfte Dateien sind nur lesbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez les actifs partagés avant d'utiliser des fonds d'écran de scène pour éviter de manquer de textures et d'effets. Les fonds d'écran vidéo n'en ont pas besoin. Les fichiers liés sont lisibles uniquement."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스처와 효과를 놓치지 않도록 장면 배경화면을 사용하기 전에 공유 자산을 설정하세요. 비디오 배경화면에는 이러한 자산이 필요하지 않습니다. 연결된 파일은 읽기 전용입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
