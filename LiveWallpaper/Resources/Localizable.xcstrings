          }
        }
      }
    },
    "Let the overlay receive clicks instead of passing them through to the desktop" : {
      "comment" : "Description for the Monitor overlay mouse-interaction toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックをデスクトップに通さず、オーバーレイで受け取ります"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让浮层接收点击，而不是把它们透传给桌面"
