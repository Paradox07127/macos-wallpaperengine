        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El conector de Steam de Loomscreen estaba ocupado, así que no se comprobó la firma. Inténtalo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen の Steam コネクタがビジー状態だったため、署名を確認できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的 Steam 连接器正忙，因此未检查签名。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的 Steam 連接器忙碌中，因此未檢查簽章。請重試。"
          }
        }
      }
    },
    "Loomscreen's Steam download session isn't connected. Connect your account in Settings → Workshop, then try again." : {
      "comment" : "Steam download blocked because Loomscreen's own Steam session is not signed in; shared by engine-assets and Workshop item downloads.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión de descarga de Steam de Loomscreen no está conectada. Conecta tu cuenta en Ajustes › Workshop y vuelve a intentarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen の Steam ダウンロードセッションが接続されていません。「設定 › ワークショップ」でアカウントを接続してから、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的 Steam 下载会话尚未连接。请在“设置 › 创意工坊”中连接你的账户，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的 Steam 下載工作階段尚未連線。請在「設定 › 工作坊」中連結你的帳戶，然後再試一次。"
          }
        }
      }
    },
    "Loomscreen's background Steam helper didn't answer. Downloads won't run until it does — quitting and reopening Loomscreen usually starts it." : {
      "comment" : "Connector diagnostic when the XPC service is unreachable.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente de Steam en segundo plano de Loomscreen no respondió. Las descargas no se ejecutarán hasta que lo haga — salir y volver a abrir Loomscreen suele iniciarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen のバックグラウンド Steam ヘルパーが応答しませんでした。応答するまでダウンロードは実行できません。Loomscreen を終了して開き直すと起動することがほとんどです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的后台 Steam 助手没有响应。在它响应之前无法下载——退出并重新打开 Loomscreen 通常就能启动它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen 的背景 Steam 輔助程式沒有回應。在它回應之前無法下載——結束並重新開啟 Loomscreen 通常就能啟動它。"
          }
        }
      }
    },
    "Loomscreen's download session is unavailable. Reconnect this account; your Steam app sign-in is separate." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loomscreen's download session is unavailable. Reconnect this account; your Steam app sign-in is separate."
