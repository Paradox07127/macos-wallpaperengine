    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play, pause, skip and seek buttons on the Now Playing wallpaper layer use this to control the music player you are listening to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los botones de reproducción, pausa, salto y búsqueda de la capa En reproducción usan este permiso para controlar el reproductor de música que estás escuchando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中レイヤーの再生・一時停止・スキップ・シーク操作が、この許可を使って再生中の音楽アプリを操作します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁纸上“正在播放”图层的播放、暂停、切歌和进度控制，通过此权限操作你正在听的音乐播放器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌布上「正在播放」圖層的播放、暫停、切歌與進度控制，透過此權限操作你正在聽的音樂播放程式。"
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access to Desktop is needed to play wallpaper files stored there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso al Escritorio para reproducir los fondos de pantalla almacenados ahí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップに保存されている壁紙ファイルを再生するために、デスクトップへのアクセスが必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问桌面以播放存储在其中的壁纸文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要存取桌面，才能播放儲存在其中的桌布檔案。"
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access to Documents is needed to play wallpaper files stored there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a Documentos para reproducir los fondos de pantalla almacenados ahí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書類に保存されている壁紙ファイルを再生するために、書類へのアクセスが必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问文稿以播放存储在其中的壁纸文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要存取文件，才能播放儲存在其中的桌布檔案。"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access to Downloads is needed to play wallpaper files stored there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a Descargas para reproducir los fondos de pantalla almacenados ahí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードに保存されている壁紙ファイルを再生するために、ダウンロードへのアクセスが必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问下载以播放存储在其中的壁纸文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要存取下載項目，才能播放儲存在其中的桌布檔案。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location is used to fetch local weather for weather-reactive effects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación se usa para consultar el tiempo local y aplicar efectos que reaccionan a él."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報は、天気に反応するエフェクト用にローカルの天気を取得するために使われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定位用于获取本地天气，以驱动随天气变化的效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置資訊用來取得本地天氣，驅動會隨天氣變化的效果。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
