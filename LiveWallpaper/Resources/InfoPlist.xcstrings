    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play, pause, skip and seek buttons on the Now Playing wallpaper layer use this to control the music player you are listening to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los botones de reproducción, pausa, salto y búsqueda de la capa En reproducción usan este permiso para controlar el reproductor de música que estás escuchando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中レイヤーの再生・一時停止・スキップ・シーク操作が、この許可を使って再生中の音楽アプリを操作します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁纸上“正在播放”图层的播放、暂停、切歌和进度控制，通过此权限操作你正在听的音乐播放器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌布上「正在播放」圖層的播放、暫停、切歌與進度控制，透過此權限操作你正在聽的音樂播放程式。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tasten für Wiedergabe, Pause, Titelsprung und Positionssuche in der Hintergrundebene „Aktuelle Wiedergabe“ steuern damit den Musikplayer, den Sie gerade verwendest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boutons de lecture, de pause, de changement de piste et de recherche de position du calque musical utilisent cette autorisation pour contrôler votre lecteur de musique."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 재생 중인 음악 플레이어를 제어하기 위해 음악 배경화면 레이어의 재생, 일시 정지, 트랙 이동 및 탐색 버튼에서 이 권한을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os botões de reproduzir, pausar, pular faixas e buscar posições na camada de música usam esta permissão para controlar o reprodutor que você está ouvindo."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio response analyzes the audio currently playing on your Mac, on-device, to make wallpapers move with the music. No audio is recorded, saved, or sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La respuesta de audio analiza en tu Mac, sin salir del dispositivo, el audio que se está reproduciendo para que los fondos de pantalla se muevan con la música. No se graba, guarda ni envía ningún audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオ反応は、Mac で再生中のオーディオをデバイス上で解析し、壁紙を音楽に合わせて動かします。オーディオが録音・保存・送信されることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频响应在本机分析 Mac 上正在播放的音频，使壁纸随音乐律动。音频不会被录制、保存或发送至任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊反應在本機分析 Mac 上正在播放的音訊，讓桌布隨音樂律動。音訊不會被錄製、儲存或傳送至任何地方。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Audioreaktion analysiert den auf Ihrem Mac wiedergegebenen Ton direkt auf dem Gerät, damit sich Hintergründe zur Musik bewegen. Es wird kein Ton aufgenommen, gespeichert oder übertragen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réaction audio analyse sur votre Mac le son en cours de lecture pour animer les fonds d’écran au rythme de la musique. Aucun son n’est enregistré, conservé ou envoyé."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 반응 기능은 배경화면이 음악에 맞춰 움직이도록 Mac에서 재생 중인 오디오를 기기 내에서 분석합니다. 오디오를 녹음하거나 저장하거나 외부로 전송하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A resposta ao áudio analisa, no próprio Mac, o áudio em reprodução para mover os papéis de parede com a música. Nenhum áudio é gravado, salvo ou enviado."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location is used to fetch local weather for weather-reactive effects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación se usa para consultar el tiempo local y aplicar efectos que reaccionan a él."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報は、天気に反応するエフェクト用にローカルの天気を取得するために使われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定位用于获取本地天气，以驱动随天气变化的效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置資訊用來取得本地天氣，驅動會隨天氣變化的效果。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Standort wird verwendet, um das lokale Wetter für wetterabhängige Effekte abzurufen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position sert à obtenir la météo locale pour les effets qui réagissent au temps."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날씨에 반응하는 효과에 사용할 현지 날씨를 가져오기 위해 위치를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua localização é usada para obter o clima local para efeitos que reagem ao tempo."
          }
        }
      }
    }
  },
  "version" : "1.0"
}