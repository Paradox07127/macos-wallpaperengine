    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location is used to fetch local weather for weather-reactive effects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación se usa para consultar el tiempo local y aplicar efectos que reaccionan a él."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報は、天気に反応するエフェクト用にローカルの天気を取得するために使われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定位用于获取本地天气，以驱动随天气变化的效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置資訊用來取得本地天氣，驅動會隨天氣變化的效果。"
          }
        }
      }
