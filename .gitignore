# Xcode user state and build products
xcuserdata/
*.xcuserstate
*.xcuserdatad/
build/
DerivedData/
*.hmap
*.dSYM
*.dSYM.zip

# LLVM profile artifacts from -profile-generate / coverage builds
*.profraw
*.profdata

# The workspace is per-user except for the SwiftPM pin, which must be shared so
# every clone resolves the same dependency versions.
project.xcworkspace/
!LiveWallpaper.xcodeproj/project.xcworkspace/
!LiveWallpaper.xcodeproj/project.xcworkspace/xcshareddata/
LiveWallpaper.xcodeproj/project.xcworkspace/xcshareddata/*
!LiveWallpaper.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!LiveWallpaper.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Swift Package Manager
.swiftpm
.build/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Python bytecode
__pycache__/
*.pyc

# Editor temporary files and diagnostic output
*.log
*.swp
*.trace/

# Test fixtures are opt-in: only these three survive. workshop/ is ~1.5 MB of
# trimmed Steam browse pages, provenance in its own README.
!LiveWallpaperTests/Fixtures/
LiveWallpaperTests/Fixtures/*
!LiveWallpaperTests/Fixtures/oracle-golden/
!LiveWallpaperTests/Fixtures/GeneralSettingsOwnershipFixture.swift
!LiveWallpaperTests/Fixtures/workshop/
