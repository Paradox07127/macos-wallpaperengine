# Xcode user state and build products
xcuserdata/
*.xcuserstate
*.xcuserdatad/
build/
DerivedData/
*.hmap
*.dSYM
*.dSYM.zip

# LLVM profile artifacts from -profile-generate / coverage builds
*.profraw
*.profdata

# The workspace is per-user except for the SwiftPM pin, which must be shared so
# every clone resolves the same dependency versions.
project.xcworkspace/
!LiveWallpaper.xcodeproj/project.xcworkspace/
!LiveWallpaper.xcodeproj/project.xcworkspace/xcshareddata/
LiveWallpaper.xcodeproj/project.xcworkspace/xcshareddata/*
!LiveWallpaper.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!LiveWallpaper.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Swift Package Manager
.swiftpm
.build/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Python bytecode
__pycache__/
*.pyc

# Maintainer-local: agent config, notes, probes and one-off tooling. None of it
# ships, and scripts/ is the only place a gate or release script may live.
.claude/
.codegraph/
.notes/
.periphery.yml
.playwright-cli/
.vm-bridge/
AGENTS.md
CLAUDE.md
archived/
buildServer.json
cache/
skills/
tools/
trace/
*.log
*.swp
*.trace/
.audit/

# Instruments trace bundles run to gigabytes each; keep them local. The sibling
# README.md stays tracked because it is the measurement record, so ignore the
# bundles individually rather than the whole artifacts/ directory.
artifacts/**/*.trace/

# Test fixtures are opt-in: only these three survive. workshop/ is ~1.5 MB of
# trimmed Steam browse pages, provenance in its own README.
!LiveWallpaperTests/Fixtures/
LiveWallpaperTests/Fixtures/*
!LiveWallpaperTests/Fixtures/oracle-golden/
!LiveWallpaperTests/Fixtures/GeneralSettingsOwnershipFixture.swift
!LiveWallpaperTests/Fixtures/workshop/

# scripts/ holds only the portable gate and release toolchain: every file there
# runs on a clean clone via `make verify`, ci.yml or a release. Maintainer-local
# tooling lives in tools/, ignored above.
