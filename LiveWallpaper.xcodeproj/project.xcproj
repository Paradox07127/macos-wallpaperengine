{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "de",
      "es",
      "fr",
      "ja",
      "ko",
      "pt-BR",
      "zh-Hans",
      "zh-Hant",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Packages/LiveWallpaperCore",
    }, {
      "kind": "local",
      "path": "Packages/LiveWallpaperProWPE",
    }, {
      "kind": "remote",
      "repository": "https://github.com/sparkle-project/Sparkle",
      "version": {
        "up-to-next-major-version": "2.9.6",
      },
    },
  ],
